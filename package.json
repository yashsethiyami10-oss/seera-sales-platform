{
  "name": "seera-sales-distribution-os",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:passenger": "node server.js",
    "lint": "next lint",
    "test": "vitest run",
    "postinstall": "node scripts/seera/pre-phase-1-postinstall.cjs",
    "db:migrate": "node scripts/seera/blocked-database-command.cjs prisma-migrate-dev",
    "db:push": "node scripts/seera/blocked-database-command.cjs prisma-db-push",
    "db:deploy": "node scripts/seera/blocked-database-command.cjs prisma-migrate-deploy",
    "db:studio": "node scripts/seera/blocked-database-command.cjs prisma-studio",
    "db:seed": "node scripts/seera/blocked-database-command.cjs prisma-seed",
    "verify:seera:block1:static": "node scripts/seera/verify-block1-static.mjs",
    "db:test:migrate": "tsx scripts/seera/guarded-prisma.ts -- migrate dev",
    "db:test:reset": "tsx scripts/seera/reset-test-database.ts",
    "db:test:seed-foundation": "tsx scripts/seera/run-foundation-seed.ts",
    "test:seera:block3": "tsx scripts/seera/guarded-vitest.ts",
    "test:seera:phase2-5": "vitest run --config vitest.phase2-5.config.ts",
    "test:seera:phase2-5:integration": "tsx scripts/seera/guarded-phase2-5-vitest.ts",
    "test:seera:localization": "vitest run --config vitest.localization.config.ts",
    "test:seera:phase6-9": "vitest run --config vitest.phase6-9.config.ts",
    "verify:phase2:build": "tsc lib/sales-channel/routing.ts lib/sales-channel/identity-matching.ts lib/sales-channel/assignment.ts lib/sales-channel/validation.ts --outDir .tmp-phase2-services --rootDir lib/sales-channel --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck",
    "verify:phase2": "npm run verify:phase2:build && node scripts/verify-sales-phase2.cjs",
    "verify:knowledge-publisher": "tsx scripts/verify-knowledge-publisher.ts",
    "verify:knowledge-access": "tsx scripts/verify-knowledge-access.ts",
    "verify:commerce-intelligence": "tsx scripts/verify-commerce-intelligence.ts",
    "verify:customer-intelligence": "tsx scripts/verify-customer-intelligence.ts",
    "verify:conversation-runtime": "tsx scripts/verify-conversation-runtime.ts",
    "verify:observability": "tsx scripts/verify-observability.ts",
    "verify:security": "tsx scripts/verify-security.ts",
    "verify:live-activation": "tsx scripts/verify-live-activation.ts",
    "verify:pilot-product-search": "tsx scripts/verify-pilot-product-search.ts",
    "verify:gateway-config": "tsx scripts/verify-gateway-config.ts",
    "verify:knowledge-governance-manifest": "tsx scripts/verify-knowledge-governance-manifest.ts",
    "generate:knowledge-classification-manifest": "tsx scripts/generate-knowledge-classification-manifest.ts",
    "verify:search-intelligence": "tsx scripts/verify-search-intelligence.ts",
    "verify:commerce-wave-rollout": "tsx scripts/verify-commerce-wave-rollout.ts",
    "verify:customer-wave-rollout": "tsx scripts/verify-customer-wave-rollout.ts",
    "verify:muv-ai-markdown": "tsx --tsconfig tsconfig.scripts.json scripts/verify-muv-ai-markdown.ts",
    "verify:security-hardening": "tsx scripts/verify-security-hardening.ts",
    "verify:observability-operations": "tsx scripts/verify-observability-operations.ts",
    "verify:search-performance": "tsx scripts/verify-search-performance.ts",
    "verify:failure-abuse": "tsx scripts/verify-failure-abuse.ts",
    "verify:sales-os-block1": "tsx scripts/verify-sales-os-block1.ts",
    "verify:sales-os-block2": "tsx scripts/verify-sales-os-block2.ts",
    "verify:sales-os-block3": "tsx scripts/verify-sales-os-block3.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "15.5.20",
    "next-auth": "5.0.0-beta.31",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.20",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "node scripts/seera/blocked-database-command.cjs prisma-seed"
  },
  "overrides": {
    "postcss": "^8.5.20"
  }
}
