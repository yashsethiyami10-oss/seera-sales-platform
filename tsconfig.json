{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/database/**/*.ts",
    "lib/foundation/**/*.ts",
    "lib/sales-distribution/**/*.ts",
    "middleware.ts",
    "instrumentation.ts",
    "vitest.static.config.ts",
    "__tests__/seera-foundation/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "reference/**",
    "actions/**",
    "components/**",
    "scripts/**",
    "__tests__/muv-ai/**"
  ]
}
