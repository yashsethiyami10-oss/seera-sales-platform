enum InventoryPartyType {
  DISTRIBUTOR
  SUPER_STOCKIST
  // Added for Manufacturing OS: Sales V1 deliberately never gave Company a
  // governed stock position (Company was the network's infinite-supply
  // root — see receiveIncomingOrder/dispatchCompanyOrder in workflow-service.ts,
  // neither of which ever debits a Company-side balance). Manufacturing's
  // finished-goods output needs a real, queryable Company stock position, so
  // this value is added — purely additive, nothing existing reads/writes it.
  // Sales V1's own dispatch/receipt logic is deliberately NOT changed by this
  // addition: it remains exactly as frozen/audited. Wiring an actual stock
  // check into Company Order dispatch would be a real business-policy change
  // and needs its own explicit Founder approval, not a side effect of adding
  // Manufacturing visibility.
  COMPANY
}

