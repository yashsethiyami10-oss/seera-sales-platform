// Founder/Admin UAT correction (P0): a Distributor's Super Stockist assignment was set once at
// creation and never had an application-code path to change again. This is the audit trail for
// that change — deliberately a dedicated table (mirrors SeeraPartnerLifecycleEvent's own pattern)
// rather than overloading PartnerLifecycleAction, since a reassignment is not a lifecycle-state
// transition and carries different fields (from/to Super Stockist, not from/to PartnerLifecycle).
// Historical orders/documents already snapshot their commercial party at creation time and are
// never touched by this — only SeeraPartner.assignedSuperStockistId changes, governing future
// routing only.
model SeeraDistributorReassignmentEvent {
  id                  String   @id @default(cuid())
  distributorId       String
  fromSuperStockistId String?
  toSuperStockistId   String
  effectiveFrom       DateTime
  reason              String
  actorId             String
  idempotencyKey      String   @unique
  occurredAt          DateTime @default(now())

  @@index([distributorId, occurredAt])
  @@map("seera_distributor_reassignment_events")
}

// ============================================================================
// SEERA COMPANY FINANCE OS — accounting core (Chart of Accounts / Journal /
// General Ledger), treasury (Bank/Cash), purchases/payables, expenses,
// budgets, loans, fixed assets. Deliberately does NOT duplicate the existing
// party-to-party settlement ledger above (SeeraFinancialEntry / SeeraPaymentRecord /
// SeeraPaymentAllocation / SeeraFinancialReconciliation) — that remains the
// authoritative Company<->S.S./Distributor/Retailer subledger and now POSTS
// into this Chart-of-Accounts general ledger via SeeraJournalEntry rather than
// being replaced. SeeraAccountingPeriod (above) and SeeraApprovalItem (generic
// approval queue, above) are reused as-is — not redefined here.
// ============================================================================

enum FinanceAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum TreasuryAccountKind {
  BANK
  CASH
}

enum JournalSourceType {
  MANUAL
  OPENING_BALANCE
  SALES_INVOICE
  SALES_RECEIPT
  SALES_ADVANCE
  SALES_CREDIT_NOTE
  SALES_DEBIT_NOTE
  VENDOR_BILL
  VENDOR_PAYMENT
  EXPENSE
  PAYROLL
  TRANSFER
  RECONCILIATION_ADJUSTMENT
  REVERSAL
  LOAN_RECEIVED
  LOAN_REPAYMENT
  CAPITAL_INTRODUCED
  DRAWINGS
  ASSET_PURCHASE
  MANUFACTURING_TRANSFORMATION
  MANUFACTURING_WASTAGE
  COGS_RECOGNITION
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum VendorBillStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  REVERSED
}

enum FinanceApprovalCategory {
  EXPENSE
  VENDOR_BILL
  PAYMENT
  MANUAL_JOURNAL
  REVERSAL
  LARGE_CASH_TXN
  PERIOD_REOPEN
}

enum LoanTransactionType {
  DISBURSEMENT
  PRINCIPAL_REPAYMENT
  INTEREST_PAYMENT
}

