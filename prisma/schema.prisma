model User {
  id                     String                     @id @default(cuid())
  email                  String                     @unique
  normalizedEmail        String                     @unique
  phone                  String?                    @unique
  name                   String?
  passwordHash           String?
  status                 UserStatus                 @default(ACTIVE)
  preferredLanguage      UiLanguage                 @default(EN)
  authorizationVersion   Int                        @default(1)
  emailVerified          DateTime?
  phoneVerified          DateTime?
  lastLoginAt            DateTime?
  suspendedAt            DateTime?
  suspensionReason       String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  accounts               Account[]
  sessions               Session[]
  roleAssignments        UserRoleAssignment[]       @relation("RoleAssignmentSubject")
  roleAssignmentsMade    UserRoleAssignment[]       @relation("RoleAssignmentGrantor")
  roleAssignmentsRevoked UserRoleAssignment[]       @relation("RoleAssignmentRevoker")
  auditEvents            AuditLog[]                 @relation("AuditActor")
  uploadedFiles          StoredFile[]               @relation("FileUploader")
  notifications          Notification[]             @relation("NotificationRecipient")
  automationRulesCreated SeeraAutomationRule[]      @relation("AutomationRuleCreator")
  automationExecutions   SeeraAutomationExecution[] @relation("AutomationRecipient")
  insights               SeeraInsight[]             @relation("InsightRecipient")
  reportExports          SeeraReportExport[]        @relation("ReportExportActor")
  offlineOperations      SeeraOfflineOperation[]    @relation("OfflineOperationUser")

  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id                   String    @id @default(cuid())
  sessionToken         String    @unique
  userId               String
  expires              DateTime
  revokedAt            DateTime?
  revocationReason     String?
  authorizationVersion Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expires])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([expires])
  @@map("auth_verification_tokens")
}

model Role {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  description String?
  status      RoleStatus           @default(ACTIVE)
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  grantedById  String?
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id               String               @id @default(cuid())
  userId           String
  roleId           String
  status           RoleAssignmentStatus @default(ACTIVE)
  effectiveFrom    DateTime             @default(now())
  effectiveTo      DateTime?
  assignedById     String?
  assignedAt       DateTime             @default(now())
  assignmentReason String?
  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?
  user             User                 @relation("RoleAssignmentSubject", fields: [userId], references: [id], onDelete: Restrict)
  role             Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?                @relation("RoleAssignmentGrantor", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy        User?                @relation("RoleAssignmentRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, status, effectiveFrom, effectiveTo])
  @@index([roleId, status])
  @@map("user_role_assignments")
}

model AuditLog {
  id          String       @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  outcome     AuditOutcome @default(SUCCESS)
  reason      String?
  beforeState Json?
  afterState  Json?
  details     Json?
  requestId   String?
  sessionId   String?
  ipHash      String?
  userAgent   String?
  occurredAt  DateTime     @default(now())
  actor       User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

model AppSetting {
  id            String           @id @default(cuid())
  key           String           @unique
  category      String
  valueType     SettingValueType
  value         Json
  isSensitive   Boolean          @default(false)
  version       Int              @default(1)
  active        Boolean          @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  updatedById   String?
  changeReason  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([category, active])
  @@map("app_settings")
}

model FeatureFlag {
  id            String    @id @default(cuid())
  key           String    @unique
  description   String?
  enabled       Boolean   @default(false)
  rules         Json?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  updatedById   String?
  changeReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, effectiveFrom, effectiveTo])
  @@map("feature_flags")
}

model IdempotencyKey {
  id             String            @id @default(cuid())
  scope          String
  key            String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  lockedUntil    DateTime?
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scope, key])
  @@index([status, lockedUntil])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  publishedAt   DateTime?
  lastErrorCode String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // WhatsApp message audit trail (Founder WhatsApp integration audit). These stay null for
  // every non-WhatsApp/legacy outbox row (channel-agnostic model, reused rather than
  // duplicated per the Founder's explicit "do not create duplicate architecture" directive).
  // `channel` distinguishes WhatsApp rows from any future channel sharing this same table.
  channel           String?
  // Governed template key (lib/messaging/whatsapp-templates.ts), e.g. "RETAILER_ORDER_PLACED" —
  // NOT the raw Meta template name, so the mapping can be re-pointed without rewriting history.
  templateKey       String?
  // Meta's `messages[0].id` (wamid...) from a successful send — the join key inbound status
  // webhooks use to find this row again. Unique because Meta assigns one id per send attempt.
  providerMessageId String?   @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model StoredFile {
  id              String              @id @default(cuid())
  provider        String
  storageKey      String              @unique
  originalName    String
  mimeType        String
  extension       String?
  sizeBytes       BigInt
  sha256          String
  classification  FileClassification  @default(GENERAL)
  scanStatus      FileScanStatus      @default(PENDING)
  lifecycleStatus FileLifecycleStatus @default(ACTIVE)
  entityType      String?
  entityId        String?
  uploadedById    String?
  retentionUntil  DateTime?
  revokedAt       DateTime?
  contentBytes    Bytes?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  uploadedBy      User?               @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([uploadedById, createdAt])
  @@index([classification, lifecycleStatus])
  @@map("stored_files")
}

model Notification {
  id          String                 @id @default(cuid())
  recipientId String
  type        String
  title       String
  body        String
  priority    NotificationPriority   @default(NORMAL)
  status      NotificationStatus     @default(UNREAD)
  entityType  String?
  entityId    String?
  payload     Json?
  readAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime               @default(now())
  expiresAt   DateTime?
  recipient   User                   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  deliveries  NotificationDelivery[]

  @@index([recipientId, status, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationDelivery {
  id                 String                     @id @default(cuid())
  notificationId     String
  channel            NotificationChannel
  status             NotificationDeliveryStatus @default(PENDING)
  attempt            Int                        @default(1)
  provider           String?
  providerMessageId  String?
  recipientReference String?
  attemptedAt        DateTime?
  deliveredAt        DateTime?
  lastErrorCode      String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  notification       Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, attempt])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

// Idempotency ledger for inbound WhatsApp webhook deliveries (Meta redelivers on any
// slow/ambiguous response). `dedupeKey` is `${messageId}:${statusOrEventKind}` — the same
// status re-delivered twice produces the same key and the second insert is rejected by the
// unique constraint, which the webhook route treats as "already processed, no-op" rather
// than reapplying a status transition or re-writing DELIVERED/READ timestamps.
model WhatsAppWebhookReceipt {
  id         String   @id @default(cuid())
  dedupeKey  String   @unique
  receivedAt DateTime @default(now())

  @@map("whatsapp_webhook_receipts")
}

model SeeraAutomationRule {
  id                  String                     @id @default(cuid())
  code                String                     @unique
  category            String
  eventCode           String
  condition           Json
  recipientScope      Json
  channels            NotificationChannel[]
  templateKey         String
  defaultLanguage     UiLanguage                 @default(EN)
  enabled             Boolean                    @default(true)
  timingOffsetMinutes Int                        @default(0)
  priority            NotificationPriority       @default(NORMAL)
  severity            SeeraInsightSeverity       @default(INFO)
  cooldownMinutes     Int                        @default(1440)
  configuration       Json?
  createdById         String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  createdBy           User                       @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  executions          SeeraAutomationExecution[]

  @@index([category, eventCode, enabled])
  @@map("seera_automation_rules")
}

model SeeraAutomationExecution {
  id                 String                         @id @default(cuid())
  ruleId             String
  eventKey           String
  recipientId        String
  language           UiLanguage
  status             SeeraAutomationExecutionStatus @default(PENDING)
  deduplicationKey   String                         @unique
  attemptCount       Int                            @default(0)
  nextAttemptAt      DateTime?
  sourceMetrics      Json
  providerReferences Json?
  lastErrorCode      String?
  createdAt          DateTime                       @default(now())
  processedAt        DateTime?
  rule               SeeraAutomationRule            @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  recipient          User                           @relation("AutomationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([recipientId, createdAt])
  @@map("seera_automation_executions")
}

model SeeraInsight {
  id               String               @id @default(cuid())
  ruleCode         String
  subjectType      String
  subjectId        String
  recipientId      String
  severity         SeeraInsightSeverity
  explanationKey   String
  explanationArgs  Json
  sourceMetrics    Json
  confidence       Decimal?             @db.Decimal(5, 4)
  actionPath       String?
  status           SeeraInsightStatus   @default(ACTIVE)
  deduplicationKey String               @unique
  generatedAt      DateTime             @default(now())
  expiresAt        DateTime?
  resolvedAt       DateTime?
  recipient        User                 @relation("InsightRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, status, severity, generatedAt])
  @@index([subjectType, subjectId])
  @@map("seera_insights")
}

model SeeraReportExport {
  id            String            @id @default(cuid())
  actorId       String
  reportCode    String
  format        SeeraReportFormat
  filters       Json
  scopeSnapshot Json
  rowCount      Int
  sensitive     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  actor         User              @relation("ReportExportActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, reportCode, createdAt])
  @@map("seera_report_exports")
}

model SeeraOfflineOperation {
  id                   String                     @id @default(cuid())
  clientOperationId    String
  userId               String
  deviceId             String
  sessionContext       Json
  entityType           String
  actionType           String
  localCreatedAt       DateTime
  payloadVersion       Int
  originalPayload      Json
  status               SeeraOfflineSyncStatus     @default(PENDING)
  retryCount           Int                        @default(0)
  lastErrorCode        String?
  serverAcknowledgment Json?
  conflictClass        SeeraOfflineConflictClass?
  conflictDetails      Json?
  syncedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  user                 User                       @relation("OfflineOperationUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, clientOperationId])
  @@index([userId, status, localCreatedAt])
  @@index([status, updatedAt])
  @@map("seera_offline_operations")
}

model SeeraSku {
  id                   String                         @id @default(cuid())
  code                 String                         @unique
  productName          String
  brand                String                         @default("Seera")
  category             String
  subcategory          String?
  packSize             Decimal                        @db.Decimal(14, 3)
  unitType             String
  unitsPerCase         Int
  mrp                  Decimal                        @db.Decimal(14, 2)
  hsn                  String?
  taxRate              Decimal?                       @db.Decimal(7, 4)
  minimumOrderMultiple Int                            @default(1)
  imageReference       String?
  status               MasterStatus                   @default(DRAFT)
  launchedAt           DateTime?
  discontinuedAt       DateTime?
  createdById          String
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  prices               SeeraPriceVersion[]
  schemes              SeeraScheme[]
  orderLines           SeeraOrderLine[]
  movements            SeeraInventoryMovement[]
  reconciliationLines  SeeraStockReconciliationLine[]

  @@index([status, category])
  @@map("seera_skus")
}

model SeeraPriceVersion {
  id            String       @id @default(cuid())
  skuId         String
  tier          PriceTier
  amount        Decimal      @db.Decimal(14, 2)
  mrpSnapshot   Decimal      @db.Decimal(14, 2)
  marginType    MarginType?
  marginValue   Decimal?     @db.Decimal(14, 4)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        MasterStatus @default(DRAFT)
  createdById   String
  createdAt     DateTime     @default(now())
  sku           SeeraSku     @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([skuId, tier, effectiveFrom])
  @@index([skuId, tier, status, effectiveFrom, effectiveTo])
  @@map("seera_price_versions")
}

model SeeraScheme {
  id              String       @id @default(cuid())
  name            String
  skuId           String?
  eligibilityType String
  minimumValue    Decimal?     @db.Decimal(14, 2)
  minimumQuantity Decimal?     @db.Decimal(14, 3)
  freeQuantity    Decimal?     @db.Decimal(14, 3)
  discountPercent Decimal?     @db.Decimal(7, 4)
  flatDiscount    Decimal?     @db.Decimal(14, 2)
  applicability   Json
  maximumBenefit  Decimal?     @db.Decimal(14, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime
  status          MasterStatus @default(DRAFT)
  createdById     String
  createdAt       DateTime     @default(now())
  sku             SeeraSku?    @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([skuId, status, effectiveFrom, effectiveTo])
  @@map("seera_schemes")
}

model SeeraGeographyNode {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  level     String
  parentId  String?
  status    MasterStatus @default(ACTIVE)
  metadata  Json?
  createdAt DateTime     @default(now())
