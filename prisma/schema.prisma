}

model FinanceExpenseClaim {
  id                  String    @id @default(cuid())
  organizationKey     String
  claimNumber         String
  claimantId          String
  status              String    @default("DRAFT")
  currency            String    @default("INR")
  totalClaimedAmount  Decimal   @default(0) @db.Decimal(18, 2)
