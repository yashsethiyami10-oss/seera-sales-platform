  featureFlag         String?
  // MUV AI Engineering Execution — Sprint 1 (Foundation Hardening). Completes
  // the AI Sutra's own 10-field Role Charter (Chapter 6.2) — the 6 fields
  // above already covered name/purpose/allowedRoles(=primary users)/
  // requiredPermissions(=data permissions)/allowedTools(=permitted-tasks
  // proxy)/knowledgeCategories(=approved knowledge domains); these 4 close
  // the remaining fields the Sutra spends the most words on: the actual
  // safety boundaries. Additive only — every existing row defaults to empty
  // arrays (no behavior change until a charter is deliberately populated).
  restrictedTasks     String[] @default([])
  prohibitedTasks     String[] @default([])
  escalationTriggers  String[] @default([])
  successMeasures     String[] @default([])
  // MUV AI Engineering Execution — Sprint 9 (EIOS Runtime). Not part of the
  // AI Sutra's 10-field Role Charter above (that set is already complete as
  // of Sprint 1) — a new, additional field this sprint introduces for
  // Personality composition. Documented shape (application-enforced, not
  // Postgres): { tone: string, formality: "casual"|"moderate"|"formal",
  // pace: string }. Defaults to {} — an agent with no profile set gets
  // EIOS's own hardcoded neutral fallback (lib/eios/personality.ts), never
  // a crash or a fabricated persona.
  personalityProfile  Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, organizationScope])
  @@map("ai_agent_definitions")
}

