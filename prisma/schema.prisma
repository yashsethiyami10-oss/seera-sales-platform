enum InstConfidence {
  LOW
  MEDIUM
  HIGH
}

// Rule-based (Module 6 explicitly forbids ML in this milestone). Formulas
// live in lib/inst-sales/consumption-rules.ts, versioned by `rulesVersion`
// so estimates stay reproducible/explainable even as the rules evolve.
model InstConsumptionEstimate {
