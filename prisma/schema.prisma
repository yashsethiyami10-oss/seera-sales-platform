  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([employeeId, status, claimDate])
  @@index([managerId, status, claimDate])
  @@map("seera_ta_claims")
}

model SeeraPartnerLifecycleEvent {
  id                  String                 @id @default(cuid())
  partnerId           String
  action              PartnerLifecycleAction
  fromLifecycle       PartnerLifecycle
  toLifecycle         PartnerLifecycle
  actorId             String
  approverId          String?
  reason              String
  obligationsSnapshot Json
  restoredScope       Json?
  forceClose          Boolean                @default(false)
  idempotencyKey      String                 @unique
  occurredAt          DateTime               @default(now())

  @@index([partnerId, occurredAt])
  @@map("seera_partner_lifecycle_events")
}
