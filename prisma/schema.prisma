  partnerType     String?
  territoryKey    String?
  priority        Int             @default(0)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdById     String
  createdAt       DateTime        @default(now())
  partner         NetworkPartner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([organizationKey, policyVersionId, partnerId, partnerType, territoryKey], map: "network_policy_applicability_key")
  @@index([organizationKey, partnerId, partnerType, effectiveFrom])
