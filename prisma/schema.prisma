  procurementPlanNumber String
  sourceSnapshotId      String
  periodStart           DateTime
  periodEnd             DateTime
  status                String   @default("DRAFT")
  recommendations       Json
  approvalReferenceId   String?
  version               Int      @default(1)
  createdById           String
  createdAt             DateTime @default(now())

  @@unique([organizationKey, procurementPlanNumber])
  @@index([organizationKey, status, periodStart])
  @@map("enterprise_procurement_plans")
}

model EnterprisePlanningOverride {
  id                  String   @id @default(cuid())
  organizationKey     String
  snapshotId          String
  targetType          String
  targetId            String
  previousValue       Json
  overrideValue       Json
  reason              String   @db.Text
  approvalReferenceId String?
  actorId             String
  createdAt           DateTime @default(now())

  @@index([organizationKey, snapshotId, createdAt])
  @@map("enterprise_planning_overrides")
}

// Enterprise Architecture v3.0 Phase 2 Part 3A shared foundations.
// These records provide cross-pillar governance only; domain records remain
// reserved for Parts 3B, 3C, and 3D.
model Phase2Operation {
  id                 String    @id @default(cuid())
  organizationKey    String
  idempotencyKey     String
  operationType      String
  requestFingerprint String?
  sourceDomain       String?
  sourceEntityType   String?
  sourceEntityId     String?
  sourceEventId      String?
  status             String    @default("PENDING")
  resultEntityType   String?
  resultEntityId     String?
  failureCode        String?
  correlationId      String
  createdById        String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@unique([organizationKey, operationType, idempotencyKey], map: "phase2_operations_organizationKey_operationType_idempotencyKey_")
  @@index([organizationKey, status, createdAt])
  @@index([organizationKey, sourceDomain, sourceEntityType, sourceEntityId], map: "phase2_operations_organizationKey_sourceDomain_sourceEntityType")
  @@index([correlationId])
  @@map("phase2_operations")
}

model Phase2PolicyVersion {
  id              String    @id @default(cuid())
  organizationKey String
  policyType      String
  policyKey       String
  version         Int
  status          String    @default("DRAFT")
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  configuration   Json      @default("{}")
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationKey, policyType, policyKey, version], map: "phase2_policy_versions_organizationKey_policyType_policyKey_ver")
  @@index([organizationKey, policyType, policyKey, status, effectiveFrom], map: "phase2_policy_versions_organizationKey_policyType_policyKey_sta")
  @@map("phase2_policy_versions")
}

model Phase2SourceReference {
  id               String   @id @default(cuid())
  organizationKey  String
  targetEntityType String
  targetEntityId   String
  sourceDomain     String
  sourceEntityType String
  sourceEntityId   String
  sourceEventId    String   @default("")
  sourceDocumentNo String?
  sourceVersion    Int?
  processingStatus String   @default("RECORDED")
  correlationId    String?
  createdAt        DateTime @default(now())

  @@unique([organizationKey, targetEntityType, targetEntityId, sourceDomain, sourceEntityType, sourceEntityId, sourceEventId], map: "phase2_source_references_organizationKey_targetEntityType_targe")
  @@index([organizationKey, sourceDomain, sourceEntityType, sourceEntityId], map: "phase2_source_references_organizationKey_source_idx")
  @@index([organizationKey, targetEntityType, targetEntityId], map: "phase2_source_references_organizationKey_target_idx")
  @@map("phase2_source_references")
}

model Phase2SodPolicy {
  id                   String   @id @default(cuid())
  organizationKey      String
  operationType        String
  preparerAction       String
  approverAction       String
  prohibitSameActor    Boolean  @default(true)
  overridePermission   String?
  overrideApprovalType String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationKey, operationType])
  @@index([organizationKey, active])
  @@map("phase2_sod_policies")
}

// ===========================================================================
// MUV Enterprise Architecture v3.0 — Phase 2 Part 3C, Wave 1 (Foundation)
// Enterprise Finance Platform. Additive only. Reuses Part 3A's organization
// scoping, trusted-principal, feature-flag (AiConfiguration), permission
// registry, serializable-transaction, source-reference, SoD, audit/timeline/
// notification, numbering, and job foundations unchanged. Journal/ledger/
// posting/AR/AP/expense/banking domain records are reserved for Wave 2-5 of
// this same Part 3C and are intentionally not modeled yet.
// ===========================================================================

model FinanceConfiguration {
  id                             String   @id @default(cuid())
  organizationKey                String   @unique
  baseCurrency                   String   @default("INR")
  accountingTimezone             String   @default("Asia/Kolkata")
  financialYearStartMonth        Int      @default(4)
  retainedEarningsAccountId      String?
  arControlAccountId             String?
  apControlAccountId             String?
  inputTaxControlAccountId       String?
  outputTaxControlAccountId      String?
  defaultCashAccountId           String?
  defaultBankAccountId           String?
  roundingAccountId              String?
  defaultExpensePayableAccountId String?
  postingPolicyVersion           Int      @default(1)
  status                         String   @default("DRAFT")
  effectiveFrom                  DateTime @default(now())
  version                        Int      @default(1)
  createdById                    String
  updatedById                    String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  retainedEarningsAccount      FinanceAccount? @relation("ConfigRetainedEarnings", fields: [retainedEarningsAccountId], references: [id])
  arControlAccount             FinanceAccount? @relation("ConfigArControl", fields: [arControlAccountId], references: [id])
  apControlAccount             FinanceAccount? @relation("ConfigApControl", fields: [apControlAccountId], references: [id])
  inputTaxControlAccount       FinanceAccount? @relation("ConfigInputTaxControl", fields: [inputTaxControlAccountId], references: [id])
  outputTaxControlAccount      FinanceAccount? @relation("ConfigOutputTaxControl", fields: [outputTaxControlAccountId], references: [id])
  defaultCashAccount           FinanceAccount? @relation("ConfigDefaultCash", fields: [defaultCashAccountId], references: [id])
  defaultBankAccount           FinanceAccount? @relation("ConfigDefaultBank", fields: [defaultBankAccountId], references: [id])
  roundingAccount              FinanceAccount? @relation("ConfigRounding", fields: [roundingAccountId], references: [id])
  defaultExpensePayableAccount FinanceAccount? @relation("ConfigExpensePayable", fields: [defaultExpensePayableAccountId], references: [id])

  @@map("finance_configurations")
}

model FinanceFiscalYear {
  id              String   @id @default(cuid())
  organizationKey String
  code            String
  startDate       DateTime
  endDate         DateTime
  status          String   @default("OPEN")
  version         Int      @default(1)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  periods            FinanceFiscalPeriod[]
  FinanceJournal     FinanceJournal[]
  FinanceLedgerEntry FinanceLedgerEntry[]

  @@unique([organizationKey, code])
  @@index([organizationKey, status])
  @@map("finance_fiscal_years")
}

model FinanceFiscalPeriod {
  id                String    @id @default(cuid())
  organizationKey   String
  fiscalYearId      String
  periodNumber      Int
  name              String
  startDate         DateTime
  endDate           DateTime
  status            String    @default("OPEN")
  closedById        String?
  closedAt          DateTime?
  reopenedById      String?
  reopenedAt        DateTime?
  // Milestone 8 — Financial Calendar (disclosed, additive extension).
  postingCutoffDate DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  fiscalYear         FinanceFiscalYear    @relation(fields: [fiscalYearId], references: [id])
  FinanceJournal     FinanceJournal[]
  FinanceLedgerEntry FinanceLedgerEntry[]

  @@unique([organizationKey, fiscalYearId, periodNumber])
  @@index([organizationKey, status, startDate])
  @@map("finance_fiscal_periods")
}

model FinanceCostCenter {
  id              String    @id @default(cuid())
  organizationKey String
  code            String
  name            String
  description     String?
  parentId        String?
  status          String    @default("ACTIVE")
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  version         Int       @default(1)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent             FinanceCostCenter?   @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children           FinanceCostCenter[]  @relation("CostCenterHierarchy")
  FinanceJournalLine FinanceJournalLine[]
  FinanceLedgerEntry FinanceLedgerEntry[]
  FinanceExpenseLine FinanceExpenseLine[]

  @@unique([organizationKey, code])
  @@index([organizationKey, status])
  @@map("finance_cost_centers")
}

model FinanceProfitCenter {
  id              String    @id @default(cuid())
  organizationKey String
  code            String
  name            String
  description     String?
  parentId        String?
  status          String    @default("ACTIVE")
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  version         Int       @default(1)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent             FinanceProfitCenter?  @relation("ProfitCenterHierarchy", fields: [parentId], references: [id])
  children           FinanceProfitCenter[] @relation("ProfitCenterHierarchy")
  FinanceJournalLine FinanceJournalLine[]
  FinanceLedgerEntry FinanceLedgerEntry[]
  FinanceExpenseLine FinanceExpenseLine[]

  @@unique([organizationKey, code])
  @@index([organizationKey, status])
  @@map("finance_profit_centers")
}

model FinanceAccount {
  id                               String    @id @default(cuid())
  organizationKey                  String
  accountCode                      String
  name                             String
  description                      String?
  category                         String
  subtype                          String?
  normalBalance                    String
  isControlAccount                 Boolean   @default(false)
  postingEnabled                   Boolean   @default(true)
  parentId                         String?
  hierarchyLevel                   Int       @default(1)
  status                           String    @default("DRAFT")
  financialStatementClassification String?
  cashFlowClassification           String?
  taxRelevant                      Boolean   @default(false)
  reconciliationRequired           Boolean   @default(false)
  isSystemAccount                  Boolean   @default(false)
  effectiveFrom                    DateTime  @default(now())
  effectiveTo                      DateTime?
  version                          Int       @default(1)
  createdById                      String
  updatedById                      String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  parent   FinanceAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children FinanceAccount[] @relation("AccountHierarchy")

  configAsRetainedEarnings     FinanceConfiguration[]         @relation("ConfigRetainedEarnings")
  configAsArControl            FinanceConfiguration[]         @relation("ConfigArControl")
  configAsApControl            FinanceConfiguration[]         @relation("ConfigApControl")
  configAsInputTaxControl      FinanceConfiguration[]         @relation("ConfigInputTaxControl")
  configAsOutputTaxControl     FinanceConfiguration[]         @relation("ConfigOutputTaxControl")
  configAsDefaultCash          FinanceConfiguration[]         @relation("ConfigDefaultCash")
  configAsDefaultBank          FinanceConfiguration[]         @relation("ConfigDefaultBank")
  configAsRounding             FinanceConfiguration[]         @relation("ConfigRounding")
  configAsExpensePayable       FinanceConfiguration[]         @relation("ConfigExpensePayable")
  FinanceJournalLine           FinanceJournalLine[]
  FinanceLedgerEntry           FinanceLedgerEntry[]
  FinanceReceivableInvoiceLine FinanceReceivableInvoiceLine[]
  FinanceVendorBillLine        FinanceVendorBillLine[]
  FinanceExpenseCategory       FinanceExpenseCategory[]
  FinanceExpenseLine           FinanceExpenseLine[]
  FinanceBankAccount           FinanceBankAccount[]

  @@unique([organizationKey, accountCode])
  @@index([organizationKey, status, category])
  @@map("finance_accounts")
}

// Enterprise Architecture v3.0 Phase 2 Part 3B — Enterprise Business Network.
// Status/type values are governed strings so organization policy can evolve
// without destructive enum migrations.
model NetworkPartner {
  id                    String    @id @default(cuid())
  organizationKey       String
  partnerNumber         String
  legalName             String
  tradeName             String?
  partnerType           String
  lifecycleStatus       String    @default("DRAFT")
  onboardingStatus      String    @default("NOT_STARTED")
  approvalStatus        String    @default("NOT_SUBMITTED")
  complianceStatus      String    @default("PENDING")
  activationStatus      String    @default("INACTIVE")
  taxRegistrationNumber String?
  registrationNumber    String?
  email                 String?
  phone                 String?
  website               String?
  bankDetailReference   String?
  metadata              Json      @default("{}")
  version               Int       @default(1)
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  activatedAt           DateTime?
  suspendedAt           DateTime?
  terminatedAt          DateTime?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  contacts        NetworkPartnerContact[]
  addresses       NetworkPartnerAddress[]
  profiles        NetworkPartnerProfile[]
  parents         NetworkPartnerHierarchy[]    @relation("NetworkHierarchyChild")
  children        NetworkPartnerHierarchy[]    @relation("NetworkHierarchyParent")
  onboardingCases NetworkOnboardingCase[]
  assignments     NetworkTerritoryAssignment[]
  agreements      NetworkAgreement[]
  policyLinks     NetworkPolicyApplicability[]
  royaltyLines    NetworkRoyaltyLine[]
  commissionLines NetworkCommissionLine[]
  targetLines     NetworkTargetLine[]
  claims          NetworkClaim[]
  supportCases    NetworkSupportCase[]
  training        NetworkTrainingAssignment[]
  compliance      NetworkComplianceRecord[]
  portalUsers     NetworkPartnerUser[]
  orderSources    NetworkPartnerOrderSource[]

  @@unique([organizationKey, partnerNumber])
  @@index([organizationKey, partnerType, lifecycleStatus, createdAt])
  @@index([organizationKey, legalName])
  @@map("network_partners")
}

model NetworkPartnerContact {
  id              String         @id @default(cuid())
  organizationKey String
  partnerId       String
  contactType     String
  name            String
  designation     String?
  email           String?
  phone           String?
  isPrimary       Boolean        @default(false)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  partner         NetworkPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([organizationKey, partnerId, active])
  @@map("network_partner_contacts")
}

model NetworkPartnerAddress {
  id              String         @id @default(cuid())
  organizationKey String
  partnerId       String
  addressType     String
  line1           String
  line2           String?
  city            String
  state           String
  postalCode      String
  country         String
  isPrimary       Boolean        @default(false)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  partner         NetworkPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([organizationKey, partnerId, active])
  @@map("network_partner_addresses")
}

model NetworkPartnerProfile {
  id              String         @id @default(cuid())
  organizationKey String
  partnerId       String
  partnerType     String
  configuration   Json           @default("{}")
  version         Int            @default(1)
  effectiveFrom   DateTime       @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime       @default(now())
  partner         NetworkPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([organizationKey, partnerId, partnerType, version])
  @@index([organizationKey, partnerType, effectiveFrom])
  @@map("network_partner_profiles")
}

model NetworkPartnerHierarchy {
  id                String         @id @default(cuid())
  organizationKey   String
  hierarchyType     String
  parentPartnerId   String
  childPartnerId    String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            String         @default("ACTIVE")
  createdById       String
  terminationReason String?
  createdAt         DateTime       @default(now())
  parent            NetworkPartner @relation("NetworkHierarchyParent", fields: [parentPartnerId], references: [id], onDelete: Restrict)
  child             NetworkPartner @relation("NetworkHierarchyChild", fields: [childPartnerId], references: [id], onDelete: Restrict)

  @@unique([organizationKey, hierarchyType, parentPartnerId, childPartnerId, effectiveFrom], map: "network_hierarchy_effective_key")
  @@index([organizationKey, childPartnerId, status, effectiveFrom])
  @@index([organizationKey, parentPartnerId, status, effectiveFrom])
  @@map("network_partner_hierarchy")
}

model NetworkOnboardingCase {
  id                String                         @id @default(cuid())
  organizationKey   String
  partnerId         String
  caseNumber        String
  status            String                         @default("DRAFT")
  checklistVersion  Int                            @default(1)
  submittedById     String?
  submittedAt       DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  correctionNotes   String?
  readinessSnapshot Json?
  version           Int                            @default(1)
  createdById       String
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  partner           NetworkPartner                 @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  requirements      NetworkOnboardingRequirement[]

  @@unique([organizationKey, caseNumber])
  @@index([organizationKey, partnerId, status])
  @@map("network_onboarding_cases")
}

model NetworkOnboardingRequirement {
  id              String                @id @default(cuid())
  organizationKey String
  onboardingId    String
  requirementKey  String
  requirementType String
  required        Boolean               @default(true)
  status          String                @default("PENDING")
  evidenceRefs    Json                  @default("[]")
  reviewedById    String?
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  onboarding      NetworkOnboardingCase @relation(fields: [onboardingId], references: [id], onDelete: Restrict)

  @@unique([organizationKey, onboardingId, requirementKey])
  @@index([organizationKey, onboardingId, status])
  @@map("network_onboarding_requirements")
}

model NetworkTerritory {
  id              String                       @id @default(cuid())
  organizationKey String
  territoryKey    String
  version         Int
  name            String
  territoryType   String
  parentKey       String?
  status          String                       @default("DRAFT")
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  geometry        Json?
  rules           Json                         @default("{}")
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime                     @default(now())
  assignments     NetworkTerritoryAssignment[]

  @@unique([organizationKey, territoryKey, version])
  @@index([organizationKey, status, effectiveFrom, effectiveTo])
  @@map("network_territories")
}

model NetworkTerritoryAssignment {
  id              String           @id @default(cuid())
