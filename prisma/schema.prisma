// ===========================================================================
// MUV AI Engineering Execution — Sprint 2: Knowledge Factory, Source Registry
// (implements MUV Intelligence Factory V4 §1 Canonical Source Layer and §3
// Intelligence Extraction Layer's provenance mechanism — frozen spec, not
// redesigned here). Additive only, no existing model touched. Organization-
// scoped following the Enterprise v3 convention (this module reuses
// requireEnterprisePrincipal, see lib/knowledge-factory/context.ts).
//
// sourceLocator is a Json object ({type, value}), never a bare file path —
// this is the corrected design from the start (V4 W-Gap 10), not a
// migration applied after the fact, since this table did not exist before
// this sprint.
// ===========================================================================

model CanonicalSourceDocument {
  id              String                    @id @default(cuid())
  organizationKey String                    @default("MUV")
  title           String
  documentType    String // free text: "AI_SUTRA" | "KNOWLEDGE_LIBRARY" | "PRODUCT_CHART" | "SOP" | "POLICY" | future types — same extensibility idiom every other domain vocabulary in this schema already uses
  sourceLocator   Json // { type: "FILE" | "URL" | "CMS_ID" | "CLOUD_OBJECT" | "API", value: string }
  fileHash        String // SHA-256 of the source content at ingestion time — the exact mechanism already proven this session to detect a byte-identical duplicate document
  authorityLevel  String // "CONSTITUTIONAL" | "OPERATIONAL" | "PRODUCT_TECHNICAL" | "EXPERIENCE" | "EXTERNAL" — lifted directly from the AI Sutra's own §11.5 source hierarchy, not invented
  status          String                    @default("ACTIVE") // ACTIVE | SUPERSEDED | RETIRED — never hard-deleted
  supersedesId    String?
  supersedes      CanonicalSourceDocument?  @relation("SourceSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    CanonicalSourceDocument[] @relation("SourceSupersession")
  ingestedById    String?
  ingestedBy      User?                     @relation("SourceDocumentIngestor", fields: [ingestedById], references: [id], onDelete: SetNull)
  ingestedAt      DateTime                  @default(now())
  lastVerifiedAt  DateTime?

  provenance SourceProvenance[]

  @@unique([organizationKey, fileHash])
  @@index([organizationKey, documentType])
  @@index([organizationKey, authorityLevel])
  @@index([organizationKey, status])
  @@map("canonical_source_documents")
}

model SourceProvenance {
  id                   String                  @id @default(cuid())
  organizationKey      String                  @default("MUV")
  sourceDocumentId     String
  sourceDocument       CanonicalSourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  targetType           String // "KnowledgeVersion" | "ProductIntelligenceVersion" | "ProblemIntelligenceVersion" | "CareIntelligenceVersion" | "CategoryIntelligenceVersion" | "ProductVariantIntelligenceVersion" — plain reference, no relation, matching every polymorphic reference already established in this schema
  targetId             String
  extractedById        String?
  extractedBy          User?                   @relation("SourceProvenanceExtractor", fields: [extractedById], references: [id], onDelete: SetNull)
  extractionConfidence String // "LOW" | "MODERATE" | "HIGH" — reuses ProblemConfidenceLevel's exact vocabulary (Module 3), not a new enum
  extractedAt          DateTime                @default(now())

  @@index([organizationKey, targetType, targetId])
  @@index([organizationKey, sourceDocumentId])
  @@map("source_provenance")
}

// ===========================================================================
// MUV AI Engineering Execution — Sprint 3: Knowledge Factory, Conflict Queue
// (implements V4 §4 Knowledge Normalization Layer + §8 Validation &
// Governance Layer's Conflict Queue — frozen spec, not redesigned). The
// permanent destination for every conflict this session's own Source Audit
// found (pricing/variant/naming conflicts between the Product Chart and
// individual SOPs) and every future one the Extraction/Normalization layers
// detect — a queryable governance record, not a one-time report.
// ===========================================================================

model KnowledgeConflict {
  id              String           @id @default(cuid())
  organizationKey String           @default("MUV")
  conflictType    String // "PRICING" | "VARIANT" | "NAMING" | "DUPLICATE_SOURCE" | "SOP" | "RECALL_AFFECTED" | future types — same extensibility idiom as documentType
  description     String           @db.Text
  sourceARef      String // e.g. "CanonicalSourceDocument:xyz / Product Chart row 12" — a plain, human-readable pointer, not a hard foreign key, since a conflict may reference something outside this schema (a raw source row, not yet an ingested object)
  sourceBRef      String
  severity        ProblemRiskLevel @default(MODERATE) // reused directly from Module 3 — no fourth near-identical severity enum
  status          String           @default("OPEN") // OPEN | RESOLVED | ACCEPTED_AS_KNOWN_LIMITATION
  resolvedById    String?
  resolvedBy      User?            @relation("KnowledgeConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolutionNote  String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([organizationKey, status])
  @@index([organizationKey, conflictType])
  @@map("knowledge_conflicts")
}

// ===========================================================================
// MUV AI Engineering Execution — Sprint 6: Retrieval Platform
// (implements MUV Intelligence Factory V4 Gap 1 — Semantic Retrieval Layer
// — frozen spec, not redesigned). The `pgvector` Postgres extension was
// verified installed and functional (v0.8.6, cosine-distance operator
// tested directly) before this model was written — not assumed. Uses
// Prisma's `Unsupported()` type since Prisma has no native vector type;
// all similarity queries go through raw SQL (see
// lib/retrieval/embedding-service.ts), matching the exact same "raw SQL
// where Prisma's DSL has no primitive" precedent already established for
// this schema's partial unique indexes.
//
// One embedding row per (targetType, targetId, model) — a re-embed with a
// different model coexists rather than overwrites, so a future model
// upgrade never silently loses the ability to compare against the
// previous model's vectors mid-migration.
// ===========================================================================

model KnowledgeEmbedding {
  id          String                      @id @default(cuid())
  targetType  String // "KnowledgeVersion" | "ProductIntelligenceVersion" | "ProblemIntelligenceVersion" | "CareIntelligenceVersion" | "CategoryIntelligenceVersion" | "ProductVariantIntelligenceVersion" — identical vocabulary to SourceProvenance.targetType, deliberately, since both describe the same six Foundation Version tables
  targetId    String
  model       String // which embedding model/provider generated this vector — e.g. "MOCK_DETERMINISTIC_V1" today, a real provider code once one is configured (AiProvider, existing table)
  embedding   Unsupported("vector(1536)")
  generatedAt DateTime                    @default(now())

  @@unique([targetType, targetId, model])
  @@index([targetType, targetId])
  @@map("knowledge_embeddings")
}

// ===========================================================================
// MUV AI Gateway — Phase 5.2, MUV Knowledge Publisher™ (frozen architecture:
// Knowledge Factory -> Publisher -> Runtime Database -> Embeddings/Search
// Index -> Knowledge API -> AI Gateway). This is a NEW, separate runtime read
// layer for the file-based MUV Knowledge Factory (docs/*-knowledge-factory/,
// 1,187 real Knowledge Objects, lib/runtime/knowledge-factory-loader.ts) —
// it does not touch, extend, or reuse KnowledgeItem/KnowledgeVersion above
// (Module 5's own DB-backed content model, a separate, older, currently-
// empty authoring system with its own admin workflow that was never built).
// Deliberately its own table rather than repurposing KnowledgeItem: the KO
// shape (koid, domainFactory, relationships[], isGapRecord, raw fields bag)
// doesn't map cleanly onto KnowledgeItem's slug/fileType/layer shape, and
// extending that existing, if currently unused, production model with KF-
// specific columns would be a much larger and riskier change than one new,
// purpose-built table.
//
// `PublishedKnowledgeRecord` is the sole runtime record type today; nothing
// reads from it yet (Knowledge API — lib/gateway/knowledge/ — still reads
// live from the Knowledge Factory files, unchanged, per "do not remove the
// existing file retrieval fallback yet"). Cutover is a distinct, separately
// approved future step.
//
// Embeddings reuse the existing, general-purpose `KnowledgeEmbedding` table
// above unchanged — `targetType: "PublishedKnowledgeRecord"` is a 7th value
// added to that table's established (String, not DB-enforced) targetType
// vocabulary, following the exact same "model name as the literal string"
// idiom the other six Foundation Version tables already use; nothing about
// KnowledgeEmbedding itself changes.
// ===========================================================================

// PUBLISHED: eligible AND currently live — the only status a post-cutover
// Knowledge API would ever be allowed to read from.
// PENDING_REVIEW: real, valid content (REVIEW_READY in the Knowledge
// Factory's own approval text) — stored for full visibility, never
// treated as public.
// DRAFT / PENDING_FOUNDER_INPUT: real, valid content, explicitly not
// eligible for publication.
// UNKNOWN_STATUS: the Knowledge Factory's own approval-status text could
// not be classified (see classifyApprovalTier()) — never silently
// guessed into one of the statuses above; always surfaced as a
// validation warning too.
// ARCHIVED: set only by the Publisher's deletion policy when a
// previously published KO's source file disappears from the Knowledge
// Factory — history preserved, excluded from normal retrieval, never
// hard-deleted.
// SOURCE_MISSING: reserved for a future, more granular distinction from
// ARCHIVED if ever needed; the current Publisher always uses ARCHIVED
// for a disappeared source (see lib/knowledge-publisher/archive.ts).
enum KnowledgePublicationStatus {
  PUBLISHED
  PENDING_REVIEW
  DRAFT
  PENDING_FOUNDER_INPUT
  UNKNOWN_STATUS
  ARCHIVED
  SOURCE_MISSING
}

model PublishedKnowledgeRecord {
  id         String @id @default(cuid())
  // Domain-qualified, globally stable: "{domain}:{koid}" — the
  // Publisher's one upsert key. A bare `koid` alone is only guaranteed
  // unique within the single source file that produced it (see the
  // Knowledge Factory loader's own real KOID-collision-across-
  // repositories bug, already found and fixed once); domain-qualifying
  // here makes a repeat of that exact failure mode structurally
  // impossible at this layer.
  sourceId   String @unique
  // The literal KO id as authored in the Knowledge Factory file — kept
  // verbatim (never normalized) for citation/display.
  koid       String
  // KnowledgeFactorySourceType's literal value (PRODUCT_KF/MARKETING_KF/
  // INSTITUTIONAL_SALES_KF/FOUNDER_INTELLIGENCE_KF/CUSTOMER_CARE_KF) —
  // plain String, not an enum, mirroring KnowledgeSourceType's own
  // documented "future sources must never require a migration" reasoning.
  domain     String
  title      String
  content    String @db.Text
  // Repo-relative path to the source markdown file (never absolute — an
  // absolute dev-machine path is not portable production data).
  sourcePath String

  // Real product/category linkage is NOT resolved automatically here —
  // the Knowledge Factory has no KOID -> Product.id mapping anywhere
  // today, and fuzzy title-matching against the live catalog is exactly
  // the kind of inferred/fabricated linkage the Knowledge API (Module 3)
  // already refuses to do. Left null until a real, Founder-reviewed
  // mapping exists; reported as a known gap, not silently guessed. No FK
  // relation is declared (unlike KnowledgeItem.productId above) since a
  // column that is always null today shouldn't force a change to the
  // Product model just to exist.
  productId String?
  // The Knowledge Factory's own free-text category/scope string (e.g.
  // "Constitution (CONSTITUTION)") — descriptive provenance, not a
  // foreign key into the real `Category` table.
  category  String?

  // The Knowledge Factory's raw, literal approval-status classification
  // (APPROVED/REVIEW_READY/DRAFT/OPEN_PENDING_FOUNDER_INPUT/UNKNOWN) —
  // preserved verbatim alongside the derived `publicationStatus` below so
  // the mapping between the two is always auditable, never opaque.
  approvalStatus    String
  publicationStatus KnowledgePublicationStatus @default(PENDING_REVIEW)
  // PermissionLayer's vocabulary (PUBLIC/INTERNAL/CONFIDENTIAL) — plain
  // String for the same extensibility reason as `domain` above. Knowledge
  // Factory content defaults to INTERNAL (internally authored
  // documentation, never raw public web content — same governance
  // decision the Knowledge API's normalize.ts already made for KF results).
  accessLayer       String                     @default("INTERNAL")

  // Increments only when `contentHash` changes on a re-publish — never on
  // a no-op run touching only `lastSeenAt`.
  version     Int    @default(1)
  // sha256 of the normalized title+content — the Publisher's sole "did
  // this actually change" signal, and the reason a re-run is idempotent
  // instead of rewriting every row every time.
  contentHash String

  isGapRecord        Boolean  @default(false)
  escalationRequired Boolean  @default(false)
  // Related KOIDs, verbatim from the Knowledge Factory record — cross-
  // references only, never the referenced content itself (same
  // "structured reference, never duplicated content" discipline as
  // Module 5's SourceReference).
  relationships      String[] @default([])
  // Every `- **Field:** value` pair the Knowledge Factory parser found,
  // preserved verbatim and in full — Founder governance/validation-rule
  // fields (Marketing/Institutional/Founder KF format) live here even
  // though this model doesn't structurally break most of them out into
  // their own columns, so nothing the source file said is ever lost.
  rawFields          Json     @default("{}")

  // ISO locale — always "en" today (no Knowledge Factory content
  // declares a locale yet); the column exists now so a future
  // multilingual variant is a new row, not a schema change.
  locale String @default("en")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  // Stamped on every publish run that still finds this KO's source file
  // present — the Publisher's deletion-policy signal: any row whose
  // `lastSeenAt` predates the current run's start time was NOT
  // rediscovered, and gets archived rather than silently left stale.
  lastSeenAt  DateTime

  @@index([domain])
  @@index([publicationStatus])
  @@index([productId])
  @@map("published_knowledge_records")
}

// One row per Publisher run (dry-run or live) — the persisted form of
// the structured Publish Report every run must return, so a run's real
// outcome is auditable after the fact and not only visible in that
// call's own return value. Mirrors KnowledgeRetrievalLog's existing
// "best-effort telemetry, one row per real operation" shape.
model KnowledgePublishRun {
  id         String   @id @default(cuid())
  // "DRY_RUN" | "PUBLISH"
  mode       String
  startedAt  DateTime @default(now())
  durationMs Int

  discovered Int
  validCount Int
  rejected   Int
  inserted   Int
  updated    Int
  unchanged  Int
  archived   Int

  embeddingsCreated Int
  embeddingsUpdated Int
  embeddingsSkipped Int

  warnings        Json @default("[]")
  errors          Json @default("[]")
  perDomainTotals Json @default("{}")

  @@index([mode, startedAt])
  @@map("knowledge_publish_runs")
}

// ===========================================================================
// MUV AI Gateway — AI Services Wave 2, Phase 5.6 (Observability). One new,
// additive telemetry table for the canonical lib/gateway/* path (Gateway,
// Provider Adapter, Commerce/Customer/Conversation Tool APIs) — mirrors the
// exact "best-effort telemetry, one row per real operation" shape
// KnowledgeRetrievalLog and KnowledgePublishRun already established above,
// not a new pattern. Deliberately separate from the internal Sales AI
// system's own AiTelemetry/AiSecurityEvent tables (lib/muv-ai/*) — same
// "two systems, no cross-contamination" discipline as the rest of this
// Gateway (see docs/ai-intelligence-core/FOUNDATION_STABILIZATION_5_2_1.md).
//
// `metadata` must never contain a full prompt, raw customer PII, an
// address, payment data, or raw Knowledge Factory content — every writer
// of this table runs its payload through lib/gateway/observability/
// redact.ts first (see that file for what is and isn't redacted).
// ===========================================================================

enum GatewayEventSeverity {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

// One fixed, known set for this phase — a plain String would fit this
// codebase's own "future values shouldn't need a migration" convention
// used for e.g. KnowledgeSourceType, but every one of these event types is
// an explicit Phase 5.6 requirement, not an open-ended extensible list —
// enum gives real DB-level validation for a set this well-defined, same
// choice already made for KnowledgePublicationStatus.
enum GatewayEventType {
  REQUEST
  GATEWAY_LATENCY
  PROVIDER_LATENCY
  KNOWLEDGE_RETRIEVAL_LATENCY
  COMMERCE_TOOL_USAGE
  CUSTOMER_TOOL_USAGE
  CONVERSATION_RUNTIME_USAGE
  TOKEN_USAGE
  PROVIDER_ERROR
  TOOL_ERROR
  TIMEOUT
  CANCELLATION
  RETRY
  RATE_LIMIT
  AUTHENTICATION_FAILURE
  AUTHORIZATION_FAILURE
  KNOWLEDGE_UNAVAILABLE
  CONVERSATION_LIFECYCLE
  HEALTH_CHECK
}

model GatewayObservabilityEvent {
  id         String               @id @default(cuid())
  // Correlates every event emitted while handling one logical request —
  // generated once per Gateway/tool call, threaded through, never a
  // session id or anything else that could double as an identity lookup.
  requestId  String
  eventType  GatewayEventType
  severity   GatewayEventSeverity @default(INFO)
  // Which subsystem emitted this — "gateway" | "commerce" | "customer" |
  // "conversation" | "provider" | "knowledge" | "security". Plain String
  // (not an enum) since new Gateway subsystems are exactly the kind of
  // "future source" this codebase already treats as free-text elsewhere
  // (KnowledgeSourceType's own documented reasoning).
  source     String
  durationMs Int?
  message    String
  // Already-redacted-before-write only — see this model's own header.
  metadata   Json                 @default("{}")
  createdAt  DateTime             @default(now())

  @@index([eventType, createdAt])
  @@index([requestId])
  @@index([severity, createdAt])
  @@map("gateway_observability_events")
}

// ===========================================================================
// MUV AI Gateway — Phase 6.1 (Knowledge Governance), MUV AI Live Activation.
// New, additive tooling for Founder-reviewed knowledge classification —
// does NOT touch or extend Module 5's frozen `PermissionLayer`
// (lib/retrieval/types.ts: PUBLIC/INTERNAL/CONFIDENTIAL) or `lib/gateway/
// knowledge/authorization.ts`'s frozen `kfDomainLayer` enforcement mapping
// (Phase 5.2.1) — both are part of the frozen AI Foundation and this phase
// does not modify it. This table only ever RECORDS a proposed, human-
// reviewed classification; "no automatic promotion" means approving a row
// here has no code-level effect on what `authorization.ts` actually
// enforces today — applying an approved classification to that frozen
// mapping is a distinct, separately authorized future step, not something
// this table or its service functions do themselves.
// ===========================================================================

enum KnowledgeGovernanceTier {
  PUBLIC
  CUSTOMER
  PARTNER
  INTERNAL
  FOUNDER
  CONFIDENTIAL
}

enum KnowledgeGovernanceReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model KnowledgeGovernanceClassification {
  id         String @id @default(cuid())
  // What is being classified — "KF_DOMAIN" (a whole Knowledge Factory
  // domain, e.g. "PRODUCT_KF") today; deliberately a plain String, not an
  // enum, so a future finer-grained target (a single KOID, a Published
  // Knowledge Record's sourceId) never needs a migration to be recorded.
  targetType String
  targetId   String

  proposedTier KnowledgeGovernanceTier
  status       KnowledgeGovernanceReviewStatus @default(PENDING_REVIEW)

  proposedById String?
  reviewedById String?
  reviewedAt   DateTime?
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Re-proposing for the same target updates the existing row rather than
  // creating a duplicate — one live classification decision per target,
  // with its own history implied by updatedAt, not a growing list of
  // competing proposals for the same thing.
  @@unique([targetType, targetId])
  @@index([status])
  @@map("knowledge_governance_classifications")
}

// ===========================================================================
// MUV AI Engineering Execution — Sprint 4: Knowledge Factory, Governance
// (implements V4 §7 Governance and Approval Model + EIOS §7 Founder
// self-approval rule — frozen spec, not redesigned). The Founder is the
// implicit root authority (no row required); ApprovalAuthority records
// every delegation away from that root, explicit, time-boxed, revocable —
// this is the direct, precise mechanism that removes the Founder as a
// routine bottleneck without weakening any high-risk decision.
// ===========================================================================

model ApprovalAuthority {
  id               String    @id @default(cuid())
  organizationKey  String    @default("MUV")
  principalId      String
  principal        User      @relation("ApprovalAuthorityPrincipal", fields: [principalId], references: [id], onDelete: Cascade)
  maxApprovalLevel String // "EDITORIAL" | "OPERATIONAL" | "EXPERT" | "GOVERNANCE" | "FOUNDER" — the AI Sutra's own 5-tier §11.8.6 hierarchy, reused verbatim
  scopeDomains     String[]  @default([]) // e.g. ["PRODUCT_INTELLIGENCE", "SOP"] — free text, same extensibility idiom as every other domain vocabulary in this schema
  delegatedById    String?
  delegatedBy      User?     @relation("ApprovalAuthorityDelegator", fields: [delegatedById], references: [id], onDelete: SetNull)
  validFrom        DateTime  @default(now())
  validUntil       DateTime? // null = indefinite; set = a temporary delegation
  revoked          Boolean   @default(false)
  revokedById      String?
  revokedBy        User?     @relation("ApprovalAuthorityRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([organizationKey, principalId, maxApprovalLevel])
  @@map("approval_authorities")
}

// A fixed, small, Founder-approved list (seeded once, changed rarely per
// V4's own description). Any change matching one of these categories
// requires a second, distinct approver — even from the Founder. This is the
// precise, non-blanket answer to "when does Founder self-approval not
// apply": everywhere EXCEPT these five named categories.
model HardMakerCheckerCategory {
  id              String  @id @default(cuid())
  organizationKey String  @default("MUV")
  category        String // "SAFETY_CRITICAL" | "LEGAL" | "RECALL" | "FINANCIAL" | "REGULATED"
  description     String  @db.Text
  active          Boolean @default(true)

  @@unique([organizationKey, category])
  @@map("hard_maker_checker_categories")
}

// ===========================================================================
// MUV AI Engineering Execution — Sprint 8: Learning System
// (implements V4 §9 Learning System — frozen spec, not redesigned). Closes
// the loop the retrieval/orchestration layers (Sprints 6-7) opened: what
// knowledge was actually used, what was reported wrong, and what change is
// proposed in response — all against the same six Foundation Version tables
// via the identical targetType/targetId polymorphic-reference idiom
// SourceProvenance and KnowledgeEmbedding already established above, not a
// new pattern. `status`/`outcome` are plain Strings with a documented
// vocabulary, matching KnowledgeConflict's own established idiom, not new
// Prisma enums.
//
// This is also where reviewDueAt/containsHistoricalPricing/
// requiresRevalidation land on all six Foundation Version tables at once
// (see each table's own comment above, e.g. KnowledgeVersion) — deliberately
// deferred from Sprint 5 so the six-table extension happens in one
// consistent pass, not two now and four later.
// ===========================================================================

model KnowledgeUsageReference {
  id              String   @id @default(cuid())
  organizationKey String   @default("MUV")
  targetType      String // identical vocabulary to SourceProvenance.targetType / KnowledgeEmbedding.targetType — the six Foundation Version table names
  targetId        String
  usedInAction    String // mirrors KnowledgeRetrievalLog.action — the caller/action that consumed this knowledge (e.g. "orchestration_tier0_mandatory")
  callerRole      String // CallerClearance.role snapshot at time of use — never a session FK, matching lib/retrieval/pipeline.ts's own "log the request shape, not identity" discipline
  usedAt          DateTime @default(now())

  @@index([organizationKey, targetType, targetId])
  @@index([organizationKey, usedAt])
  @@map("knowledge_usage_references")
}

model KnowledgeChangeProposal {
  id               String    @id @default(cuid())
  organizationKey  String    @default("MUV")
  targetType       String
  targetId         String
  currentVersionId String? // the published version this proposal responds to, if any — plain reference, not a hard FK, since it may target any of six different tables
  proposedChange   Json // structured diff/replacement for one or more `sections` keys — never free-form prose, so a reviewer can diff it programmatically
  rationale        String    @db.Text
  status           String    @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  proposedById     String
  proposedBy       User      @relation("KnowledgeChangeProposalProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  reviewedById     String?
  reviewedBy       User?     @relation("KnowledgeChangeProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  resolutionNote   String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationKey, targetType, targetId])
  @@index([organizationKey, status])
  @@map("knowledge_change_proposals")
}

// INCORRECT/FLAGGED outcomes drive lib/knowledge-factory/learning-service.ts's
// recordRecallEvent() to set requiresRevalidation = true on the matching
// Foundation Version row — the one place that flag is ever set automatically
// rather than by direct staff edit, closing the "detect drift, surface for
// review without unpublishing" loop V4 §9 describes.
model RecallEvent {
  id              String   @id @default(cuid())
  organizationKey String   @default("MUV")
  targetType      String
  targetId        String
  outcome         String // HELPFUL | UNHELPFUL | INCORRECT | FLAGGED
  note            String?  @db.Text
  reportedById    String?
  reportedBy      User?    @relation("RecallEventReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  occurredAt      DateTime @default(now())

  @@index([organizationKey, targetType, targetId])
  @@index([organizationKey, outcome])
  @@map("recall_events")
}

// ===========================================================================
// Milestone 9 — Customer Support (MUV OS). Additive only — nothing above
// this point (through FounderWorkspacePreference, the end of Part 3D) is
// touched. Built as an Enterprise v3-style module: every service requires an
// EnterprisePrincipal (lib/enterprise/context.ts), every table carries
// organizationKey, and no new Prisma relation is placed onto any frozen
// model (Customer, Order, InstOrder/BusinessOrder, EnterpriseBatch,
// FinanceLedgerEntry) — every cross-domain reference below is a plain,
// indexed, application-validated String id field, matching this codebase's
// own established polymorphic-reference idiom (EnterpriseWarehouseMovement.
// businessReferenceId, FinanceJournal.sourceId, etc.). Support never writes
// FinanceLedgerEntry rows directly — SupportRefundRequest approval calls
// recordFinanceEvent (lib/enterprise-finance/event-posting-service.ts),
// the same sanctioned entry point every other consumer of the Finance
// Platform already uses. Founder-facing alerting reuses Part 3D's existing
// FounderAlert (via lib/founder-os/alert-store.ts's upsertAlert) and
// FounderWidgetDefinition — no parallel founder-alert table is introduced.
// The pre-existing "Customer Support" SalesRole / support.manage permission
// / app/sales/support page (older Sales Channel Architecture shell) are a
// separate, unrelated surface — used as a generic low-privilege test
// fixture across dozens of Enterprise v3 integration tests — and are
// deliberately left untouched; this milestone introduces its own,
// differently-named roles and permission keys.
// ===========================================================================

enum SupportTicketCategory {
  GENERAL_INQUIRY
  COMPLAINT
  PRODUCT_ISSUE
  RETURN_REPLACEMENT
  REFUND
  WARRANTY_CLAIM
  ORDER_STATUS
  BILLING
  FEEDBACK
}

enum SupportTicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  WAITING_ON_INTERNAL
  RESOLVED
  CLOSED
  REOPENED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum SupportChannel {
  WEBSITE
  EMAIL
  PHONE
  WHATSAPP
  SOCIAL_MEDIA
  MARKETPLACE
  WALK_IN
  MANUAL_ENTRY
}

enum SupportCaseType {
  SIMPLE
  COMPLEX
}

model SupportTicket {
  id              String                @id @default(cuid())
  organizationKey String
  ticketNumber    String
  channel         SupportChannel
  category        SupportTicketCategory
  caseType        SupportCaseType       @default(SIMPLE)
  status          SupportTicketStatus   @default(NEW)
  priority        SupportPriority       @default(NORMAL)
  severity        String?
  subject         String
  description     String                @db.Text

  customerId  String
  orderId     String?
  instOrderId String?
  productId   String?
  variantId   String?

  departmentId String
  assignedToId String?
  ownerTeamId  String?

  slaPolicyId      String?
  responseDueAt    DateTime?
  resolutionDueAt  DateTime?
  slaPaused        Boolean   @default(false)
  slaPausedAt      DateTime?
  slaPausedMinutes Int       @default(0)
  slaBreached      Boolean   @default(false)
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  resolvedById     String?
  closedAt         DateTime?
  reopenedCount    Int       @default(0)

  version     Int      @default(1)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  department         SupportDepartment      @relation(fields: [departmentId], references: [id])
  productIssueReport ProductIssueReport?
  returnRequest      SupportReturnRequest?
  refundRequest      SupportRefundRequest?
  messages           SupportMessage[]
  notes              SupportTicketNote[]
  attachments        SupportAttachment[]
  followUps          SupportFollowUp[]
  escalations        SupportEscalation[]
  csatResponse       SupportCsatResponse?
  templateUsage      SupportTemplateUsage[]

  @@unique([organizationKey, ticketNumber])
  @@index([organizationKey, status, priority])
  @@index([organizationKey, assignedToId, status])
  @@index([organizationKey, customerId])
  @@index([organizationKey, departmentId, status])
  @@index([organizationKey, responseDueAt])
  @@index([organizationKey, resolutionDueAt])
  @@map("support_tickets")
}

model SupportTicketLink {
  id              String   @id @default(cuid())
  organizationKey String
  parentId        String
  childId         String
  linkType        String
  createdById     String
  createdAt       DateTime @default(now())

  @@unique([organizationKey, parentId, childId])
  @@map("support_ticket_links")
}

model ProductIssueReport {
  id              String   @id @default(cuid())
  organizationKey String
  ticketId        String   @unique
  productId       String
  variantId       String?
  batchId         String?
  issueType       String
  evidenceUrls    String[]
  rootCauseNotes  String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationKey, batchId])
  @@map("support_product_issue_reports")
}

model SupportReturnRequest {
  id              String    @id @default(cuid())
  organizationKey String
  ticketId        String    @unique
  orderId         String
  orderItemId     String?
  requestType     String
  status          String    @default("SUBMITTED")
  approvedById    String?
  approvedAt      DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationKey, orderId])
  @@map("support_return_requests")
}

model SupportRefundRequest {
  id                String    @id @default(cuid())
  organizationKey   String
  ticketId          String    @unique
  orderId           String?
  instOrderId       String?
  requestedAmount   Decimal   @db.Decimal(14, 2)
  reason            String    @db.Text
  status            String    @default("PENDING_APPROVAL")
  preparedById      String
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  processedAt       DateTime?
  financeEventLogId String?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationKey, orderId])
  @@map("support_refund_requests")
}

model WarrantyRegistration {
  id                String   @id @default(cuid())
  organizationKey   String
  customerId        String
  productId         String
  variantId         String?
  orderId           String?
  serialOrBatchRef  String?
  purchaseDate      DateTime
  warrantyExpiresAt DateTime
  status            String   @default("ACTIVE")
  registeredById    String
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationKey, customerId])
  @@map("support_warranty_registrations")
}

model SupportMessage {
  id              String         @id @default(cuid())
  organizationKey String
  ticketId        String
  direction       String
  authorType      String
  authorId        String?
  channel         SupportChannel
  body            String         @db.Text
  sentAt          DateTime       @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationKey, ticketId, sentAt])
  @@map("support_messages")
}

model SupportTicketNote {
  id              String   @id @default(cuid())
  organizationKey String
  ticketId        String
  authorId        String
  body            String   @db.Text
  createdAt       DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationKey, ticketId])
  @@map("support_ticket_notes")
}

model SupportAttachment {
  id              String   @id @default(cuid())
  organizationKey String
  ticketId        String
  uploadedById    String
  url             String
  fileName        String
  fileType        String
  uploadedAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationKey, ticketId])
  @@map("support_attachments")
}

model SupportFollowUp {
  id              String    @id @default(cuid())
  organizationKey String
  ticketId        String
  dueAt           DateTime
  assignedToId    String
  note            String?   @db.Text
  status          String    @default("PENDING")
  completedAt     DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationKey, assignedToId, status, dueAt])
