// Company Sales dispatch -> finished-goods batch/lot allocation (spec §15).
// FIFO-consumes released SeeraFinishedGoodsReceipt rows for the dispatched
// SKU; "remaining" per receipt is always DERIVED as receipt.quantity minus
// the sum of its allocations here (never a separately-stored counter that
// could drift) — same immutable-ledger philosophy as everything else in this
// module. Also the audit trail COGS posting reads its per-batch cost basis
// from (unitCost captured at allocation time, from the batch's SeeraBatchCost
// at that moment, so a later batch-cost recompute never rewrites a historical
// dispatch's COGS).
model SeeraCompanyDispatchAllocation {
  id             String   @id @default(cuid())
  orderId        String
  deliveryId     String
  skuId          String
  receiptId      String
  batchId        String
  quantity       Decimal  @db.Decimal(14, 3)
  unitCost       Decimal? @db.Decimal(16, 4)
  costConfidence CostConfidence @default(UNAVAILABLE)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([receiptId])
  @@index([orderId])
  @@index([skuId])
  @@map("seera_mfg_company_dispatch_allocations")
}
