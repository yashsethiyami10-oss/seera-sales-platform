model SupportEscalationRule {
  id              String   @id @default(cuid())
  organizationKey String
  name            String
  triggerType     String
  chainJson       Json
  active          Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationKey, active, triggerType])
  @@map("support_escalation_rules")
