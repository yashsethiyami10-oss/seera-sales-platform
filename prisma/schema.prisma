model FinanceExpenseLine {
  id                String   @id @default(cuid())
  organizationKey   String
  claimId           String
  lineNumber        Int
  categoryId        String
  description       String
  expenseDate       DateTime
  claimedAmount     Decimal  @db.Decimal(18, 2)
  approvedAmount    Decimal? @db.Decimal(18, 2)
  accountId         String
  costCenterId      String?
  profitCenterId    String?
  evidenceReference String?
  createdAt         DateTime @default(now())

  claim        FinanceExpenseClaim    @relation(fields: [claimId], references: [id])
  category     FinanceExpenseCategory @relation(fields: [categoryId], references: [id])
