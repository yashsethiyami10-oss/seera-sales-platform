  ownerId         String
  owner           User            @relation("InstQuotationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  versions InstQuotationVersion[]

  @@index([opportunityId])
  @@index([customerId])
  @@map("inst_quotations")
}

// Milestone 4.1 — Quotation Acceptance Workflow Enhancement. Acceptance can
// happen through any real-world channel a field Sales Officer actually
// encounters (verbal, phone, WhatsApp, signed hard copy, etc.), not only a
// future Customer Portal. Customer Portal is one more value here, not a
// separate mechanism — the acceptance engine below is channel-agnostic.
enum InstQuotationAcceptanceMethod {
  VERBAL_CONFIRMATION
  PHONE_CALL
  WHATSAPP
  EMAIL
  SIGNED_COPY
  CUSTOMER_PORTAL
  OTHER
}

model InstQuotationVersion {
  id                String                         @id @default(cuid())
  quotationId       String
  quotation         InstQuotation                  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  versionNumber     Int
  parentVersionId   String?
  parentVersion     InstQuotationVersion?          @relation("InstQuotationVersionParent", fields: [parentVersionId], references: [id], onDelete: Restrict)
  childVersions     InstQuotationVersion[]         @relation("InstQuotationVersionParent")
  status            InstQuotationStatus            @default(DRAFT)
  issueDate         DateTime
  validUntil        DateTime
  subtotal          Decimal                        @default(0) @db.Decimal(15, 2)
  discountTotal     Decimal                        @default(0) @db.Decimal(15, 2)
  taxTotal          Decimal                        @default(0) @db.Decimal(15, 2)
  grandTotal        Decimal                        @default(0) @db.Decimal(15, 2)
  termsSnapshot     String?                        @db.Text
  createdById       String
  createdBy         User                           @relation("InstQuotationVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById      String?
  approvedBy        User?                          @relation("InstQuotationVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  rejectionReason   String?
  sentAt            DateTime?
  sentVia           InstSendChannel?
  pdfUrl            String?
  revisionReason    String?
  // Milestone 4.1 — Quotation Acceptance Workflow Enhancement. Set only when
  // status transitions to ACCEPTED via acceptQuotation (actions/inst-quotations.ts).
  // acceptedById is who *recorded* the acceptance (a staff user today —
  // always the case until a real Customer Portal caller identity exists);
  // acceptanceMethod separately records how the customer actually
  // communicated it. "Business Order Created By/Date/ID" are deliberately
  // NOT duplicated here — SalesAuditLog's ORDER_CREATED_FROM_QUOTATION event
  // and the businessOrder relation below already carry that, without a
  // second copy of the same fact.
  acceptanceMethod  InstQuotationAcceptanceMethod?
  acceptedById      String?
  accepter          User?                          @relation("InstQuotationVersionAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt        DateTime?
  acceptanceRemarks String?                        @db.Text
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  lineItems     InstQuotationLineItem[]
  // Milestone 4 — Order Management OS. Reverse side of BusinessOrder's
  // unique quotationVersionId — one accepted version converts into at most
  // one order.
  businessOrder BusinessOrder?

  @@unique([quotationId, versionNumber])
  @@index([status])
  @@map("inst_quotation_versions")
}

model InstQuotationLineItem {
  id                 String               @id @default(cuid())
  quotationVersionId String
  quotationVersion   InstQuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  productId          String
  product            Product              @relation("InstQuotationLineItemProducts", fields: [productId], references: [id], onDelete: Restrict)
  variantId          String?
  variant            ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  displayOrder       Int                  @default(0)
  quantity           Int
  unitPrice          Decimal              @db.Decimal(12, 2)
  discountPercent    Decimal              @default(0) @db.Decimal(5, 2)
  taxRate            Decimal              @db.Decimal(5, 2)
  lineTotal          Decimal              @db.Decimal(15, 2)

  @@map("inst_quotation_line_items")
}

// Milestone 4 — Order Management OS. Named BusinessOrder/BusinessOrderItem
// (not InstOrder) deliberately: this table currently originates only from
// an accepted Institutional quotation (quotationVersionId is mandatory —
// see the field comment below), but the naming stays channel-neutral so a
// future Corporate/Dealer/Distributor/Franchise/Export order flow is not
// blocked by the name. No such future-channel workflow is implemented in
// this milestone. A fully separate table from the general Order/
// CommerceOrderStatus pipeline (lib/commerce/services.ts) and from the
// frozen D2C Order model — mirrors Milestone 3's own precedent of not
// reusing the general Opportunity/Quotation models. Tracking-only this
// milestone: no inventory allocation, invoicing, or payment automation —
// status is staff-set manually.
// Milestone 4.2 — Direct Business Order Workflow. Repurposed from the
// original {D2C, INSTITUTIONAL} channel distinction (D2C was always an
// unused placeholder on this table — D2C orders live entirely in the
// separate, frozen `Order` model, never here) into an explicit *workflow
// origin* label. quotationVersionId's nullability alone was deliberately
// NOT used as the source of truth for this, per explicit instruction — a
// future non-quotation origin (CUSTOMER_PORTAL, MANUAL, WHATSAPP,
// REPEAT_ORDER) also wouldn't have a quotationVersionId, so a single
// nullable-FK signal can't distinguish between them. Only the two values
// this milestone actually produces are added now — no speculative future
// values.
enum BusinessOrderSource {
  QUOTATION
  DIRECT_LEAD
}

enum BusinessOrderStatus {
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

// Milestone 6 — Dispatch & Delivery. Basic courier information only, per
// approved scope — no courier API integration, no live tracking.
enum BusinessOrderDispatchMethod {
  COURIER
  SELF_DELIVERY
  TRANSPORT
}

model BusinessOrder {
  id                   String                       @id @default(cuid())
  // No @default/@unique here — uniqueness is the compound
  // [organizationKey, orderNumber] constraint below. Assigned by a
  // dedicated DB sequence/trigger (Step 2), not application code; callers
  // insert "" as the "please assign one" sentinel, matching the existing,
  // already-proven pattern in migration 20260801100000.
  orderNumber          String
  // Forward-compatible only, per explicit instruction — always "MUV" today.
  // No isolation/switching/resolution logic reads or enforces this field
  // anywhere in Milestone 4. Mirrors the existing Enterprise-track
  // organizationKey idiom (lib/enterprise/context.ts's ENTERPRISE_ORGANIZATION).
  // The repository remains single-company; this field does not introduce
  // multi-company behavior.
  organizationKey      String                       @default("MUV")
  // Mandatory (NOT NULL) after the Milestone 4.2 migration — every existing
  // row was backfilled to QUOTATION as part of that migration itself (see
  // its own header comment), not a separate UPDATE statement.
  source               BusinessOrderSource          @default(QUOTATION)
  // Milestone 4.2 — nullable: a DIRECT_LEAD-sourced order genuinely has no
  // quotation. Still unique when present (Postgres treats multiple NULLs as
  // distinct under a unique index, so this doesn't weaken the "one order
  // per accepted quotation version" guarantee for QUOTATION-sourced rows).
  // Duplicate-prevention for DIRECT_LEAD orders instead uses a partial
  // unique index on (opportunityId) WHERE source='DIRECT_LEAD' — raw SQL in
  // the migration, not expressible in this schema file (Prisma has no
  // partial-index syntax), see that migration's own comment.
  quotationVersionId   String?                      @unique
  quotationVersion     InstQuotationVersion?        @relation(fields: [quotationVersionId], references: [id], onDelete: Restrict)
  opportunityId        String?
  opportunity          InstOpportunity?             @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  customerId           String
  customer             Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ownerId              String
  owner                User                         @relation("BusinessOrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  territoryId          String?
  territory            Territory?                   @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  status               BusinessOrderStatus          @default(CONFIRMED)
  // Snapshotted from the accepted quotation version at conversion time —
  // never recomputed live, matching the "never trust/recompute totals"
  // rule for this milestone.
  subtotal             Decimal                      @default(0) @db.Decimal(15, 2)
  discountTotal        Decimal                      @default(0) @db.Decimal(15, 2)
  taxTotal             Decimal                      @default(0) @db.Decimal(15, 2)
  grandTotal           Decimal                      @default(0) @db.Decimal(15, 2)
  deliveryAddress      String?                      @db.Text
  expectedDeliveryDate DateTime?
  // Dispatch panel fields (Step 15) — plain tracking data only, no courier
  // API, no AWB generation, no label — that is explicitly Milestone 5 scope.
  carrierName          String?
  trackingReference    String?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  // Milestone 6 — Dispatch & Delivery. Real FKs (not audit-log-derived):
  // "who dispatched/delivered this order" is core order-state information,
  // the same reasoning already applied to ownerId/warehouseId — not
  // incidental audit metadata. Both nullable/SetNull, matching every other
  // optional FK on this model (territoryId, opportunityId, warehouseId).
  dispatchMethod       BusinessOrderDispatchMethod?
  dispatchedById       String?
  dispatchedBy         User?                        @relation("BusinessOrderDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  dispatchNotes        String?                      @db.Text
  deliveredById        String?
  deliveredBy          User?                        @relation("BusinessOrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)
  deliveryConfirmation String?
  deliveryRemarks      String?                      @db.Text
  cancelledAt          DateTime?
  cancelReason         String?                      @db.Text
  // Milestone 5 — Operations Foundation. Single warehouse assumed for now
  // (exactly one active Warehouse row exists) — the field is a real FK to
  // the existing, already-generic Warehouse model rather than a hardcoded
  // constant, so a future multi-warehouse milestone doesn't need a
  // structural change here, only real routing logic on top of it.
  warehouseId          String?
  warehouse            Warehouse?                   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  items        BusinessOrderItem[]
  reservations InventoryReservation[]
  // Block 3, Part D — reciprocal side of Shipment.businessOrderId.
  shipment     Shipment?

  @@unique([organizationKey, orderNumber])
  @@index([organizationKey, status])
  @@index([organizationKey, customerId])
  @@index([organizationKey, ownerId, status])
  @@index([organizationKey, territoryId])
  @@index([opportunityId])
  @@index([warehouseId])
  @@map("business_orders")
}

model BusinessOrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           BusinessOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Snapshotted from InstQuotationLineItem at conversion time. No product
  // name/display snapshot field — InstQuotationLineItem itself stores none
  // either (relies on the live product relation), so this matches that
  // existing convention rather than adding a field the source data lacks.
  productId       String
  product         Product         @relation("BusinessOrderItemProducts", fields: [productId], references: [id], onDelete: Restrict)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  displayOrder    Int             @default(0)
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  discountPercent Decimal         @default(0) @db.Decimal(5, 2)
  taxRate         Decimal         @db.Decimal(5, 2)
  lineTotal       Decimal         @db.Decimal(15, 2)

  @@map("business_order_items")
}

enum InstTaskType {
  PERSONAL
  ASSIGNED
  FOLLOWUP
  DAILY
}

enum InstTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InstTask {
  id            String           @id @default(cuid())
  title         String
  description   String?          @db.Text
  type          InstTaskType     @default(PERSONAL)
  priority      InstPriority     @default(MEDIUM)
  status        InstTaskStatus   @default(PENDING)
  dueDate       DateTime?
  completedAt   DateTime?
  assignedToId  String
  assignedTo    User             @relation("InstTaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedById  String?
  assignedBy    User?            @relation("InstTaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  leadId        String?
  lead          InstLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   InstOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([assignedToId, status, dueDate])
  @@map("inst_tasks")
}

model InstDailyPlan {
  id              String    @id @default(cuid())
  officerId       String
  officer         User      @relation("InstDailyPlanOfficer", fields: [officerId], references: [id], onDelete: Restrict)
  planDate        DateTime  @db.Date
  notes           String?   @db.Text
  endOfDaySummary String?   @db.Text
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([officerId, planDate])
  @@map("inst_daily_plans")
}

enum InstExpenseCategory {
  FUEL
  PARKING
  TOLL
  HOTEL
  FOOD
  OTHER
}

enum InstExpenseStatus {
  PENDING_MANAGER
  APPROVED
  REJECTED
}

// Approval workflow (Module 12): Officer submits → Manager approves/rejects.
// "Founder Visibility" is a read scope (Founder sees every expense via
// dashboard.all-equivalent permission below), not a third workflow state.
model InstExpense {
  id              String              @id @default(cuid())
  officerId       String
  officer         User                @relation("InstExpenseOfficer", fields: [officerId], references: [id], onDelete: Restrict)
  category        InstExpenseCategory
  amount          Decimal             @db.Decimal(10, 2)
  expenseDate     DateTime
  description     String?
  receiptUrl      String?
  status          InstExpenseStatus   @default(PENDING_MANAGER)
  approvedById    String?
  approvedBy      User?               @relation("InstExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([officerId, status])
  @@map("inst_expenses")
}

model InstRoute {
  id                   String    @id @default(cuid())
  officerId            String
  officer              User      @relation("InstRouteOfficer", fields: [officerId], references: [id], onDelete: Restrict)
  routeDate            DateTime  @db.Date
  plannedStops         Json
  actualStops          Json?
  plannedDistanceKm    Decimal?  @db.Decimal(8, 2)
  actualDistanceKm     Decimal?  @db.Decimal(8, 2)
  plannedTravelMinutes Int?
  actualTravelMinutes  Int?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([officerId, routeDate])
  @@map("inst_routes")
}

enum InstTargetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model InstTarget {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("InstTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  periodType    InstTargetPeriod
  periodStart   DateTime         @db.Date
  periodEnd     DateTime         @db.Date
  targetRevenue Decimal          @db.Decimal(15, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, periodType, periodStart])
  @@map("inst_targets")
}

// Generic, polymorphic-by-convention (entityType + entityId, not an FK) so
// one Notes/Attachments implementation serves Lead, Opportunity, Visit,
// Sample, and Quotation alike — matching Module 2's "Notes/Attachments"
// requirement without five near-identical join tables.
enum InstEntityType {
  LEAD
  OPPORTUNITY
  VISIT
  SAMPLE
  QUOTATION
  // Milestone 4 — Order Management OS. Lets InstNote/InstAttachment work on
  // BusinessOrder with no new table.
  ORDER
}

model InstNote {
  id         String         @id @default(cuid())
  entityType InstEntityType
  entityId   String
  body       String         @db.Text
  authorId   String
  author     User           @relation("InstNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@map("inst_notes")
}

model InstAttachment {
  id           String         @id @default(cuid())
  entityType   InstEntityType
  entityId     String
  fileName     String
  url          String
  sizeBytes    Int?
  uploadedById String
  uploadedBy   User           @relation("InstAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())

  @@index([entityType, entityId])
  @@map("inst_attachments")
}

model FinanceJournalLine {
  id              String   @id @default(cuid())
  organizationKey String
  journalId       String
  lineNumber      Int
  accountId       String
  debitAmount     Decimal  @default(0) @db.Decimal(18, 2)
  creditAmount    Decimal  @default(0) @db.Decimal(18, 2)
  currency        String   @default("INR")
  description     String?
  costCenterId    String?
  profitCenterId  String?
  sourceLineType  String?
  sourceLineId    String?
  createdAt       DateTime @default(now())

  journal       FinanceJournal       @relation(fields: [journalId], references: [id])
  account       FinanceAccount       @relation(fields: [accountId], references: [id])
  costCenter    FinanceCostCenter?   @relation(fields: [costCenterId], references: [id])
  profitCenter  FinanceProfitCenter? @relation(fields: [profitCenterId], references: [id])
  ledgerEntries FinanceLedgerEntry[]

  @@unique([organizationKey, journalId, lineNumber])
  @@index([organizationKey, accountId])
  @@map("finance_journal_lines")
}

model FinanceLedgerEntry {
  id              String   @id @default(cuid())
  organizationKey String
  journalId       String
  journalLineId   String
  accountId       String
  fiscalYearId    String
  fiscalPeriodId  String
  postingDate     DateTime
  debitAmount     Decimal  @default(0) @db.Decimal(18, 2)
  creditAmount    Decimal  @default(0) @db.Decimal(18, 2)
  currency        String   @default("INR")
  costCenterId    String?
  profitCenterId  String?
  sourceType      String?
  sourceId        String?
  sourceVersion   Int?
  postedAt        DateTime @default(now())
  // Denormalized from FinanceJournal.journalType at posting time (Part 3C
  // independent-audit repair pass) so getPeriodActivitySummary can group by
  // it with a real database aggregation instead of fetching raw rows and
  // reducing them in application code. Populated by every ledger-entry
  // creation path in posting-engine.ts (the only writer); immutable like
  // every other column here, via the same unconditional append-only
  // trigger — no trigger change was needed to protect this new column.
  journalType     String

  journal                    FinanceJournal               @relation(fields: [journalId], references: [id])
  journalLine                FinanceJournalLine           @relation(fields: [journalLineId], references: [id])
  account                    FinanceAccount               @relation(fields: [accountId], references: [id])
  fiscalYear                 FinanceFiscalYear            @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriod               FinanceFiscalPeriod          @relation(fields: [fiscalPeriodId], references: [id])
  costCenter                 FinanceCostCenter?           @relation(fields: [costCenterId], references: [id])
  profitCenter               FinanceProfitCenter?         @relation(fields: [profitCenterId], references: [id])
  FinanceReconciliationMatch FinanceReconciliationMatch[]

  @@index([organizationKey, accountId, postingDate])
  @@index([organizationKey, fiscalPeriodId])
  @@index([organizationKey, fiscalPeriodId, journalType])
  @@index([organizationKey, journalId])
  @@index([organizationKey, sourceType, sourceId])
  @@index([organizationKey, costCenterId])
  @@index([organizationKey, profitCenterId])
  @@map("finance_ledger_entries")
}

// ===========================================================================
// MUV Enterprise Architecture v3.0 — Phase 2 Part 3C, Stage B — Accounts
// Receivable. Reuses the existing, authoritative `Customer` model directly
// (no duplicate customer identity) — `FinanceCustomerAccount` is a thin,
// organization-scoped Finance wrapper around a real `Customer.id`. Credit
// notes and write-off approval are intentionally deferred (see
// docs/enterprise-phase2/PART_3C_ENTERPRISE_FINANCE_PLATFORM.md); this
// covers invoice issue -> GL posting, receipts, and allocation only.
// ===========================================================================

model FinanceCustomerAccount {
  id                            String    @id @default(cuid())
  organizationKey               String
  customerId                    String    @unique
  status                        String    @default("ACTIVE")
  creditLimit                   Decimal?  @db.Decimal(18, 2)
  paymentTermsDays              Int       @default(30)
  // Milestone 8 — Customer/Supplier Credit Control (disclosed, additive
  // extension to this frozen model, explicitly authorized by this
  // milestone's own approval — see the block-header note above
  // FinanceEventPostingRule for the governance basis).
  temporaryCreditLimit          Decimal?  @db.Decimal(18, 2)
  temporaryCreditLimitExpiresAt DateTime?
  riskRating                    String?
  creditHold                    Boolean   @default(false)
  creditHoldReason              String?
  creditHoldSetAt               DateTime?
  creditHoldOverrideById        String?
  creditHoldOverrideReason      String?
  creditHoldOverrideExpiresAt   DateTime?
  paymentTermTemplateId         String?
  version                       Int       @default(1)
  createdById                   String
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  customer Customer                   @relation(fields: [customerId], references: [id])
  invoices FinanceReceivableInvoice[]
  receipts FinanceCustomerReceipt[]

  @@unique([organizationKey, customerId])
  @@index([organizationKey, status])
  @@map("finance_customer_accounts")
}

model FinanceReceivableInvoice {
  id                String    @id @default(cuid())
  organizationKey   String
  invoiceNumber     String
  customerAccountId String
  sourceOrderId     String?
  issueDate         DateTime
  dueDate           DateTime
  currency          String    @default("INR")
  subtotal          Decimal   @db.Decimal(18, 2)
  discountAmount    Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal   @db.Decimal(18, 2)
  outstandingAmount Decimal   @db.Decimal(18, 2)
  status            String    @default("DRAFT")
  journalId         String?   @unique
  createdById       String
  updatedById       String?
  issuedById        String?
  issuedAt          DateTime?
  cancelledById     String?
  cancelledAt       DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customerAccount FinanceCustomerAccount         @relation(fields: [customerAccountId], references: [id])
  journal         FinanceJournal?                @relation(fields: [journalId], references: [id])
  lines           FinanceReceivableInvoiceLine[]
  allocations     FinanceReceiptAllocation[]

  @@unique([organizationKey, invoiceNumber])
  @@index([organizationKey, customerAccountId, status])
  @@index([organizationKey, status, dueDate])
  @@index([organizationKey, sourceOrderId])
  @@map("finance_receivable_invoices")
}

model FinanceReceivableInvoiceLine {
  id              String   @id @default(cuid())
  organizationKey String
  invoiceId       String
  lineNumber      Int
  description     String
  quantity        Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(18, 2)
  lineAmount      Decimal  @db.Decimal(18, 2)
  accountId       String
  createdAt       DateTime @default(now())

  invoice FinanceReceivableInvoice @relation(fields: [invoiceId], references: [id])
  account FinanceAccount           @relation(fields: [accountId], references: [id])

  @@unique([organizationKey, invoiceId, lineNumber])
  @@map("finance_receivable_invoice_lines")
}

model FinanceCustomerReceipt {
  id                String   @id @default(cuid())
  organizationKey   String
  receiptNumber     String
  customerAccountId String
  receiptDate       DateTime
  amount            Decimal  @db.Decimal(18, 2)
  unallocatedAmount Decimal  @db.Decimal(18, 2)
  currency          String   @default("INR")
  paymentMethod     String?
  reference         String?
  status            String   @default("RECORDED")
  journalId         String?  @unique
  createdById       String
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerAccount FinanceCustomerAccount     @relation(fields: [customerAccountId], references: [id])
  journal         FinanceJournal?            @relation(fields: [journalId], references: [id])
  allocations     FinanceReceiptAllocation[]

  @@unique([organizationKey, receiptNumber])
  @@index([organizationKey, customerAccountId, status])
  @@map("finance_customer_receipts")
}

model FinanceReceiptAllocation {
  id                     String   @id @default(cuid())
  organizationKey        String
  receiptId              String
  invoiceId              String
  allocatedAmount        Decimal  @db.Decimal(18, 2)
  status                 String   @default("ACTIVE")
  reversalOfAllocationId String?  @unique
  allocatedById          String
  allocatedAt            DateTime @default(now())

  receipt    FinanceCustomerReceipt    @relation(fields: [receiptId], references: [id])
  invoice    FinanceReceivableInvoice  @relation(fields: [invoiceId], references: [id])
  reversalOf FinanceReceiptAllocation? @relation("AllocationReversal", fields: [reversalOfAllocationId], references: [id])
  reversedBy FinanceReceiptAllocation? @relation("AllocationReversal")

  @@index([organizationKey, receiptId])
  @@index([organizationKey, invoiceId])
  @@map("finance_receipt_allocations")
}

// ===========================================================================
// MUV Enterprise Architecture v3.0 — Phase 2 Part 3C, Stage B — Accounts
// Payable. Reuses the existing, authoritative Phase 1 `EnterpriseVendor`
// model directly (no duplicate supplier master) — `FinanceVendorAccount` is
// a thin, organization-scoped Finance wrapper around a real
// `EnterpriseVendor.id`, mirroring `FinanceCustomerAccount`'s relationship
// to `Customer`.
// ===========================================================================

model FinanceVendorAccount {
  id                     String   @id @default(cuid())
  organizationKey        String
  vendorId               String   @unique
  status                 String   @default("ACTIVE")
  paymentTermsDays       Int      @default(30)
  // Milestone 8 — Supplier Credit Control (disclosed, additive extension).
  riskRating             String?
  creditHold             Boolean  @default(false)
  creditHoldReason       String?
  creditHoldOverrideById String?
  paymentTermTemplateId  String?
  version                Int      @default(1)
  createdById            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vendor   EnterpriseVendor       @relation(fields: [vendorId], references: [id])
  bills    FinanceVendorBill[]
  payments FinanceVendorPayment[]

  @@unique([organizationKey, vendorId])
  @@index([organizationKey, status])
  @@map("finance_vendor_accounts")
}

model FinanceVendorBill {
  id                    String    @id @default(cuid())
  organizationKey       String
  billNumber            String
  vendorAccountId       String
  supplierInvoiceNo     String
  sourcePurchaseOrderId String?
  billDate              DateTime
  dueDate               DateTime
  currency              String    @default("INR")
  subtotal              Decimal   @db.Decimal(18, 2)
  taxAmount             Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount           Decimal   @db.Decimal(18, 2)
  outstandingAmount     Decimal   @db.Decimal(18, 2)
  status                String    @default("DRAFT")
  journalId             String?   @unique
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  postedById            String?
  postedAt              DateTime?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  vendorAccount FinanceVendorAccount             @relation(fields: [vendorAccountId], references: [id])
  journal       FinanceJournal?                  @relation(fields: [journalId], references: [id])
  lines         FinanceVendorBillLine[]
  allocations   FinanceVendorPaymentAllocation[]

  @@unique([organizationKey, billNumber])
  @@unique([organizationKey, vendorAccountId, supplierInvoiceNo])
  @@index([organizationKey, status, dueDate])
  @@map("finance_vendor_bills")
}

model FinanceVendorBillLine {
  id              String   @id @default(cuid())
  organizationKey String
  billId          String
  lineNumber      Int
  description     String
  quantity        Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(18, 2)
  lineAmount      Decimal  @db.Decimal(18, 2)
  accountId       String
  createdAt       DateTime @default(now())

  bill    FinanceVendorBill @relation(fields: [billId], references: [id])
  account FinanceAccount    @relation(fields: [accountId], references: [id])

  @@unique([organizationKey, billId, lineNumber])
  @@map("finance_vendor_bill_lines")
}

model FinanceVendorPayment {
  id                String    @id @default(cuid())
  organizationKey   String
  paymentNumber     String
  vendorAccountId   String
  paymentDate       DateTime
  amount            Decimal   @db.Decimal(18, 2)
  unallocatedAmount Decimal   @db.Decimal(18, 2)
  currency          String    @default("INR")
  paymentMethod     String?
  reference         String?
  status            String    @default("REQUESTED")
  journalId         String?   @unique
  requestedById     String
  approvedById      String?
  approvedAt        DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vendorAccount FinanceVendorAccount             @relation(fields: [vendorAccountId], references: [id])
  journal       FinanceJournal?                  @relation(fields: [journalId], references: [id])
  allocations   FinanceVendorPaymentAllocation[]

  @@unique([organizationKey, paymentNumber])
  @@index([organizationKey, vendorAccountId, status])
  @@map("finance_vendor_payments")
}

model FinanceVendorPaymentAllocation {
  id                     String   @id @default(cuid())
  organizationKey        String
  paymentId              String
  billId                 String
  allocatedAmount        Decimal  @db.Decimal(18, 2)
  status                 String   @default("ACTIVE")
  reversalOfAllocationId String?  @unique
  allocatedById          String
  allocatedAt            DateTime @default(now())

  payment    FinanceVendorPayment            @relation(fields: [paymentId], references: [id])
  bill       FinanceVendorBill               @relation(fields: [billId], references: [id])
  reversalOf FinanceVendorPaymentAllocation? @relation("VendorAllocationReversal", fields: [reversalOfAllocationId], references: [id])
  reversedBy FinanceVendorPaymentAllocation? @relation("VendorAllocationReversal")

  @@index([organizationKey, paymentId])
  @@index([organizationKey, billId])
  @@map("finance_vendor_payment_allocations")
}

// ===========================================================================
// MUV Enterprise Architecture v3.0 — Phase 2 Part 3C, Stage B — Expense
// Management. Posts through the default expense-payable control account
// (FinanceConfiguration.defaultExpensePayableAccountId) and reimburses
// exactly like an AP payment (debit payable, credit cash/bank) — mirrors
// the AR/AP pattern rather than introducing a third posting shape.
// ===========================================================================

model FinanceExpenseCategory {
