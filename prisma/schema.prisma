  leadId             String?
  lead               InstLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId      String?
  opportunity        InstOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  officerId          String
  officer            User              @relation("InstVisitOfficer", fields: [officerId], references: [id], onDelete: Restrict)
  visitDate          DateTime
  checkInAt          DateTime?
  checkOutAt         DateTime?
  checkInLat         Decimal?          @db.Decimal(9, 6)
  checkInLng         Decimal?          @db.Decimal(9, 6)
  checkOutLat        Decimal?          @db.Decimal(9, 6)
  checkOutLng        Decimal?          @db.Decimal(9, 6)
  meetingNotes       String?           @db.Text
  photoUrls          String[]          @default([])
  requirements       String?           @db.Text
  competitorProducts String[]          @default([])
  decisionMaker      String?
  outcome            InstVisitOutcome?
  nextFollowUpDate   DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  survey InstSurvey?

