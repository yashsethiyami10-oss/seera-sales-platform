// ===========================================================================
// MUV Enterprise Architecture v3.0 — Phase 2 Part 3C, Stage B — Banking
// Foundation and Reconciliation. No real bank integration, no external
// execution — statement import is a governed Business Service accepting
// caller-supplied line data (Section 22), never scraping or connecting to
// a real bank. Masked account identifiers only; no credential storage.
// ===========================================================================

model FinanceBankAccount {
  id                  String   @id @default(cuid())
  organizationKey     String
  code                String
  name                String
  institutionName     String?
  maskedAccountNumber String?
  currency            String   @default("INR")
  linkedGlAccountId   String
  status              String   @default("ACTIVE")
  version             Int      @default(1)
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  linkedGlAccount FinanceAccount                 @relation(fields: [linkedGlAccountId], references: [id])
  statements      FinanceBankStatement[]
  sessions        FinanceReconciliationSession[]

  @@unique([organizationKey, code])
  @@index([organizationKey, status])
  @@map("finance_bank_accounts")
}

model FinanceBankStatement {
  id              String   @id @default(cuid())
  organizationKey String
  bankAccountId   String
  statementRef    String
  periodStart     DateTime
  periodEnd       DateTime
  openingBalance  Decimal  @db.Decimal(18, 2)
  closingBalance  Decimal  @db.Decimal(18, 2)
  status          String   @default("IMPORTED")
  importedById    String
  createdAt       DateTime @default(now())

  bankAccount FinanceBankAccount             @relation(fields: [bankAccountId], references: [id])
  lines       FinanceBankStatementLine[]
  sessions    FinanceReconciliationSession[]

  @@unique([organizationKey, bankAccountId, statementRef])
  @@index([organizationKey, bankAccountId, status])
  @@map("finance_bank_statements")
}

model FinanceBankStatementLine {
  id                String   @id @default(cuid())
  organizationKey   String
  statementId       String
  lineNumber        Int
  transactionDate   DateTime
  description       String
  debitAmount       Decimal  @default(0) @db.Decimal(18, 2)
  creditAmount      Decimal  @default(0) @db.Decimal(18, 2)
  externalReference String
  status            String   @default("UNMATCHED")
  createdAt         DateTime @default(now())

  statement FinanceBankStatement         @relation(fields: [statementId], references: [id])
  matches   FinanceReconciliationMatch[]

  @@unique([organizationKey, statementId, externalReference])
  @@index([organizationKey, statementId, status])
  @@map("finance_bank_statement_lines")
}

model FinanceReconciliationSession {
  id              String    @id @default(cuid())
  organizationKey String
  bankAccountId   String
  statementId     String
  status          String    @default("IN_PROGRESS")
  openingBalance  Decimal   @db.Decimal(18, 2)
  closingBalance  Decimal   @db.Decimal(18, 2)
  preparedById    String
  completedById   String?
  completedAt     DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bankAccount FinanceBankAccount           @relation(fields: [bankAccountId], references: [id])
  statement   FinanceBankStatement         @relation(fields: [statementId], references: [id])
  matches     FinanceReconciliationMatch[]

  @@index([organizationKey, bankAccountId, status])
  @@map("finance_reconciliation_sessions")
}

model FinanceReconciliationMatch {
  id                  String   @id @default(cuid())
  organizationKey     String
  sessionId           String
  statementLineId     String
  matchType           String
  ledgerEntryId       String?
  adjustmentJournalId String?
  status              String   @default("ACTIVE")
  reversalOfMatchId   String?  @unique
  matchedById         String
  matchedAt           DateTime @default(now())

  session           FinanceReconciliationSession @relation(fields: [sessionId], references: [id])
  statementLine     FinanceBankStatementLine     @relation(fields: [statementLineId], references: [id])
  ledgerEntry       FinanceLedgerEntry?          @relation(fields: [ledgerEntryId], references: [id])
  adjustmentJournal FinanceJournal?              @relation(fields: [adjustmentJournalId], references: [id])
  reversalOf        FinanceReconciliationMatch?  @relation("ReconciliationMatchReversal", fields: [reversalOfMatchId], references: [id])
  reversedBy        FinanceReconciliationMatch?  @relation("ReconciliationMatchReversal")

  @@index([organizationKey, sessionId])
  @@index([organizationKey, statementLineId])
  @@map("finance_reconciliation_matches")
}

// ===========================================================================
// Milestone 8 — Finance & Accounts (MUV OS). Additive only — nothing above
// this point (through FinanceReconciliationMatch, the end of frozen Part 3C)
// is touched, per that Part's own governed change-control clause: "Any
// future change to anything in this list goes through governed change
// control as a new, additive Part." Every model below either posts through
// the existing, unmodified FinanceJournal/posting-engine (never a parallel
// ledger), or references an existing model (frozen Part 3C or otherwise) by
// a plain, indexed, application-validated id field — never a new Prisma
// relation onto a frozen model — matching this codebase's own established
// polymorphic-reference idiom (EnterpriseWarehouseMovement.businessReferenceId,
// StockLedgerEntry.referenceId, FinanceJournal.sourceId itself). The two
// genuine exceptions are FinanceCustomerAccount, FinanceVendorAccount, and
// FinanceFiscalPeriod, which gain a small number of new nullable columns
// (credit control fields; postingCutoffDate) — a disclosed, additive
// extension explicitly authorized by this milestone's own approval, not a
// silent change.
// ===========================================================================

// --- Event-driven accounting safeguard ---
// "A business event must produce either exactly one valid financial
// posting, or a visible governed exception requiring resolution. It must
// never disappear silently." FinanceEventProcessingLog is the durable,
// idempotent status record that guarantees this — one row per
// (organizationKey, sourceModule, sourceEventAction, sourceRecordId),
// unique, so a retried or duplicate business event can never post twice.

model FinanceEventPostingRule {
  id                String   @id @default(cuid())
  organizationKey   String
  sourceModule      String
  sourceEventAction String
  journalType       String
  debitAccountCode  String
  creditAccountCode String
  description       String?
  active            Boolean  @default(true)
  version           Int      @default(1)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationKey, sourceModule, sourceEventAction])
  @@index([organizationKey, active])
  @@map("finance_event_posting_rules")
}

model FinanceEventProcessingLog {
  id                String    @id @default(cuid())
  organizationKey   String
  sourceModule      String
  sourceEventAction String
  sourceRecordId    String
  idempotencyKey    String
  // PENDING -> POSTED | FAILED | SKIPPED_NO_RULE. FAILED rows are retried
  // manually (Unposted Events UI); nothing here is a dead-letter deletion —
  // failed rows remain forever as the visible exception record itself.
  status            String    @default("PENDING")
  journalId         String?
  failureReason     String?
  retryCount        Int       @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([organizationKey, idempotencyKey])
  @@index([organizationKey, status])
  @@index([organizationKey, sourceModule, sourceRecordId])
  @@map("finance_event_processing_log")
}

// --- Credit Notes / Debit Notes ---
// Explicitly deferred by Part 3C's own freeze document. Never the same
// transaction as a refund (a refund is a cash/bank outflow against an
// existing receipt; a Credit Note reduces what a customer owes and may or
// may not ever be paid out in cash).

model FinanceCreditNote {
  id                String    @id @default(cuid())
  organizationKey   String
  creditNoteNumber  String
  customerAccountId String
  invoiceId         String?
  reasonCode        String
  status            String    @default("DRAFT")
  totalAmount       Decimal   @db.Decimal(18, 2)
  allocatedAmount   Decimal   @default(0) @db.Decimal(18, 2)
  journalId         String?   @unique
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines       FinanceCreditNoteLine[]
  allocations FinanceCreditNoteAllocation[]

  @@unique([organizationKey, creditNoteNumber])
  @@index([organizationKey, customerAccountId, status])
  @@map("finance_credit_notes")
}

model FinanceCreditNoteLine {
  id              String   @id @default(cuid())
  organizationKey String
  creditNoteId    String
  lineNumber      Int
  description     String
  quantity        Decimal? @db.Decimal(12, 3)
  unitPrice       Decimal? @db.Decimal(18, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  lineAmount      Decimal  @db.Decimal(18, 2)
  accountId       String
  createdAt       DateTime @default(now())

  creditNote FinanceCreditNote @relation(fields: [creditNoteId], references: [id])

  @@unique([organizationKey, creditNoteId, lineNumber])
  @@map("finance_credit_note_lines")
}

model FinanceCreditNoteAllocation {
  id              String   @id @default(cuid())
  organizationKey String
  creditNoteId    String
  invoiceId       String
  allocatedAmount Decimal  @db.Decimal(18, 2)
  status          String   @default("ACTIVE")
  allocatedById   String
  allocatedAt     DateTime @default(now())

  creditNote FinanceCreditNote @relation(fields: [creditNoteId], references: [id])

  @@index([organizationKey, creditNoteId])
  @@index([organizationKey, invoiceId])
  @@map("finance_credit_note_allocations")
}

model FinanceDebitNote {
