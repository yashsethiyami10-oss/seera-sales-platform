model FinanceDepreciationEntry {
  id              String    @id @default(cuid())
  organizationKey String
  assetId         String
  fiscalPeriodId  String
  plannedAmount   Decimal   @db.Decimal(18, 2)
  postedAmount    Decimal?  @db.Decimal(18, 2)
  status          String    @default("PLANNED")
  journalId       String?   @unique
  postedById      String?
  postedAt        DateTime?
  createdAt       DateTime  @default(now())

  asset FinanceFixedAsset @relation(fields: [assetId], references: [id])

  @@unique([organizationKey, assetId, fiscalPeriodId])
  @@index([organizationKey, fiscalPeriodId, status])
