generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DISABLED
}

enum UiLanguage {
  EN
  HI
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum RoleAssignmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  // Provider-confirmed delivery states, driven by inbound WhatsApp status webhooks
  // (app/api/webhooks/whatsapp/route.ts) — only ever reached FROM PUBLISHED, never fabricated
  // client-side. PUBLISHED keeps its existing meaning ("provider accepted the send call") for
  // every pre-existing caller; these are strictly later stages in the same message's lifecycle.
  DELIVERED
  READ
  FAILED
  DEAD_LETTER
}

enum FileClassification {
  GENERAL
  FINANCIAL
  LEGAL
  IDENTITY
  FIELD_EVIDENCE
}

enum FileScanStatus {
  PENDING
  CLEAN
  REJECTED
  FAILED
}

enum FileLifecycleStatus {
  ACTIVE
  QUARANTINED
  REVOKED
  DELETED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

