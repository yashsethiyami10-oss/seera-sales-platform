  @@unique([organizationKey, budgetId, revisionNumber])
  @@map("finance_budget_revisions")
}

// --- Manufacturing Costing extension ---
// batchId references EnterpriseBatch.id by plain id (no Prisma relation —
// see this block's header note); one row per EnterpriseBatch, created at
// batch completion and refined as actual costs become known.

model FinanceBatchCost {
  id                     String   @id @default(cuid())
  organizationKey        String
  batchId                String   @unique
  costingMethod          String   @default("STANDARD")
  directMaterialCost     Decimal  @default(0) @db.Decimal(18, 2)
  packagingCost          Decimal  @default(0) @db.Decimal(18, 2)
  directLaborCost        Decimal  @default(0) @db.Decimal(18, 2)
  machineCost            Decimal  @default(0) @db.Decimal(18, 2)
  utilityCost            Decimal  @default(0) @db.Decimal(18, 2)
  overheadCost           Decimal  @default(0) @db.Decimal(18, 2)
  qualityControlCost     Decimal  @default(0) @db.Decimal(18, 2)
  normalWastageCost      Decimal  @default(0) @db.Decimal(18, 2)
  abnormalWastageCost    Decimal  @default(0) @db.Decimal(18, 2)
  freightInwardAllocated Decimal  @default(0) @db.Decimal(18, 2)
  otherLandedCost        Decimal  @default(0) @db.Decimal(18, 2)
  subcontractingCost     Decimal  @default(0) @db.Decimal(18, 2)
  totalCost              Decimal  @default(0) @db.Decimal(18, 2)
  costPerUnit            Decimal? @db.Decimal(18, 4)
  standardCostPerUnit    Decimal? @db.Decimal(18, 4)
  varianceAmount         Decimal? @db.Decimal(18, 2)
  journalId              String?  @unique
  version                Int      @default(1)
  createdAt              DateTime @default(now())
