  partner         NetworkPartner    @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([organizationKey, planId, partnerId, metricKey])
  @@index([organizationKey, partnerId, metricKey])
  @@map("network_target_lines")
}

model NetworkClaim {
  id               String         @id @default(cuid())
  organizationKey  String
