// ===========================================================================
// MUV Enterprise Architecture v3.0 — Phase 2 Part 3C, Stage A (Accounting
// Core). Additive only, built on Wave 1's FinanceConfiguration/FiscalYear/
// FiscalPeriod/CostCenter/ProfitCenter/FinanceAccount above. Money fields
// use Decimal(18,2) — 16 integer digits, 2 fractional (matching
// NetworkPartnerOrderSource.attributedAmount immediately above, the most
// recent precedent in this schema) — never JavaScript `number`. No
// FinanceDocumentSequence model: journal numbering reuses the existing
// EnterpriseSequence/nextEnterpriseNumber (documented deviation, Wave 1
// convention). No separate FinanceJournalSource model: source provenance is
// carried on FinanceJournal's own sourceType/sourceId/sourceVersion columns
// for fast queries, and additionally recorded through the existing
// Phase2SourceReference/recordSourceReference for the shared cross-module
// provenance ledger.
// ===========================================================================

model FinanceJournal {
  id                    String    @id @default(cuid())
  organizationKey       String
  journalNumber         String
  journalType           String
  status                String    @default("DRAFT")
  postingDate           DateTime
  documentDate          DateTime
  currency              String    @default("INR")
  description           String?
  reference             String?
  sourceType            String?
  sourceId              String?
  sourceVersion         Int?
  fiscalYearId          String?
  fiscalPeriodId        String?
  totalDebit            Decimal   @default(0) @db.Decimal(18, 2)
  totalCredit           Decimal   @default(0) @db.Decimal(18, 2)
  reversalOfJournalId   String?   @unique
  reversedByJournalId   String?   @unique
  correctionOfJournalId String?   @unique
  successorJournalId    String?   @unique
  reason                String?
  createdById           String
  updatedById           String?
  submittedById         String?
  approvedById          String?
  rejectedById          String?
  postedById            String?
  cancelledById         String?
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  postedAt              DateTime?
  cancelledAt           DateTime?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  fiscalYear    FinanceFiscalYear?   @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriod  FinanceFiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  lines         FinanceJournalLine[]
  ledgerEntries FinanceLedgerEntry[]

  reversalOf                 FinanceJournal?              @relation("JournalReversal", fields: [reversalOfJournalId], references: [id])
  reversedBy                 FinanceJournal?              @relation("JournalReversal")
  correctionOf               FinanceJournal?              @relation("JournalCorrection", fields: [correctionOfJournalId], references: [id])
  successor                  FinanceJournal?              @relation("JournalCorrection")
  FinanceReceivableInvoice   FinanceReceivableInvoice?
  FinanceCustomerReceipt     FinanceCustomerReceipt?
  FinanceVendorBill          FinanceVendorBill?
  FinanceVendorPayment       FinanceVendorPayment?
  FinanceExpenseClaim        FinanceExpenseClaim?
  FinanceReconciliationMatch FinanceReconciliationMatch[]

  @@unique([organizationKey, journalNumber])
  @@index([organizationKey, status, postingDate])
  @@index([organizationKey, journalType, status])
  @@index([organizationKey, sourceType, sourceId])
  @@index([organizationKey, fiscalPeriodId])
  @@map("finance_journals")
}

// =============================================================================
// Institutional Sales OS (Milestone 3) — MUV OS™ (app/os).
//
// By explicit Founder decision, this is a fully isolated Lead/Opportunity/
// Quotation pipeline — separate from Enterprise v3's existing `Opportunity`/
// `Quotation` models (which power app/dashboard/* + components/sales/*, and
// remain completely untouched). Every model below is new and prefixed
// `Inst`; nothing here is read or written by any Enterprise v3 route,
// action, or component.
//
// What IS reused, deliberately, to avoid duplicating master data:
// Customer (single source of truth for contact/business data once a Lead
// converts), Territory, User (as Sales Officer/Manager/Founder — via the
// existing SalesRole system in lib/sales/authorization.ts, not a new role
// system), Product/ProductVariant (real catalog, no shadow product list),
// LeadSource (a pure name/code lookup, not workflow state), and
// SalesAuditLog (via lib/sales/audit.ts's appendAuditLog — the shared,
// append-only audit trail already required by every domain in this app).
// =============================================================================

enum InstLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  SAMPLE_REQUIRED
  SAMPLE_GIVEN
  TRIAL_RUNNING
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum InstPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model InstLead {
  id               String         @id @default(cuid())
  leadNumber       String         @unique
  organizationName String
  contactPerson    String
  phone            String
  email            String?
  city             String?
  territoryId      String?
  territory        Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  leadSourceId     String?
  leadSource       LeadSource?    @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?          @relation("InstLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User           @relation("InstLeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  priority         InstPriority   @default(MEDIUM)
  status           InstLeadStatus @default(NEW)
  estimatedValue   Decimal        @default(0) @db.Decimal(15, 2)
  lostReason       String?
  qualifiedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  opportunity InstOpportunity?
  visits      InstVisit[]
  followUps   InstFollowUp[]
  tasks       InstTask[]

  @@index([status, assignedToId])
  @@index([territoryId])
  @@index([createdAt])
  @@map("inst_leads")
}

enum InstOpportunityStage {
  QUALIFICATION
  CUSTOMER_VISIT
  REQUIREMENT_ANALYSIS
  SAMPLE_ISSUED
  FOLLOW_UP
  TRIAL
  QUOTATION
  NEGOTIATION
  WON
  LOST
}

model InstOpportunity {
  id                String               @id @default(cuid())
  opportunityNumber String               @unique
  leadId            String?              @unique
  lead              InstLead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId        String
  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ownerId           String
  owner             User                 @relation("InstOpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  territoryId       String?
  territory         Territory?           @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  stage             InstOpportunityStage @default(QUALIFICATION)
  estimatedRevenue  Decimal              @default(0) @db.Decimal(15, 2)
  expectedQuantity  Int?
  probability       Int                  @default(20)
  closingDate       DateTime?
  risks             String?              @db.Text
  competitors       String?              @db.Text
  nextAction        String?              @db.Text
  nextActionDate    DateTime?
  lostReason        String?
  wonAt             DateTime?
  lostAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  products                   InstOpportunityProduct[]
  visits                     InstVisit[]
  samples                    InstSample[]
  followUps                  InstFollowUp[]
  quotations                 InstQuotation[]
  tasks                      InstTask[]
  // Milestone 4 — Order Management OS.
  businessOrders             BusinessOrder[]
  // MUV AI Engineering Execution — Sprint 11 (Domain Foundations).
  salesIntelligenceSnapshots SalesIntelligenceSnapshot[]

  @@index([stage, ownerId])
  @@index([customerId])
  @@index([territoryId])
  @@index([closingDate])
  @@map("inst_opportunities")
}

// ---------------------------------------------------------------------------
// MUV AI Engineering Execution — Sprint 11: Domain Foundations, Sales
// Intelligence Foundation. Research before this sprint confirmed no
// forecast/health-score/churn concept exists anywhere for the Institutional
// Sales OS (unlike "Customer Intelligence," which already exists in full as
// CustomerIntelligenceProfile/lib/growth/* — Phase 6 — and is reused, not
// duplicated, by this sprint's other change in
// lib/retrieval/operational-data-adapter.ts). Mirrors
// CustomerIntelligenceSnapshot's own append-only versioned-snapshot pattern
// (never mutates a prior snapshot) rather than a single live-updated row, so
// deal-health trend over time is preserved.
// ---------------------------------------------------------------------------
model SalesIntelligenceSnapshot {
  id            String               @id @default(cuid())
  opportunityId String
  opportunity   InstOpportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stage         InstOpportunityStage

  daysSinceLastActivity   Int
  quotationCount          Int
  acceptedQuotationCount  Int
  quotationAcceptanceRate Decimal @default(0) @db.Decimal(10, 4)

  // 0-100, deterministic, formula documented in
  // lib/sales/sales-intelligence-service.ts — never a learned/AI score,
  // same "never manufacture confidence" discipline as Module 6.
  dealHealthScore    Int
  // Reuses lib/intelligence/types.ts's IntelligenceLevel vocabulary
  // (LOW/MEDIUM/HIGH/URGENT) as a plain string — not a Prisma enum
  // cross-import between the two tracks, matching KnowledgeConflict's own
  // "reused directly... no fourth near-identical severity enum" reasoning,
  // applied here across tracks instead of within one. HIGH = healthiest;
  // URGENT = at risk of stalling, needs attention now.
  dealHealthLevel    String
  evidence           String[]
  calculationVersion String   @default("v1")
  generatedAt        DateTime @default(now())

  @@index([opportunityId, generatedAt])
  @@map("sales_intelligence_snapshots")
}

// ---------------------------------------------------------------------------
// MUV AI Engineering Execution — Sprint 11: Domain Foundations, Compliance
// Requirement Registry. No generic ComplianceRequirement concept existed
// anywhere before this sprint (confirmed by research) — the two adjacent
// existing things are NetworkComplianceRequirement/NetworkComplianceRecord
// (Enterprise Network track, hard-scoped to partner training/certification,
// see model below for the relation) and ProblemIntelligenceVersion's static
// requiredDisclaimers/prohibitedRecommendation/riskLevel fields (product-
// safety content metadata, no requirement lifecycle/tracking/expiry). This
// model mirrors NetworkComplianceRequirement/Record's proven versioned-
// requirement + versioned-record-of-compliance-per-target SHAPE, generalized
// to any target via the same targetType/targetId polymorphic idiom
// SourceProvenance/KnowledgeEmbedding/KnowledgeUsageReference already use —
// it does not touch or extend the Network-scoped models, which stay frozen.
// ---------------------------------------------------------------------------
model ComplianceRequirement {
  id              String    @id @default(cuid())
  organizationKey String    @default("MUV")
  requirementKey  String
  version         Int       @default(1)
  name            String
  description     String    @db.Text
  scopeType       String // "PRODUCT_INTELLIGENCE" | "PROBLEM_INTELLIGENCE" | "CATEGORY_INTELLIGENCE" | "AI_AGENT" | "GENERAL" — extensible, same idiom as CanonicalSourceDocument.documentType
  mandatory       Boolean   @default(true)
  status          String    @default("ACTIVE") // ACTIVE | RETIRED
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  createdById     String
  createdBy       User      @relation("ComplianceRequirementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())

  records ComplianceRecord[]

  @@unique([organizationKey, requirementKey, version])
  @@index([organizationKey, scopeType, status])
  @@map("compliance_requirements")
}

model ComplianceRecord {
  id              String                @id @default(cuid())
  organizationKey String                @default("MUV")
  requirementId   String
  requirement     ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  targetType      String
  targetId        String
  status          String                @default("PENDING") // PENDING | COMPLIANT | NON_COMPLIANT | WAIVED
  evidenceRefs    Json                  @default("[]")
  validFrom       DateTime?
  expiresAt       DateTime?
  reviewedById    String?
  reviewedBy      User?                 @relation("ComplianceRecordReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  notes           String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([organizationKey, requirementId])
  @@index([organizationKey, targetType, targetId])
  @@index([organizationKey, status])
  @@map("compliance_records")
}

model InstOpportunityProduct {
  id            String          @id @default(cuid())
  opportunityId String
  opportunity   InstOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation("InstOpportunityProducts", fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int?
  notes         String?

  @@unique([opportunityId, productId])
  @@map("inst_opportunity_products")
}

enum InstVisitOutcome {
  POSITIVE
  NEUTRAL
  NEGATIVE
  NO_DECISION_MAKER
  RESCHEDULED
}

model InstVisit {
