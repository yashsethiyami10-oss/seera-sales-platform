// ============================================================================
// SEERA MANUFACTURING OS — Material/UOM/Location foundation, immutable
// material ledger, BOM/SOP/Packaging-BOM versioning, Production Planning/MRP,
// Production Orders/Batches, QC, GRN, Stock Transfers/Adjustments/Counts,
// Wastage/Deviation, Batch Costing. Finished-goods output posts into the
// EXISTING SeeraInventoryMovement ledger (partyType COMPANY, newly added
// above) rather than a second finished-goods truth. Raw/packaging/WIP
// materials get their OWN ledger (SeeraManufacturingMovement) because they
// are a genuinely different physical domain Sales V1 never modeled at all.
// Reuses SeeraApprovalItem (generic queue) and SeeraChartOfAccount/journal
// posting (Finance OS) rather than duplicating either.
// ============================================================================

enum ManufacturingMaterialType {
  RAW_MATERIAL
  PACKAGING_MATERIAL
  SEMI_FINISHED
  FINISHED_GOODS
  CONSUMABLE
  SCRAP
}

enum ManufacturingUnit {
  KG
  GRAM
  LITRE
  ML
  PCS
  ROLL
  BOX
  BAG
  CARTON
  DRUM
  CAN
  METER
  OTHER
}

enum ManufacturingLocationType {
  RAW_STORE
  PACKAGING_STORE
  PRODUCTION_FLOOR
  WIP_AREA
  QC_HOLD
  FINISHED_STORE
  REJECT_SCRAP
  OTHER
}

enum ManufacturingMovementType {
  PURCHASE_RECEIPT
  OPENING_STOCK
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_ISSUE
  PRODUCTION_CONSUMPTION
  PRODUCTION_RETURN
  QC_HOLD
  QC_RELEASE
  REJECT
  SCRAP
  WASTAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_COUNT_CORRECTION
  SUPPLIER_RETURN
}

enum ManufacturingMovementDirection {
  IN
  OUT
  RESERVE
  RELEASE
}

enum BomStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum PackLevel {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum ProductionPlanPeriod {
  DAY
  WEEK
  CUSTOM
}

enum ProductionPlanStatus {
  DRAFT
  APPROVED
  PARTIALLY_EXECUTED
  COMPLETED
  CANCELLED
}

enum ProductionOrderStatus {
  DRAFT
  APPROVED
  READY
  IN_PROGRESS
  AWAITING_QC
  COMPLETED
  CANCELLED
}

enum ProductionBatchStatus {
  IN_PROGRESS
  AWAITING_QC
  COMPLETED
  CANCELLED
}

enum BatchQcOverallStatus {
  PENDING
  PASSED
  FAILED
  HOLD
  RELEASED
}

enum MaterialEventKind {
  ISSUE
  RETURN
  CONSUMPTION
}

enum WastageType {
  PROCESS_LOSS
  RAW_MATERIAL_WASTAGE
  PACKAGING_WASTAGE
  SPILLAGE
  DAMAGED_PACK
  QC_SAMPLE
  SCRAP
  OTHER
}

enum DeviationType {
  MATERIAL
  PROCESS
  OUTPUT
  PACKAGING
  QC
  OTHER
}

enum DeviationStatus {
  OPEN
  REVIEWED
  CLOSED
}

enum GrnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  REVIEWED
  APPROVED
  CLOSED
}

enum StockAdjustmentDirection {
  INCREASE
  DECREASE
}

enum ManufacturingApprovalCategory {
  BOM_ACTIVATION
  SOP_ACTIVATION
  LARGE_STOCK_ADJUSTMENT
  MATERIAL_SUBSTITUTION
  PRODUCTION_DEVIATION
  QC_OVERRIDE
  STOCK_COUNT_VARIANCE
  REWORK
}

enum CostConfidence {
  RELIABLE
  PARTIAL
  UNAVAILABLE
}

model SeeraManufacturingMaterial {
  id                String                    @id @default(cuid())
  code              String                    @unique
  name              String
  type              ManufacturingMaterialType
  category          String?
  baseUnit          ManufacturingUnit
  purchaseUnit      ManufacturingUnit?
  issueUnit         ManufacturingUnit?
  // Material-specific conversion (spec §6: "1 drum != universally fixed
  // kilograms") — purchaseUnit/issueUnit quantities × this factor = baseUnit
  // canonical quantity for THIS material only, never assumed globally.
  conversionFactor  Decimal                   @default(1) @db.Decimal(14, 6)
  // Current weighted-average cost per baseUnit — updated only from a real
  // captured GRN receipt cost (see SeeraGrnLine.unitCost), never from selling
  // price (spec §46). Null until the first costed receipt exists.
  unitCost          Decimal?                  @db.Decimal(14, 4)
  preferredVendorId String?
  hsn               String?
  taxRate           Decimal?                  @db.Decimal(7, 4)
  reorderLevel      Decimal?                  @db.Decimal(14, 3)
  minStock          Decimal?                  @db.Decimal(14, 3)
  maxStock          Decimal?                  @db.Decimal(14, 3)
  leadTimeDays      Int?
  defaultLocationId String?
  lotTracked        Boolean                   @default(true)
  expiryTracked     Boolean                   @default(false)
  qcRequired        Boolean                   @default(false)
  isActive          Boolean                   @default(true)
  notes             String?
  createdById       String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([type, isActive])
  @@map("seera_mfg_materials")
}

model SeeraManufacturingLocation {
  id       String                    @id @default(cuid())
  code     String                    @unique
  name     String
  type     ManufacturingLocationType
  isActive Boolean                   @default(true)
