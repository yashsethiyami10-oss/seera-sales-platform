  @@index([opportunityId])
  @@map("inst_visits")
}

model InstSurvey {
  id                      String    @id @default(cuid())
  visitId                 String    @unique
  visit                   InstVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  institutionType         String?
  businessType            String?
  floors                  Int?
  rooms                   Int?
  beds                    Int?
  washrooms               Int?
  kitchens                Int?
  hasLobby                Boolean   @default(false)
  parkingSpaces           Int?
  totalBuiltUpAreaSqft    Decimal?  @db.Decimal(10, 2)
  cleaningAreaSqft        Decimal?  @db.Decimal(10, 2)
  outdoorAreaSqft         Decimal?  @db.Decimal(10, 2)
  workingHours            String?
  shifts                  Int?
  housekeepingStaff       Int?
  laundryStaff            Int?
  cleaningStaff           Int?
  currentFloorCleaner     String?
  currentDetergent        String?
  currentGlassCleaner     String?
  currentToiletCleaner    String?
  currentHandWash         String?
  currentDishwash         String?
  currentOtherChemicals   String?   @db.Text
  currentVendor           String?
  cleaningFrequency       String?
  laundryCapacity         String?
  monthlyConsumptionKnown Boolean   @default(false)
  monthlyConsumptionNotes String?   @db.Text
  additionalNotes         String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  consumptionEstimate InstConsumptionEstimate?

  @@map("inst_surveys")
