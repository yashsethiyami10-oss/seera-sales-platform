  journalId       String?   @unique
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines       FinanceDebitNoteLine[]
  allocations FinanceDebitNoteAllocation[]

  @@unique([organizationKey, debitNoteNumber])
  @@index([organizationKey, vendorAccountId, status])
  @@map("finance_debit_notes")
}

model FinanceDebitNoteLine {
  id              String   @id @default(cuid())
  organizationKey String
  debitNoteId     String
  lineNumber      Int
  description     String
  quantity        Decimal? @db.Decimal(12, 3)
  unitPrice       Decimal? @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  lineAmount      Decimal  @db.Decimal(18, 2)
  accountId       String
  createdAt       DateTime @default(now())

  debitNote FinanceDebitNote @relation(fields: [debitNoteId], references: [id])

  @@unique([organizationKey, debitNoteId, lineNumber])
