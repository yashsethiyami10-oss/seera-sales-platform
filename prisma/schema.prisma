  estimates                   Json
  potentialMonthlyOpportunity Decimal        @default(0) @db.Decimal(15, 2)
  potentialAnnualOpportunity  Decimal        @default(0) @db.Decimal(15, 2)
  suggestedTrialQuantity      Json?
  suggestedFirstOrder         Json?
  insights                    Json
  confidence                  InstConfidence @default(MEDIUM)
  generatedAt                 DateTime       @default(now())

  @@map("inst_consumption_estimates")
}

enum InstSampleTrialStatus {
