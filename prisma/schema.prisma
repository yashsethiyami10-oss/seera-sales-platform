// ============================================================================
// MUV — Prisma Schema
// PostgreSQL. Money fields are stored as Int (whole rupees) — MUV's storefront
// never shows paise, so this avoids Decimal/float rounding concerns entirely.
// If paise-level precision is ever needed, switch these to Int (paise) instead
// and divide by 100 at the presentation layer — do not use Float for money.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth — User is the identity/auth record. NextAuth's adapter models
// (Account, Session, VerificationToken) are required as-is for the Prisma
// adapter to work; do not rename their fields.
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               Role      @default(CUSTOMER)
  salesRoleId        String?
  territoryId        String?
  reportingManagerId String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Milestone 2 (Customer & Master Data Foundation) — Employee Master.
  // Deliberately additive to the existing User record rather than a new
  // parallel "Employee" table: an internal employee already *is* a User
  // (role STAFF/ADMIN) with a SalesRole, a Territory, and a reporting
  // hierarchy (reportingManagerId/directReports, both already above) —
  // "Status" reuses the existing `active` field. Only Department and
  // Designation were genuinely missing.
  departmentId       String?
  designation        String?

  accounts                             Account[]
  sessions                             Session[]
  customer                             Customer?
  notes                                CustomerNote[]                      @relation("NoteAuthor")
  stockChanges                         StockHistory[]                      @relation("StockChangeAuthor")
  blogPosts                            BlogPost[]
  mediaAssets                          MediaAsset[]
  knowledgeVersions                    KnowledgeVersion[]                  @relation("KnowledgeVersionAuthor")
  canonicalSourceDocumentsIngested     CanonicalSourceDocument[]           @relation("SourceDocumentIngestor")
  sourceProvenanceExtracted            SourceProvenance[]                  @relation("SourceProvenanceExtractor")
  knowledgeConflictsResolved           KnowledgeConflict[]                 @relation("KnowledgeConflictResolver")
  approvalAuthoritiesHeld              ApprovalAuthority[]                 @relation("ApprovalAuthorityPrincipal")
  approvalAuthoritiesDelegated         ApprovalAuthority[]                 @relation("ApprovalAuthorityDelegator")
  approvalAuthoritiesRevoked           ApprovalAuthority[]                 @relation("ApprovalAuthorityRevoker")
  complianceRequirementsCreated        ComplianceRequirement[]             @relation("ComplianceRequirementCreatedBy")
  complianceRecordsReviewed            ComplianceRecord[]                  @relation("ComplianceRecordReviewedBy")
  knowledgeChangeProposalsProposed     KnowledgeChangeProposal[]           @relation("KnowledgeChangeProposalProposer")
  knowledgeChangeProposalsReviewed     KnowledgeChangeProposal[]           @relation("KnowledgeChangeProposalReviewer")
  recallEventsReported                 RecallEvent[]                       @relation("RecallEventReporter")
  categoryIntelligenceVersions         CategoryIntelligenceVersion[]       @relation("CategoryIntelligenceVersionAuthor")
  productVariantIntelligenceVersions   ProductVariantIntelligenceVersion[] @relation("ProductVariantIntelligenceVersionAuthor")
  productIntelligenceVersions          ProductIntelligenceVersion[]        @relation("ProductIntelligenceVersionAuthor")
  problemIntelligenceVersionsAuthored  ProblemIntelligenceVersion[]        @relation("ProblemVersionAuthor")
  problemIntelligenceVersionsReviewed  ProblemIntelligenceVersion[]        @relation("ProblemVersionReviewer")
  problemIntelligenceVersionsPublished ProblemIntelligenceVersion[]        @relation("ProblemVersionPublisher")
  problemEvidenceSourcesReviewed       ProblemEvidenceSource[]             @relation("ProblemEvidenceReviewer")
  careIntelligenceVersionsAuthored     CareIntelligenceVersion[]           @relation("CareVersionAuthor")
  careIntelligenceVersionsReviewed     CareIntelligenceVersion[]           @relation("CareVersionReviewer")
  careIntelligenceVersionsPublished    CareIntelligenceVersion[]           @relation("CareVersionPublisher")
  careEvidenceSourcesReviewed          CareEvidenceSource[]                @relation("CareEvidenceReviewer")
  salesRole                            SalesRole?                          @relation(fields: [salesRoleId], references: [id], onDelete: SetNull)
  territory                            Territory?                          @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  department                           Department?                         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportingManager                     User?                               @relation("SalesReportingHierarchy", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports                        User[]                              @relation("SalesReportingHierarchy")
  auditLogs                            SalesAuditLog[]
  ownedCustomers                       Customer[]                          @relation("CustomerSalesOwner")
  ownedInquiries                       SalesInquiry[]                      @relation("InquiryOwner")
  submittedInquiries                   SalesInquiry[]                      @relation("InquirySubmitter")
  escalatedQueues                      AssignmentQueue[]                   @relation("QueueEscalationUser")
  salesTimelineEvents                  SalesTimelineEvent[]                @relation("TimelineActor")
  salesFollowUps                       SalesFollowUpTask[]                 @relation("FollowUpOwner")
  uploadedInquiryAttachments           InquiryAttachment[]                 @relation("InquiryAttachmentUploader")
  salesNotes                           SalesInquiryNote[]
  customerClassificationChanges        CustomerClassificationHistory[]     @relation("ClassificationActor")
  ownedOpportunities                   Opportunity[]                       @relation("OpportunityOwner")
  opportunityStageChanges              OpportunityStageHistory[]           @relation("OpportunityStageActor")
  performedOpportunityActivities       OpportunityActivity[]               @relation("OpportunityActivityPerformer")
  assignedOpportunityActivities        OpportunityActivity[]               @relation("OpportunityActivityAssignee")
  ownedOpportunityTasks                OpportunityTask[]                   @relation("OpportunityTaskOwner")
  assignedOpportunityTasks             OpportunityTask[]                   @relation("OpportunityTaskAssigner")
  opportunityNotes                     OpportunityNote[]
  uploadedOpportunityAttachments       OpportunityAttachment[]             @relation("OpportunityAttachmentUploader")
  ownedQuotations                      Quotation[]                         @relation("QuotationOwner")
  createdQuotationVersions             QuotationVersion[]                  @relation("QuotationVersionCreator")
  quotationStatusChanges               QuotationStatusHistory[]            @relation("QuotationStatusActor")
  requestedQuotationApprovals          QuotationApprovalRequest[]          @relation("QuotationApprovalRequester")
  assignedQuotationApprovals           QuotationApprovalRequest[]          @relation("QuotationApprovalApprover")
  quotationApprovalDecisions           QuotationApprovalDecision[]
  generatedQuotationDocuments          QuotationDocument[]                 @relation("QuotationDocumentGenerator")
  quotationViews                       QuotationView[]
  ownedCommerceOrders                  Order[]                             @relation("CommerceOrderOwner")
  commerceOrderStatusChanges           CommerceOrderStatusHistory[]
  stockLedgerEntries                   StockLedgerEntry[]
  pickingAssignments                   PickingOperation[]
  packingAssignments                   PackingOperation[]
  commerceDispatches                   CommerceDispatch[]
  collectedCommercePayments            CommercePayment[]
  generatedCommerceDocuments           CommerceDocument[]
  InventoryDamageRecord                InventoryDamageRecord[]
  // Milestone 3 — Institutional Sales OS (isolated pipeline, see schema note
  // near the Inst* models). One block, grouped here rather than interleaved
  // above, since every one of these is new in this milestone.
  instLeadsAssigned                    InstLead[]                          @relation("InstLeadAssignee")
  instLeadsCreated                     InstLead[]                          @relation("InstLeadCreator")
  instOpportunitiesOwned               InstOpportunity[]                   @relation("InstOpportunityOwner")
  instVisits                           InstVisit[]                         @relation("InstVisitOfficer")
  instSamplesIssued                    InstSample[]                        @relation("InstSampleOfficer")
  instFollowUpsAssigned                InstFollowUp[]                      @relation("InstFollowUpAssignee")
  instQuotationsOwned                  InstQuotation[]                     @relation("InstQuotationOwner")
  instQuotationVersionsCreated         InstQuotationVersion[]              @relation("InstQuotationVersionCreator")
  instQuotationVersionsApproved        InstQuotationVersion[]              @relation("InstQuotationVersionApprover")
  // Milestone 4.1 — Quotation Acceptance Workflow Enhancement.
  instQuotationVersionsAccepted        InstQuotationVersion[]              @relation("InstQuotationVersionAccepter")
  instTasksAssigned                    InstTask[]                          @relation("InstTaskAssignee")
  instTasksAssignedBy                  InstTask[]                          @relation("InstTaskAssigner")
  instDailyPlans                       InstDailyPlan[]                     @relation("InstDailyPlanOfficer")
  instExpensesSubmitted                InstExpense[]                       @relation("InstExpenseOfficer")
  instExpensesApproved                 InstExpense[]                       @relation("InstExpenseApprover")
  instRoutes                           InstRoute[]                         @relation("InstRouteOfficer")
  instTargets                          InstTarget[]                        @relation("InstTargetUser")
  instNotes                            InstNote[]                          @relation("InstNoteAuthor")
  instAttachmentsUploaded              InstAttachment[]                    @relation("InstAttachmentUploader")
  // Milestone 4 — Order Management OS.
  businessOrdersOwned                  BusinessOrder[]                     @relation("BusinessOrderOwner")
  // Milestone 6 — Dispatch & Delivery.
  businessOrdersDispatched             BusinessOrder[]                     @relation("BusinessOrderDispatchedBy")
  businessOrdersDelivered              BusinessOrder[]                     @relation("BusinessOrderDeliveredBy")

  @@index([salesRoleId])
  @@index([territoryId])
  @@index([reportingManagerId])
  @@index([departmentId])
  @@map("users")
}

// Milestone 2 — Employee Master's Department. Deliberately minimal (name,
// code, active) — the same shape as every other simple master in this
// milestone (Unit, Brand, PaymentTerms, InstitutionCategory).
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees User[]

  @@map("departments")
}

// Sales Organization Architecture v1. Roles are data, never an enum, so
// reserved enterprise roles can be activated without a schema change.
model SalesRole {
  id              String                @id @default(cuid())
  name            String                @unique
  description     String?
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  users           User[]
  permissions     SalesRolePermission[]
  defaultChannels SalesChannel[]        @relation("ChannelDefaultOwnerRole")

  @@map("sales_roles")
}

model SalesPermission {
  id            String                @id @default(cuid())
  permissionKey String                @unique
  displayName   String
  module        String
  description   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  roles         SalesRolePermission[]

  @@index([module])
  @@map("sales_permissions")
}

model SalesRolePermission {
  roleId       String
  permissionId String
  role         SalesRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   SalesPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("sales_role_permissions")
}

enum TerritoryLevel {
  STATE
  CITY
  AREA
  TERRITORY
}

model Territory {
  id                String            @id @default(cuid())
  name              String
  code              String            @unique
  parentTerritoryId String?
  // Milestone 2 — "Territory Master: State, City, Area, Territory" is
  // modeled as levels of this same, already-existing hierarchical model
  // (parentTerritoryId/children below) rather than four new separate
  // tables — State→City→Area→Territory is exactly the parent/child chain
  // this model already expresses. Existing rows default to TERRITORY
  // (the leaf level this model was originally used for), which is
  // backward compatible with every current caller.
  level             TerritoryLevel    @default(TERRITORY)
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  parent            Territory?        @relation("TerritoryHierarchy", fields: [parentTerritoryId], references: [id], onDelete: Restrict)
  children          Territory[]       @relation("TerritoryHierarchy")
  users             User[]
  customers         Customer[]
  inquiries         SalesInquiry[]
  queues            AssignmentQueue[]
  opportunities     Opportunity[]
  opportunityTasks  OpportunityTask[]
  quotations        Quotation[]
  commerceOrders    Order[]
  // Milestone 3 — Institutional Sales OS (isolated pipeline, see schema note above).
  instLeads         InstLead[]
  instOpportunities InstOpportunity[]
  // Milestone 4 — Order Management OS.
  businessOrders    BusinessOrder[]

  @@index([parentTerritoryId])
  @@index([level])
  @@map("territories")
}

// Append-only by application policy. Database migration adds triggers that
// reject UPDATE and DELETE, protecting history even outside this application.
model SalesAuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module        String
  action        String
  recordType    String?
  recordId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([module, action, createdAt])
  @@map("sales_audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Customer — profile/business data layered on top of a CUSTOMER-role User.
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String   @unique
  name           String
  phone          String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses              Address[]
  orders                 Order[]
  wishlist               Wishlist[]
  reviews                Review[]
  notes                  CustomerNote[]
  recentlyViewed         RecentlyViewedItem[]
  searchQueries          SearchQuery[]
  returnRequests         ReturnRequest[]
  customerTypeId         String?
  primaryChannelId       String?
  businessName           String?
  contactPerson          String?
  alternatePhone         String?
  gstNumber              String?
  billingAddress         String?                         @db.Text
  shippingAddress        String?                         @db.Text
  city                   String?
  state                  String?
  country                String                          @default("India")
  assignedOwnerId        String?
  assignedTerritoryId    String?
  lifecycleStage         String                          @default("PROSPECT")
  crmStatus              String                          @default("ACTIVE")
  // Milestone 2 (Customer & Master Data Foundation) — additive fields only;
  // every field above this comment is unchanged. `active` is the soft-delete
  // flag ("Global Features: Soft Delete") — distinct from `crmStatus`, which
  // already covers "Customer Status" as a business-state string and is left
  // as-is. `customerCode` is nullable/unique rather than required so it can
  // be backfilled for pre-existing rows without a blocking migration; new
  // customers always get one (see `generateCustomerCode` in actions/customers.ts).
  active                 Boolean                         @default(true)
  customerCode           String?                         @unique
  whatsappNumber         String?
  landlineNumber         String?
  website                String?
  industry               String?
  customerSince          DateTime?
  pan                    String?
  creditLimit            Decimal?                        @db.Decimal(12, 2)
  area                   String?
  pinCode                String?
  paymentTermsId         String?
  institutionCategoryId  String?
  customerType           CustomerType?                   @relation(fields: [customerTypeId], references: [id], onDelete: SetNull)
  primaryChannel         SalesChannel?                   @relation(fields: [primaryChannelId], references: [id], onDelete: SetNull)
  assignedOwner          User?                           @relation("CustomerSalesOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  assignedTerritory      Territory?                      @relation(fields: [assignedTerritoryId], references: [id], onDelete: SetNull)
  paymentTerms           PaymentTerms?                   @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)
  institutionCategory    InstitutionCategory?            @relation(fields: [institutionCategoryId], references: [id], onDelete: SetNull)
  contactPersons         CustomerContactPerson[]
  documents              CustomerDocument[]
  salesInquiries         SalesInquiry[]
  salesTimeline          SalesTimelineEvent[]
  salesFollowUps         SalesFollowUpTask[]
  classificationHistory  CustomerClassificationHistory[]
  opportunities          Opportunity[]
  opportunityActivities  OpportunityActivity[]
  opportunityTasks       OpportunityTask[]
  quotations             Quotation[]
  experienceSessions     ExperienceSession[]
  FinanceCustomerAccount FinanceCustomerAccount?
  // Milestone 3 — Institutional Sales OS (isolated pipeline, see schema note above).
  instLeads              InstLead[]
  instOpportunities      InstOpportunity[]
  instSamples            InstSample[]
  instFollowUps          InstFollowUp[]
  instQuotations         InstQuotation[]
  InstVisit              InstVisit[]
  // Milestone 4 — Order Management OS.
  businessOrders         BusinessOrder[]

  @@index([phone])
  @@index([gstNumber])
  @@index([businessName])
  @@index([customerTypeId])
  @@index([primaryChannelId])
  @@index([assignedOwnerId])
  @@index([assignedTerritoryId])
  @@index([active])
  @@index([paymentTermsId])
  @@index([institutionCategoryId])
  @@map("customers")
}

// Milestone 2 — Customer Profile "Contact Persons" (multiple per customer).
model CustomerContactPerson {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name            String
  designation     String?
  mobile          String?
  whatsapp        String?
  email           String?
  isDecisionMaker Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@map("customer_contact_persons")
}

// Milestone 2 — Customer Profile "Documents". Links to the existing,
// already-built MediaAsset (Cloudinary-backed) rather than a new upload
// mechanism — see actions/media.ts's getUploadUrl/confirmUpload, reused
// unchanged.
model CustomerDocument {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  label        String
  createdAt    DateTime   @default(now())

  @@index([customerId])
  @@map("customer_documents")
}

// Milestone 2 — "Institution Categories... must be Admin Configurable."
// A real, database-backed master (not a hardcoded enum/list) so an admin
// can add a new category without a code or schema change — exactly the
// requirement. Default categories are seeded (prisma/seed.ts), not
// hardcoded into application logic.
model InstitutionCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]

  @@index([active, sortOrder])
  @@map("institution_categories")
}

// Milestone 2 — Common Masters. Same minimal shape as Department above and
// Unit/PaymentTerms below: this milestone's simple masters are deliberately
// uniform (name/code/active) rather than each inventing its own shape,
// since a future generic admin UI can manage all of them with one
// component instead of one per entity.
model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

// Milestone 2 — Common Masters "Brands". Deliberately a *new, standalone*
// master, not a migration of the existing `Product.brand` string field:
// `Product.brand` is live, currently-selling storefront data (defaults to
// "MUV" on every row today) — converting it to a relation would require a
// data migration touching every live product, which is exactly the kind of
// change this milestone's own rule ("do not revisit previously approved
// architecture unless a critical issue prevents implementation") argues
// against doing as a side effect. This table exists so Supplier/Customer-
// adjacent admin screens have a real Brand list to reference; wiring
// `Product.brand` to it is a separate, explicit future decision.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

// Milestone 2 — Common Masters "Payment Terms". No formal payment-terms
// master existed anywhere in this schema before this — every existing
// reference (`EnterpriseVendor.paymentTerms`, Finance's `paymentTermsDays`)
// is a free-text string or a bare integer, not a shared, admin-managed list.
model PaymentTerms {
  id          String     @id @default(cuid())
  name        String     @unique
  days        Int
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]

  @@map("payment_terms")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("customer_notes")
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders Order[]

  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id                          String                       @id @default(cuid())
  name                        String                       @unique
  slug                        String                       @unique
  description                 String?
  imageUrl                    String?
  comingSoon                  Boolean                      @default(false)
  sortOrder                   Int                          @default(0)
  products                    Product[]
  problemExclusionRules       ProblemExclusionRule[]
  applicableToProblemVersions ProblemIntelligenceVersion[]
  categoryIntelligence        CategoryIntelligence?

  @@map("categories")
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  brand            String        @default("Muv")
  shortDescription String        @db.Text
  fullDescription  String?       @db.Text
  weight           String?
  fragranceNotes   String?
  ingredients      String?       @db.Text
  directions       String?       @db.Text
  benefits         String?       @db.Text
  safety           String?       @db.Text
  hsnCode          String        @default("3401") // HSN code — see lib/tax
  gstRate          Int           @default(18) // percent
  metaTitle        String?
  metaDescription  String?
  images           String[]      @default([])
  videoUrl         String? // deprecated, kept for backward compatibility
  videoUrls        String[]      @default([])
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  bestSellerRank   Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants                    ProductVariant[]
  reviews                     Review[]
  wishlist                    Wishlist[]
  recentlyViewedBy            RecentlyViewedItem[]
  knowledgeItems              KnowledgeItem[]
  productIntelligence         ProductIntelligence?
  content                     ProductContent?
  problemProductRelationships ProblemProductRelationship[]
  problemExclusionRules       ProblemExclusionRule[]
  problemUsageGuidance        ProblemUsageGuidance[]
  careIntelligenceVersions    CareIntelligenceVersion[]
  quotationLineItems          QuotationLineItem[]
  // Milestone 3 — Institutional Sales OS (isolated pipeline, see schema note
  // near the Inst* models); this reuses the real catalog, no shadow product list.
  instOpportunityProducts     InstOpportunityProduct[]     @relation("InstOpportunityProducts")
  instSamples                 InstSample[]                 @relation("InstSampleProducts")
  instQuotationLineItems      InstQuotationLineItem[]      @relation("InstQuotationLineItemProducts")
  // Milestone 4 — Order Management OS.
  businessOrderItems          BusinessOrderItem[]          @relation("BusinessOrderItemProducts")

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Production Customer Content Layer — Founder Decision (Product Content
// Architecture, FINAL). The ONLY source website product pages read
// customer-facing copy from. Deliberately separate from `docs/knowledge-
// factory/` (which remains the internal source of truth — manufacturing
// formulas, batch quantities, raw-material percentages, internal process
// notes, QC/costing data never appear here) and separate from Product's own
// legacy text columns (kept for backward compatibility / admin tooling, no
// longer read by customer-facing pages). Every field is optional — a null
// field means "no approved content yet," and the corresponding storefront
// section renders nothing rather than placeholder text.
model ProductContent {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  shortDescription  String?  @db.Text
  longDescription   String?  @db.Text
  keyBenefits       String?  @db.Text // one bullet per line, same convention as the legacy Product.benefits field
  howToUse          String?  @db.Text
  careInstructions  String?  @db.Text
  storage           String?  @db.Text
  safetyInformation String?  @db.Text
  productHighlights String?  @db.Text
  faq               Json? // [{ "question": string, "answer": string, "source": string }]
  seoTitle          String?
  seoDescription    String?
  searchKeywords    String[] @default([])

  // Founder-workflow / audit trail — not rendered, read by admin tooling and
  // the population script only.
  approvalStatus   String @default("PENDING") // PENDING | APPROVED
  sourceProvenance Json? // { "shortDescription": "docs/knowledge-factory/products/.../02_Product_Description.md#KO-LD-DESC-001", ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_content")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
