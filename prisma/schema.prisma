// ---------------------------------------------------------------------------
// MUV AI — Experience Platform (Module 8). Converts Module 7's
// ExecutionPackage into structured, channel-neutral customer experiences.
//
// Two new models — the smallest footprint that makes this module's two
// explicitly *stateful* requirements ("Conversation session management",
// "Feedback capture") real, mirroring Module 5's own "one new table"
// precedent. Every other Module 8 responsibility (orchestration, safe
// rendering, channel adaptation, handoff/analytics/review preparation)
// stays computation-only — no new table for any of those.
// ---------------------------------------------------------------------------

enum ExperienceSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

model ExperienceSession {
  id             String                  @id @default(cuid())
  // Plain string, not an enum — "Website channel adaptation" is the only
  // channel this module implements, but future channels (per Module 7's
  // own "later integrations" list — WhatsApp, Email) should never need a
  // migration just to be recorded here. Same extensibility reasoning as
  // KnowledgeSourceType (Module 5) and category/problemCategory (Modules 3-4).
  channel        String                  @default("WEBSITE")
  customerId     String?
  status         ExperienceSessionStatus @default(ACTIVE)
  // MemoryItem[] (lib/intelligence/types.ts, Module 6) accumulated turn by
  // turn — this is the real persistence Module 6's Memory Resolver
  // explicitly deferred ("Do NOT implement long-term storage... a future
  // Module 7/8 owns real memory persistence"). A single JSON column, not a
  // normalized child table — "prefer computation over storage" still
  // applies to how it's stored, even though session continuity itself is
  // this module's explicit job.
  memoryItems    Json                    @default("[]")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  lastActivityAt DateTime                @default(now())
  expiresAt      DateTime?

  // ---- Website Wave 2 (internal beta) — additive, nullable, backward
  // -compatible fields for a customer-initiated human-support request on
  // this session. Added here rather than a new table: a handoff request is
  // a property of the session it belongs to, not an independent entity with
  // its own lifecycle, and this keeps the migration to 4 nullable columns
  // instead of a new model + relation. Populated by actions/muv-ai-beta.ts
  // (new, Wave-2-owned code) — never by any frozen Module 8 file, which
  // remains unmodified.
  handoffRequestedAt  DateTime?
  handoffContactEmail String?
  handoffContactPhone String?
  handoffMessage      String?   @db.Text

  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  feedback ExperienceFeedback[]

  @@index([customerId])
  @@index([status, lastActivityAt])
  @@map("experience_sessions")
}

model ExperienceFeedback {
  id            String   @id @default(cuid())
  sessionId     String
  rating        Int?
  comment       String?  @db.Text
  createdAt     DateTime @default(now())
  // Website Wave 2 — additive, nullable. References the specific assistant
  // turn this feedback is about, using the turn's own `generatedAt`
  // timestamp (already returned to the client by Module 8's frozen
  // `WebsiteExperienceView` — no frozen file needed a change to produce
  // this value). Nullable so existing rows from before this column existed
  // stay valid; new rows from actions/muv-ai-beta.ts always populate it.
  // The unique constraint is the server-enforced duplicate-submission
  // guard; a second submission for the same turn updates (upsert) rather
  // than creating a second row — "append-only where practical, correction
  // only where the data model safely supports it."
  turnReference String?

  session ExperienceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, turnReference])
  @@index([sessionId])
  @@map("experience_feedback")
}

/// Website Wave 2 — operational analytics foundation. One new, minimal,
/// append-only table, the same "smallest necessary footprint" precedent
/// Module 5's KnowledgeRetrievalLog already established for telemetry.
/// `sessionId` is a plain indexed string, not a foreign-key relation —
/// deliberately, so an event write can never fail (and therefore never
/// block the chat) because of a relation constraint; "keep analytics
/// failure non-blocking" is enforced structurally, not just by a try/catch
/// at the call site.
model MuvAiEvent {
  id           String   @id @default(cuid())
  type         String
  sessionId    String?
  properties   Json     @default("{}")
  eventVersion Int      @default(1)
  occurredAt   DateTime @default(now())

  @@index([type, occurredAt])
  @@index([sessionId])
  @@map("muv_ai_events")
}

