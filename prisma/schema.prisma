model InventoryReservation {
  id              String         @id @default(cuid())
  // Milestone 5 — Operations Foundation. Nullable: a reservation now belongs
  // to EITHER the general-commerce Order OR a BusinessOrder, never neither,
  // in practice never both (each creation path only ever sets its own
  // field) — enforced at the application level, not a DB CHECK constraint,
  // a deliberate minimal-footprint choice given how cleanly separated the
  // two creation paths already are. This is the one reused, already-generic
  // table this milestone extends, per the Milestone 5 architecture's
  // domain-generic/commerce-specific classification — InventoryReservation
  // has no invoicing/payment concept in it at all.
  orderId         String?
  businessOrderId String?
  warehouseId     String
  variantId       String
  quantity        Int
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now())
  releasedAt      DateTime?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  businessOrder   BusinessOrder? @relation(fields: [businessOrderId], references: [id], onDelete: Restrict)
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Two independent nullable-unique constraints (not one shared one) —
  // Postgres treats multiple NULLs as distinct under each, so a row with
  // orderId set doesn't collide with businessOrderId-owned rows and vice
  // versa; each creation path still gets "one reservation per variant"
  // enforced within its own scope.
  @@unique([orderId, variantId])
  @@unique([businessOrderId, variantId])
  @@index([warehouseId, variantId, status])
  @@map("inventory_reservations")
}

