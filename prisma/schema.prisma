generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DISABLED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum RoleAssignmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum FileClassification {
  GENERAL
  FINANCIAL
  LEGAL
  IDENTITY
  FIELD_EVIDENCE
}

enum FileScanStatus {
  PENDING
  CLEAN
  REJECTED
  FAILED
}

enum FileLifecycleStatus {
  ACTIVE
  QUARANTINED
  REVOKED
  DELETED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  normalizedEmail        String               @unique
  phone                  String?              @unique
  name                   String?
  passwordHash           String?
  status                 UserStatus           @default(ACTIVE)
  authorizationVersion   Int                  @default(1)
  emailVerified          DateTime?
  phoneVerified          DateTime?
  lastLoginAt            DateTime?
  suspendedAt            DateTime?
  suspensionReason       String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  accounts               Account[]
  sessions               Session[]
  roleAssignments        UserRoleAssignment[] @relation("RoleAssignmentSubject")
  roleAssignmentsMade    UserRoleAssignment[] @relation("RoleAssignmentGrantor")
  roleAssignmentsRevoked UserRoleAssignment[] @relation("RoleAssignmentRevoker")
  auditEvents            AuditLog[]           @relation("AuditActor")
  uploadedFiles          StoredFile[]         @relation("FileUploader")
  notifications          Notification[]       @relation("NotificationRecipient")

  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id                   String    @id @default(cuid())
  sessionToken         String    @unique
  userId               String
  expires              DateTime
  revokedAt            DateTime?
  revocationReason     String?
  authorizationVersion Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expires])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([expires])
  @@map("auth_verification_tokens")
}

model Role {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  description String?
  status      RoleStatus           @default(ACTIVE)
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  grantedById  String?
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id               String               @id @default(cuid())
  userId           String
  roleId           String
  status           RoleAssignmentStatus @default(ACTIVE)
  effectiveFrom    DateTime             @default(now())
  effectiveTo      DateTime?
  assignedById     String?
  assignedAt       DateTime             @default(now())
  assignmentReason String?
  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?
  user             User                 @relation("RoleAssignmentSubject", fields: [userId], references: [id], onDelete: Restrict)
  role             Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?                @relation("RoleAssignmentGrantor", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy        User?                @relation("RoleAssignmentRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, status, effectiveFrom, effectiveTo])
  @@index([roleId, status])
  @@map("user_role_assignments")
}

model AuditLog {
  id          String       @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  outcome     AuditOutcome @default(SUCCESS)
  reason      String?
  beforeState Json?
  afterState  Json?
  details     Json?
  requestId   String?
  sessionId   String?
  ipHash      String?
  userAgent   String?
  occurredAt  DateTime     @default(now())
  actor       User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

model AppSetting {
  id            String           @id @default(cuid())
  key           String           @unique
  category      String
  valueType     SettingValueType
  value         Json
  isSensitive   Boolean          @default(false)
  version       Int              @default(1)
  active        Boolean          @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  updatedById   String?
  changeReason  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([category, active])
  @@map("app_settings")
}

model FeatureFlag {
  id            String    @id @default(cuid())
  key           String    @unique
  description   String?
  enabled       Boolean   @default(false)
  rules         Json?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  updatedById   String?
  changeReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, effectiveFrom, effectiveTo])
  @@map("feature_flags")
}

model IdempotencyKey {
  id             String            @id @default(cuid())
  scope          String
  key            String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  lockedUntil    DateTime?
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scope, key])
  @@index([status, lockedUntil])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  publishedAt   DateTime?
  lastErrorCode String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model StoredFile {
  id              String              @id @default(cuid())
  provider        String
  storageKey      String              @unique
  originalName    String
  mimeType        String
  extension       String?
  sizeBytes       BigInt
  sha256          String
  classification  FileClassification  @default(GENERAL)
  scanStatus      FileScanStatus      @default(PENDING)
  lifecycleStatus FileLifecycleStatus @default(ACTIVE)
  entityType      String?
  entityId        String?
  uploadedById    String?
  retentionUntil  DateTime?
  revokedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  uploadedBy      User?               @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([uploadedById, createdAt])
  @@index([classification, lifecycleStatus])
  @@map("stored_files")
}

model Notification {
  id          String                 @id @default(cuid())
  recipientId String
  type        String
  title       String
  body        String
  priority    NotificationPriority   @default(NORMAL)
  status      NotificationStatus     @default(UNREAD)
  entityType  String?
  entityId    String?
  payload     Json?
  readAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime               @default(now())
  expiresAt   DateTime?
  recipient   User                   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  deliveries  NotificationDelivery[]

  @@index([recipientId, status, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationDelivery {
  id                 String                     @id @default(cuid())
  notificationId     String
  channel            NotificationChannel
  status             NotificationDeliveryStatus @default(PENDING)
  attempt            Int                        @default(1)
  provider           String?
  providerMessageId  String?
  recipientReference String?
  attemptedAt        DateTime?
  deliveredAt        DateTime?
  lastErrorCode      String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  notification       Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, attempt])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}
