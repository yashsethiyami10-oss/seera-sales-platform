// ---------------------------------------------------------------------------
// MUV AI Runtime Engineering — Stage 6C
//
// Additive only — no existing model above this point is touched. None of
// the three models below is wired into any live customer-facing path; all
// three are consumed only by lib/runtime/* and actions/runtime.ts, both
// gated behind the RUNTIME_PIPELINE_ENABLED feature flag (default false,
// see lib/production/feature-flags.ts). This is a structural guarantee, not
// just a policy one: no code path outside lib/runtime/actions/runtime.ts
// references these models, so they cannot affect existing behaviour.
// ---------------------------------------------------------------------------

enum FounderDecisionStatus {
  APPROVED
  SUPERSEDED
  PENDING_REVIEW
}

/// Resolves CF-01 (Founder Decision Integration) from ENGINEERING_TEST_REPORT.md
/// — a live, queryable, append-only Authority Ledger, structurally identical to
/// the real docs/knowledge-factory/FOUNDER_RULES.md pattern (dated, scoped,
/// never deleted, only superseded). Seeded with FD-AIC-001 through FD-AIC-004
/// (Founder Execution Protocol v1.0, Stage 6C authorization) — see prisma/seed.ts.
model FounderDecisionRegistryEntry {
  id           String                @id @default(cuid())
  decisionId   String                @unique // e.g. "FD-AIC-001"
  title        String
  category     String // e.g. "RESPONSE_ASSEMBLY" | "CONFLICT_ARBITRATION" | "PRODUCTION_PROTECTION" | "PRIVACY"
  decisionText String                @db.Text
  scope        String                @db.Text
  status       FounderDecisionStatus @default(APPROVED)
  supersedesId String?
  approvedAt   DateTime
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([category])
  @@index([status])
  @@map("founder_decision_registry_entries")
}

/// Per-turn structured trace for the new runtime pipeline (RUNTIME_PIPELINE.md
/// §Auditability) — every stage's key output, in one row, so a completed turn
/// is fully reconstructible after the fact. Never read by the live
/// orchestrateExperience() path.
model RuntimeAuditLog {
  id                 String   @id @default(cuid())
  sessionId          String?
  turnId             String
  intentPrimary      String?
  retrievalMethodMix Json?
  conflictStatus     String?
  confidenceScore    Int?
  safetyVerdict      String?
  stageTrace         Json
  createdAt          DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@map("runtime_audit_logs")
}

enum LearningCandidateType {
  UNANSWERED_QUESTION
  RETRIEVAL_FAILURE
  REPEATED_CONFLICT
  WEAK_RESPONSE
  KCR_CANDIDATE
  FOUNDER_DECISION_CANDIDATE
}

enum LearningCandidateStatus {
  OPEN
  REVIEWED_APPROVED
  REVIEWED_REJECTED
  DEFERRED
}

/// Module 10 (Learning Runtime)'s only durable output. Per RUNTIME_MODULES.md's
/// Founder Constraint: this model is never written to by anything that also
/// writes to a Knowledge Factory file (Factories are markdown/JSON on disk,
/// not database-backed, so that boundary is structurally impossible to
/// violate from this table alone) — every row here requires a human to read
/// `reviewedById`/`reviewNotes` and act externally; nothing in lib/runtime
/// promotes a row to REVIEWED_APPROVED automatically.
model LearningCandidate {
  id           String                  @id @default(cuid())
  type         LearningCandidateType
  summary      String                  @db.Text
  evidence     Json
  status       LearningCandidateStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?                 @db.Text
  createdAt    DateTime                @default(now())

  @@index([type, status])
  @@map("learning_candidates")
}
