  @@map("seera_mfg_locations")
}

model SeeraManufacturingLot {
  id             String    @id @default(cuid())
  lotNumber      String    @unique
  materialId     String
  supplierLotRef String?
  vendorId       String?
  receiptDate    DateTime  @default(now())
  manufactureDate DateTime?
  expiryDate     DateTime?
  qcStatus       BatchQcOverallStatus @default(PENDING)
  sourceGrnId    String?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([materialId, expiryDate])
  @@map("seera_mfg_lots")
}

// The immutable material ledger (spec §8) — every raw/packaging/WIP stock
// fact is a row here; nothing is ever an editable single number. Mirrors the
// existing SeeraInventoryMovement pattern (direction IN/OUT/RESERVE/RELEASE,
// idempotencyKey-unique, sourceType/sourceId pointer) deliberately, since
// that pattern is already proven correct in this codebase — this is a
// parallel ledger for a genuinely different physical domain, not a
// duplicate of the same one.
model SeeraManufacturingMovement {
  id               String                         @id @default(cuid())
  materialId       String
  lotId            String?
  movementType     ManufacturingMovementType
  direction        ManufacturingMovementDirection
  quantity         Decimal                        @db.Decimal(14, 3)
  unit             ManufacturingUnit
  canonicalQuantity Decimal                       @db.Decimal(14, 3)
  fromLocationId   String?
  toLocationId     String?
  sourceType       String
  sourceId         String
  actorId          String
  reason           String
  approvalId       String?
  idempotencyKey   String                         @unique
  occurredAt       DateTime                       @default(now())
  createdAt        DateTime                       @default(now())

  @@index([materialId, lotId, direction, occurredAt])
  @@index([sourceType, sourceId])
  @@index([toLocationId, direction])
  @@map("seera_mfg_movements")
}

model SeeraBom {
