// --- Fixed Assets / Depreciation ---

model FinanceAssetCategory {
  id                               String   @id @default(cuid())
  organizationKey                  String
  code                             String
  name                             String
  defaultDepreciationMethod        String   @default("STRAIGHT_LINE")
  defaultUsefulLifeMonths          Int
  assetAccountId                   String
  depreciationExpenseAccountId     String
  accumulatedDepreciationAccountId String
  status                           String   @default("ACTIVE")
  createdById                      String
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  assets FinanceFixedAsset[]

  @@unique([organizationKey, code])
  @@map("finance_asset_categories")
}

model FinanceFixedAsset {
  id                      String    @id @default(cuid())
  organizationKey         String
  assetCode               String
  name                    String
  categoryId              String
  acquisitionDate         DateTime
  capitalizationDate      DateTime?
  cost                    Decimal   @db.Decimal(18, 2)
  salvageValue            Decimal   @default(0) @db.Decimal(18, 2)
  usefulLifeMonths        Int
  depreciationMethod      String    @default("STRAIGHT_LINE")
  locationText            String?
  custodianId             String?
  costCenterId            String?
  status                  String    @default("DRAFT")
  accumulatedDepreciation Decimal   @default(0) @db.Decimal(18, 2)
  netBookValue            Decimal   @db.Decimal(18, 2)
