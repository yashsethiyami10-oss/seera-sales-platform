enum SalesOrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_UNDER_REVIEW
  CONFIRMED
  SUBMITTED
  ACKNOWLEDGED
  PARTIAL_ACCEPTED
  ACCEPTED
