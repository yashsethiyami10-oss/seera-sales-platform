  territory       NetworkTerritory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  partner         NetworkPartner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([organizationKey, territoryId, partnerId, assignmentType, effectiveFrom], map: "network_territory_assignment_effective_key")
  @@index([organizationKey, partnerId, status, effectiveFrom])
  @@map("network_territory_assignments")
}

model NetworkAgreement {
  id                String         @id @default(cuid())
  organizationKey   String
  agreementKey      String
  agreementNumber   String
  partnerId         String
  agreementType     String
  version           Int
  status            String         @default("DRAFT")
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  terms             Json           @default("{}")
  documentRefs      Json           @default("[]")
  preparedById      String
  approvedById      String?
  approvedAt        DateTime?
  executedAt        DateTime?
  terminatedAt      DateTime?
  supersededById    String?
  previousVersionId String?
  correctionReason  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  partner           NetworkPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([organizationKey, agreementKey, version])
  @@unique([organizationKey, agreementNumber])
  @@index([organizationKey, partnerId, status, effectiveFrom])
