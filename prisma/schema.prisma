// Issue / Return / Consumption unified — spec §21/§22/§20 are the same
// physical-event shape (material moving between production and store, or
// theoretical-vs-actual being recorded) with a different `kind`, not three
// independent truths.
model SeeraProductionMaterialEvent {
  id                   String             @id @default(cuid())
  kind                 MaterialEventKind
  productionOrderId    String
  batchId              String?
  materialId           String
  lotId                String?
  theoreticalQuantity  Decimal?           @db.Decimal(14, 4)
  quantity             Decimal            @db.Decimal(14, 4)
  unit                 ManufacturingUnit
  canonicalQuantity    Decimal            @db.Decimal(14, 4)
  fromLocationId       String?
  toLocationId         String?
  reason               String?
  actorId              String
  movementId           String?
  idempotencyKey       String             @unique
  createdAt            DateTime           @default(now())

  @@index([productionOrderId, kind])
  @@index([batchId, kind])
  @@index([materialId])
  @@map("seera_mfg_material_events")
}

// Batch traceability forward-link: Batch -> Company finished-goods stock.
// The actual stock IN posts to the existing SeeraInventoryMovement ledger
// (partyType COMPANY) — this row is the Manufacturing-side record of that
// link (lot number = batch number) plus the QC gate before it becomes
// available (spec §24: "must become available... only after appropriate QC status").
model SeeraFinishedGoodsReceipt {
  id                String               @id @default(cuid())
  batchId           String               @unique
  productSkuId      String
  quantity          Decimal              @db.Decimal(14, 3)
  unit              ManufacturingUnit
  locationId        String
  qcStatus          BatchQcOverallStatus @default(PENDING)
  inventoryMovementId String?
  idempotencyKey    String               @unique
  createdAt         DateTime             @default(now())

  @@map("seera_mfg_finished_goods_receipts")
}

