// ---------------------------------------------------------------------------
// MUV AI — Knowledge Foundation (MUV Intelligence Platform, Module 1)
//
// Permission layer (KnowledgeLayer: PUBLIC/INTERNAL/CONFIDENTIAL) and content
// taxonomy (KnowledgeFileType, incl. PIF/PrIF/CIF) per the MUV AI Master
// Implementation Prompt — this terminology does not appear in the on-disk
// Knowledge Library/AI Sutra source files (confirmed by direct search of
// both); the founder explicitly directed this prompt be treated as the
// authoritative source for it regardless. Recorded here, not silently
// assumed, per this project's own rule on Knowledge Book conflicts.
//
// Versioning model: two tables, not one mutable row. KnowledgeItem is the
// stable, addressable "thing" (slug/title/layer/fileType — classification
// metadata, safe to edit in place). KnowledgeVersion holds the actual
// content text and is append-only — a row, once created, is never updated
// in place; "publishing an edit" always means creating a new version, never
// mutating an existing (especially a PUBLISHED) one. This is what "never
// overwrite published knowledge" and "maintain audit history" cash out to
// structurally: the ordered set of KnowledgeVersion rows for an item *is*
// its audit history, matching this schema's own existing idiom
// (StockHistory/ShipmentEvent/CustomerNote — an append-only table as the
// audit trail, not a generic separate log).
//
// Deliberately no "currentVersionId" pointer field on KnowledgeItem: the
// current version is derived (highest versionNumber with
// status=PUBLISHED), not cached in a second field that would need to be
// kept in sync — one source of truth, not two.
// ---------------------------------------------------------------------------

enum KnowledgeLayer {
  PUBLIC // Layer A — customer-visible
  INTERNAL // Layer B — reasoning only, never directly exposed
  CONFIDENTIAL // Layer C — never exposed; future explicitly-authorized internal systems only
}

enum KnowledgeFileType {
  KNOWLEDGE_LIBRARY // general reference drawn from the Library/Sutra
  PRODUCT_INTELLIGENCE // PIF
  PROBLEM_INTELLIGENCE // PrIF
  CARE_INTELLIGENCE // CIF
  POLICY
  SOP
  FAQ
}

enum KnowledgeVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KnowledgeItem {
  id        String            @id @default(cuid())
  slug      String            @unique
  title     String
  fileType  KnowledgeFileType
  layer     KnowledgeLayer
  // Optional — natural for PRODUCT_INTELLIGENCE (a PIF is about one real
  // product), meaningless for most other file types, so nullable rather
  // than required.
  productId String?
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  versions                 KnowledgeVersion[]
  careIntelligenceVersions CareIntelligenceVersion[]

  @@index([fileType])
  @@index([layer])
  @@index([productId])
  @@map("knowledge_items")
}

// MUV AI Engineering Execution — Sprint 1. A raw-SQL partial unique index
// (migration 20260801200000, see prisma/migrations/) now enforces "at most
// one PUBLISHED version per item" at the database level — closing the gap
// this model's own file-level comment already disclosed (previously
// discipline-only, enforced by wrapping publish in one $transaction, never
// by Postgres). Not expressible in Prisma's schema DSL; the constraint
// exists only in the migration, not declared here.
model KnowledgeVersion {
  id                        String                 @id @default(cuid())
  itemId                    String
  item                      KnowledgeItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  versionNumber             Int
  content                   String                 @db.Text
  status                    KnowledgeVersionStatus @default(DRAFT)
  changeNote                String?                @db.Text
  authorId                  String?
  author                    User?                  @relation("KnowledgeVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt               DateTime?
  // Sprint 8 (Learning System) — added consistently across all six
  // Foundation Version tables at once, deliberately deferred from Sprint 5.
  // reviewDueAt: when a PUBLISHED version should be re-reviewed regardless
  // of any reported issue (staleness, not a complaint). containsHistoricalPricing:
  // flags a version whose content references pricing that can go stale
  // without the version itself being edited. requiresRevalidation: set by
  // lib/knowledge-factory/learning-service.ts when a RecallEvent reports
  // INCORRECT/FLAGGED — surfaces the version for staff re-review without
  // unpublishing it outright.
  reviewDueAt               DateTime?
  containsHistoricalPricing Boolean                @default(false)
  requiresRevalidation      Boolean                @default(false)
  createdAt                 DateTime               @default(now())

  @@unique([itemId, versionNumber])
  @@index([itemId, status])
  @@map("knowledge_versions")
}

// ---------------------------------------------------------------------------
// MUV AI — Product Intelligence Foundation (PIF Engine, Module 2)
//
// A structured, versioned, per-product intelligence record for AI
// retrieval — deliberately NOT the product catalog itself. Product/
// ProductVariant (above) remain the single source of truth for catalog
// data; ProductIntelligence only ever *references* a Product by id, never
// duplicates its name/price/description/etc.
//
// Reuses KnowledgeLayer (Module 1) directly for the Layer A/B/C permission
// model instead of redefining it — "exactly as defined in Module 1," at
// the same whole-item granularity Module 1 uses: a Public-layer PIF's
// entire `sections` payload is what a future public retrieval path may
// return; an Internal/Confidential PIF is not exposed to it at all. No
// finer-grained per-section permission was requested, so none was invented
// — this module does not implement any retrieval path at all, public or
// otherwise, per its own explicit "Do NOT implement AI retrieval" scope.
//
// A separate ProductIntelligenceStatus enum (DRAFT/REVIEW/PUBLISHED/
// ARCHIVED) is used instead of reusing Module 1's KnowledgeVersionStatus —
// Module 1 has no Review stage, and this module's spec requires one; adding
// REVIEW to Module 1's enum would mean modifying Module 1, out of scope
// per this module's own "Do not redesign Module 1" constraint.
//
// Versioning/editing model, distinct from Module 1's (documented here since
// it's a deliberate, reasoned difference, not an inconsistency): Module 1
// treats every version as immutable from creation. Module 2's spec instead
// describes a Draft -> Review -> Published -> Archived *pipeline* for one
// evolving piece of work, and separately lists "Update Product
// Intelligence" alongside "Duplicate Draft" as distinct required actions —
// read together, a version's `sections` content is mutable in place while
// its status is DRAFT or REVIEW (normal editorial iteration), and becomes
// permanently immutable the moment it becomes PUBLISHED (enforced in
// actions/product-intelligence.ts, not by Postgres). Correcting already-
// published content is only ever done by duplicating it into a *new*
// DRAFT version — the published row itself is never reopened for editing.
// ---------------------------------------------------------------------------

enum ProductIntelligenceStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model ProductIntelligence {
  id        String         @id @default(cuid())
  productId String         @unique
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  layer     KnowledgeLayer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions                    ProductIntelligenceVersion[]
  problemProductRelationships ProblemProductRelationship[]
  problemUsageGuidance        ProblemUsageGuidance[]
  careIntelligenceVersions    CareIntelligenceVersion[]

  @@index([layer])
  @@map("product_intelligence")
}

// Sprint 1 — same partial unique index treatment as KnowledgeVersion above.
model ProductIntelligenceVersion {
  id                        String                    @id @default(cuid())
  productIntelligenceId     String
  productIntelligence       ProductIntelligence       @relation(fields: [productIntelligenceId], references: [id], onDelete: Cascade)
  versionNumber             Int
  status                    ProductIntelligenceStatus @default(DRAFT)
  // Structured PIF sections (Product Identity, Purpose, Customer Problems
  // Solved, Features, Benefits, Ingredients/Composition, Usage
  // Instructions, Safety Information, Do/Don't, FAQs, Objection Handling,
  // Comparison Notes, Cross-Sell Suggestions, Storage Instructions, Shelf
  // Life) stored as JSON rather than one column per section, specifically
  // so a new section can be added later without a schema migration. Shape
  // is enforced at the application layer by
  // lib/validations/product-intelligence.ts's Zod schema (which itself
  // uses .catchall() to accept future unrecognized section keys without
  // rejecting the payload), not by Postgres. "Version Metadata" — the 15th
  // section named in the spec — is deliberately NOT a JSON key here: it's
  // this row's own real columns below (versionNumber, status, authorId,
  // changeNote, timestamps); duplicating that into the JSON blob too would
  // be redundant, out-of-sync-prone data.
  sections                  Json
  changeNote                String?                   @db.Text
  authorId                  String?
  author                    User?                     @relation("ProductIntelligenceVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submittedForReviewAt      DateTime?
  publishedAt               DateTime?
  archivedAt                DateTime?
  // Sprint 8 (Learning System) — see the identical comment on KnowledgeVersion.
  reviewDueAt               DateTime?
  containsHistoricalPricing Boolean                   @default(false)
  requiresRevalidation      Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@unique([productIntelligenceId, versionNumber])
  @@index([productIntelligenceId, status])
  @@map("product_intelligence_versions")
}

// ---------------------------------------------------------------------------
// MUV AI Engineering Execution — Sprint 5: Knowledge Modeling
// (implements MUV Intelligence Factory V4 §2 — Category -> Product ->
// Variant inheritance — frozen spec, not redesigned). Extends Module 2's
// exact Item/Version pattern to two new scopes flanking ProductIntelligence:
// CategoryIntelligence (broader) and ProductVariantIntelligence (narrower,
// override-only). Reuses ProductIntelligenceStatus and KnowledgeLayer
// unchanged — no third near-identical status enum.
//
// Deliberately does NOT yet add reviewDueAt/containsHistoricalPricing/
// requiresRevalidation (V4's own Gap Resolution Register lists these as an
// extension to ALL SIX Foundation Version tables) — that lands in Sprint 8
// (Learning System) so all six tables gain them together, consistently,
// rather than two now and four later.
//
// CategoryIntelligence.sections is constrained by policy, not by Postgres,
// to a closed set of category-eligible keys (see
// lib/knowledge-factory/inheritance-service.ts's CATEGORY_ELIGIBLE_SECTIONS)
// — general safety/storage class only, never usage/ingredients/pricing,
// per V4 §2.3's explicit "must never silently inherit" rule for those.
// ---------------------------------------------------------------------------

model CategoryIntelligence {
  id         String         @id @default(cuid())
  categoryId String         @unique
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  layer      KnowledgeLayer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CategoryIntelligenceVersion[]

  @@index([layer])
  @@map("category_intelligence")
}

// Partial unique index (see migration 20260801240000) enforces "at most one
// PUBLISHED version per item" — added at creation time, not retrofitted
// later, unlike the four original tables in Sprint 1 which had to close
// this gap after the fact. Not expressible in Prisma's schema DSL.
model CategoryIntelligenceVersion {
  id                        String                    @id @default(cuid())
  categoryIntelligenceId    String
  categoryIntelligence      CategoryIntelligence      @relation(fields: [categoryIntelligenceId], references: [id], onDelete: Cascade)
  versionNumber             Int
  status                    ProductIntelligenceStatus @default(DRAFT)
  sections                  Json
  changeNote                String?                   @db.Text
  authorId                  String?
  author                    User?                     @relation("CategoryIntelligenceVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submittedForReviewAt      DateTime?
  publishedAt               DateTime?
  archivedAt                DateTime?
  // Sprint 8 (Learning System) — see the identical comment on KnowledgeVersion.
  reviewDueAt               DateTime?
  containsHistoricalPricing Boolean                   @default(false)
  requiresRevalidation      Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@unique([categoryIntelligenceId, versionNumber])
  @@index([categoryIntelligenceId, status])
  @@map("category_intelligence_versions")
}

model ProductVariantIntelligence {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  layer     KnowledgeLayer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ProductVariantIntelligenceVersion[]

  @@index([layer])
  @@map("product_variant_intelligence")
}

// Same partial unique index treatment as CategoryIntelligenceVersion above.
// sections here is override-only — a variant-level section REPLACES the
// corresponding product-level one for that section when resolved, it never
// merges with it (V4 §2.3's inheritance resolution rule, step 1). Sparse by
// design: most variants need zero PUBLISHED rows here.
model ProductVariantIntelligenceVersion {
  id                           String                     @id @default(cuid())
  productVariantIntelligenceId String
  productVariantIntelligence   ProductVariantIntelligence @relation(fields: [productVariantIntelligenceId], references: [id], onDelete: Cascade)
  versionNumber                Int
  status                       ProductIntelligenceStatus  @default(DRAFT)
  sections                     Json
  changeNote                   String?                    @db.Text
  authorId                     String?
  author                       User?                      @relation("ProductVariantIntelligenceVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submittedForReviewAt         DateTime?
  publishedAt                  DateTime?
  archivedAt                   DateTime?
  // Sprint 8 (Learning System) — see the identical comment on KnowledgeVersion.
  reviewDueAt                  DateTime?
  containsHistoricalPricing    Boolean                    @default(false)
  requiresRevalidation         Boolean                    @default(false)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  @@unique([productVariantIntelligenceId, versionNumber])
  @@index([productVariantIntelligenceId, status])
  @@map("product_variant_intelligence_versions")
}

// ---------------------------------------------------------------------------
// MUV AI — Problem Intelligence Foundation (PrIF Engine, Module 3)
//
// Problem-first, not product-first: this models what a customer is
// experiencing (symptoms, causes, questions to ask, mistakes people make,
// what outcome is realistic, when to escalate instead of recommend) as its
// own structured intelligence, separate from both the Product catalog and
// PIF (Module 2, per-product intelligence). "Do not merge PrIF with PIF" —
// a PrIF *references* Product and ProductIntelligence rows where relevant
// (ProblemProductRelationship, ProblemExclusionRule, ProblemUsageGuidance),
// it never duplicates their fields.
//
// Versioning shape mirrors Module 2, not Module 1: ProblemIntelligence is
// the stable, addressable item (slug + Layer A/B/C, reusing Module 1's
// KnowledgeLayer enum directly rather than redefining it).
// ProblemIntelligenceVersion is one evolving unit of work, editable in
// place while DRAFT/REVIEW, permanently locked the moment it's PUBLISHED
// (enforced in actions/problem-intelligence.ts, not by Postgres).
//
// Every structured child table below (symptoms, causes, diagnostic
// questions, mistakes, product relationships, exclusion rules, usage
// guidance, expected outcomes, prevention guidance, safety rules, evidence
// sources) hangs off ProblemIntelligenceVersion via versionId — NOT off
// ProblemIntelligence directly. This is the load-bearing design decision
// of this whole module: it's what makes "duplicate/restore a version" mean
// "deep-copy every child row into new rows for a new version," and it's
// what makes "a published version is immutable" actually true for the
// structured sections too, not just a top-level JSON blob like Module 2 —
// per this module's own instruction to avoid one uncontrolled JSON object
// and keep core relationships strongly modeled instead.
//
// "Reviewed by" / "Approved by" (Version Metadata, spec section 14): this
// lifecycle has no distinct reviewer-then-separately-publisher hand-off —
// the REVIEW -> PUBLISHED transition is one admin-gated action — so
// `reviewedById`/`reviewedAt` and `publishedById`/`publishedAt` are set
// together, by the same actor, at that one transition today. Kept as two
// separate column-pairs (not one) specifically so a future lifecycle
// change (e.g. inserting a distinct APPROVED status) can make them diverge
// without a schema change — a reasonable engineering assumption, not
// something the spec stated outright, documented here per this module's
// own "record reasonable assumptions" rule.
//
// Safety modeling is deliberately two-tiered: ProblemIntelligenceVersion
// carries a single safety *snapshot* (overall riskLevel, escalation flag/
// reason, emergency warning text, disclaimers) since spec section 12 reads
// as singular per-version flags, not a list — while ProblemSafetyRule is a
// separate, repeatable table for distinct conditional rules (e.g. "if X,
// escalate" and "if Y, escalate" as two different rules within the same
// problem), matching the spec's own suggested model list. Neither
// replaces the other.
//
// No DB-level partial-unique constraint enforces "only one PUBLISHED
// version at a time" (Prisma's schema DSL has no partial-index syntax, and
// this project uses `db push`, not raw migrations) — the same limitation
// Module 1 and Module 2 already carry, guarded by wrapping the
// archive-previous + publish-new pair in one $transaction, not by a
// database constraint. Documented, not silently assumed airtight.
// ---------------------------------------------------------------------------

enum ProblemIntelligenceStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// Shared across symptom severity, mistake severity, exclusion-rule
// severity, and safety risk level — same LOW/MODERATE/HIGH/CRITICAL
// vocabulary the spec itself suggests for "Suggested risk levels," reused
// rather than defining three near-identical enums.
enum ProblemRiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

// Deliberately has no "certain"/"confirmed" value — per the Core Principle
// ("must never force a product recommendation where information does not
// justify one") and "Never guarantee unsupported outcomes," nothing in
// this module should ever be representable as certain.
enum ProblemConfidenceLevel {
  LOW
  MODERATE
  HIGH
}

enum ProblemQuestionAnswerType {
  TEXT
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
  NUMBER
  DATE
  SCALE
  IMAGE_REQUIRED
}

enum ProblemQuestionAudience {
  CUSTOMER_FACING
  INTERNAL_ONLY
}

enum ProblemProductSuitability {
  PRIMARY
  ALTERNATIVE
  CONDITIONAL
  SUPPORTING
  NOT_RECOMMENDED
}

model ProblemIntelligence {
  id    String         @id @default(cuid())
  slug  String         @unique
  layer KnowledgeLayer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions                 ProblemIntelligenceVersion[]
  careIntelligenceVersions CareIntelligenceVersion[]

  @@index([layer])
  @@map("problem_intelligence")
}

// Sprint 1 — same partial unique index treatment as KnowledgeVersion above.
model ProblemIntelligenceVersion {
  id                    String                    @id @default(cuid())
  problemIntelligenceId String
  problemIntelligence   ProblemIntelligence       @relation(fields: [problemIntelligenceId], references: [id], onDelete: Cascade)
  versionNumber         Int
  status                ProblemIntelligenceStatus @default(DRAFT)

  // --- 1. Problem Identity (partial — slug/layer live on the parent item) ---
  publicTitle          String
  internalTitle        String?
  summary              String?    @db.Text
  problemCategory      String? // free-text problem taxonomy label (e.g. "Odor"),
  // deliberately not an enum — no fixed vocabulary
  // was specified, and inventing one wasn't asked for.
  applicableCategories Category[] // real MUV Category rows, never duplicated
  tags                 String[]
  synonyms             String[]
  searchTerms          String[]

  // --- 2. Customer Description ---
  // Flexible customer-phrasing examples, per "the schema must support
  // flexible content" — a plain string list, no fixed examples hardcoded.
  customerDescriptions String[]

  // --- 12. Safety and Escalation (version-level snapshot; see also
  // ProblemSafetyRule below for repeatable conditional rules) ---
  riskLevel                ProblemRiskLevel @default(LOW)
  escalationRequired       Boolean          @default(false)
  escalationReason         String?          @db.Text
  emergencyWarningText     String?          @db.Text
  humanReviewRequired      Boolean          @default(false)
  prohibitedRecommendation Boolean          @default(false)
  requiredDisclaimers      String[]
  internalHandlingNotes    String?          @db.Text

  // --- Version metadata (14) ---
  changeNote                String?   @db.Text
  authorId                  String?
  author                    User?     @relation("ProblemVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedById              String?
  reviewedBy                User?     @relation("ProblemVersionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  publishedById             String?
  publishedBy               User?     @relation("ProblemVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  submittedForReviewAt      DateTime?
  publishedAt               DateTime?
  archivedAt                DateTime?
  // Sprint 8 (Learning System) — see the identical comment on KnowledgeVersion.
  reviewDueAt               DateTime?
  containsHistoricalPricing Boolean   @default(false)
  requiresRevalidation      Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  symptoms             ProblemSymptom[]
  causes               ProblemCause[]
  diagnosticQuestions  ProblemDiagnosticQuestion[]
  commonMistakes       ProblemCommonMistake[]
  productRelationships ProblemProductRelationship[]
  exclusionRules       ProblemExclusionRule[]
  usageGuidance        ProblemUsageGuidance[]
  expectedOutcomes     ProblemExpectedOutcome[]
  preventionGuidance   ProblemPreventionGuidance[]
  safetyRules          ProblemSafetyRule[]
  evidenceSources      ProblemEvidenceSource[]

  @@unique([problemIntelligenceId, versionNumber])
  @@index([problemIntelligenceId, status])
  @@map("problem_intelligence_versions")
}

// --- 3. Symptoms ---
model ProblemSymptom {
  id                         String                     @id @default(cuid())
  versionId                  String
  version                    ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title                      String
  description                String?                    @db.Text
  severity                   ProblemRiskLevel           @default(LOW)
  isRequired                 Boolean                    @default(false) // required vs. optional relevance
  displayOrder               Int                        @default(0)
  customerLanguageVariations String[]
  internalNotes              String?                    @db.Text

  @@index([versionId])
  @@map("problem_symptoms")
}

// --- 4. Possible Causes ---
// "Must not present possible causes as confirmed facts" — enforced by
// `likelihood` always being one of ProblemConfidenceLevel's non-certain
// values, never a boolean "this is the cause."
model ProblemCause {
  id                 String                     @id @default(cuid())
  versionId          String
  version            ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title              String
  explanation        String?                    @db.Text
  likelihood         ProblemConfidenceLevel     @default(LOW)
  evidenceIndicators String[]
  internalNotes      String?                    @db.Text
  displayOrder       Int                        @default(0)

  // "Questions needed to confirm" — a real relation to this same version's
  // diagnostic questions, not a duplicated free-text copy of question text.
  confirmingQuestions ProblemDiagnosticQuestion[] @relation("CauseConfirmingQuestions")

  @@index([versionId])
  @@map("problem_causes")
}

// --- 5. Diagnostic Questions ---
// The structured foundation only — no conversational engine here, per the
// module's own explicit exclusion.
model ProblemDiagnosticQuestion {
  id                 String                     @id @default(cuid())
  versionId          String
  version            ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questionText       String                     @db.Text
  purpose            String?                    @db.Text
  answerType         ProblemQuestionAnswerType
  isRequired         Boolean                    @default(false)
  // Variable-shape by design (a NUMBER question's validation rules look
  // nothing like a SCALE question's) — JSON is justified here per the
  // module's own "typed JSON only where justified" allowance, unlike the
  // core relationships elsewhere in this schema.
  validationRules    Json?
  followUpConditions Json?
  displayOrder       Int                        @default(0)
  audience           ProblemQuestionAudience    @default(INTERNAL_ONLY)

  options        ProblemQuestionOption[]
  confirmsCauses ProblemCause[]          @relation("CauseConfirmingQuestions")

  @@index([versionId])
  @@map("problem_diagnostic_questions")
}

model ProblemQuestionOption {
  id           String                    @id @default(cuid())
  questionId   String
  question     ProblemDiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label        String
  value        String
  displayOrder Int                       @default(0)

  @@index([questionId])
  @@map("problem_question_options")
}

// --- 6. Common Mistakes ---
model ProblemCommonMistake {
  id           String                     @id @default(cuid())
  versionId    String
  version      ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title        String
  explanation  String?                    @db.Text
  consequence  String?                    @db.Text
  correction   String?                    @db.Text
  severity     ProblemRiskLevel           @default(LOW)
  displayOrder Int                        @default(0)

  @@index([versionId])
  @@map("problem_common_mistakes")
}

// --- 7. Recommended Product Relationships ---
// "Do not create final recommendation decisions in this module" — this
// records *candidate* suitability signals for a future Decision
// Intelligence module to weigh, not a decision itself.
model ProblemProductRelationship {
  id                        String                     @id @default(cuid())
  versionId                 String
  version                   ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  productId                 String
  product                   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productIntelligenceId     String?
  productIntelligence       ProductIntelligence?       @relation(fields: [productIntelligenceId], references: [id], onDelete: SetNull)
  suitability               ProblemProductSuitability
  reason                    String?                    @db.Text
  conditionsRequired        String[]
  usageNotes                String?                    @db.Text
  priority                  Int                        @default(0)
  confidence                ProblemConfidenceLevel     @default(LOW)
  customerFacingExplanation String?                    @db.Text
  internalRationale         String?                    @db.Text
  // Set only when this relationship was deliberately added despite an
  // existing ExclusionRule for the same product in this version — see
  // addProblemProductRelationship's conflict check in
  // actions/problem-intelligence.ts. Null in the normal, non-conflicting case.
  overrideJustification     String?                    @db.Text

  @@index([versionId])
  @@index([productId])
  @@map("problem_product_relationships")
}

// --- 8. Exclusion and Contraindication Rules ---
model ProblemExclusionRule {
  id                    String                     @id @default(cuid())
  versionId             String
  version               ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId            String?
  category              Category?                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reason                String                     @db.Text
  condition             String?                    @db.Text
  severity              ProblemRiskLevel           @default(MODERATE)
  customerFacingWarning String?                    @db.Text
  internalNotes         String?                    @db.Text
  escalationRequired    Boolean                    @default(false)

  @@index([versionId])
  @@index([productId])
  @@index([categoryId])
  @@map("problem_exclusion_rules")
}

// --- 9. Usage Guidance ---
// Problem-specific only — "Do not duplicate general product information
// already stored in PIF." A general "how to use MUV Shield" belongs in
// Module 2's ProductIntelligence; "how to use MUV Shield *for this
// specific problem*" belongs here.
model ProblemUsageGuidance {
  id                    String                     @id @default(cuid())
  versionId             String
  version               ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productIntelligenceId String?
  productIntelligence   ProductIntelligence?       @relation(fields: [productIntelligenceId], references: [id], onDelete: SetNull)
  stepTitle             String
  instructions          String                     @db.Text
  quantityOrDilution    String?
  frequency             String?
  duration              String?
  expectedTiming        String?
  safetyNote            String?                    @db.Text
  displayOrder          Int                        @default(0)

  @@index([versionId])
  @@map("problem_usage_guidance")
}

// --- 10. Expected Outcomes ---
model ProblemExpectedOutcome {
  id                    String                     @id @default(cuid())
  versionId             String
  version               ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  description           String                     @db.Text
  expectedTimeframe     String?
  conditions            String?                    @db.Text
  limitations           String?                    @db.Text
  confidenceLevel       ProblemConfidenceLevel     @default(LOW)
  customerFacingWording String?                    @db.Text
  internalEvidenceNotes String?                    @db.Text
  displayOrder          Int                        @default(0)

  @@index([versionId])
  @@map("problem_expected_outcomes")
}

// --- 11. Prevention Guidance ---
model ProblemPreventionGuidance {
  id                String                     @id @default(cuid())
  versionId         String
  version           ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title             String
  guidance          String                     @db.Text
  frequency         String?
  applicableContext String?
  displayOrder      Int                        @default(0)

  @@index([versionId])
  @@map("problem_prevention_guidance")
}

// --- 12b. Safety Rules (repeatable; see the version-level safety snapshot
// fields on ProblemIntelligenceVersion above for the singular overview) ---
model ProblemSafetyRule {
  id                 String                     @id @default(cuid())
  versionId          String
  version            ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title              String
  condition          String?                    @db.Text
  riskLevel          ProblemRiskLevel           @default(MODERATE)
  escalationRequired Boolean                    @default(false)
  disclaimerText     String?                    @db.Text
  internalNotes      String?                    @db.Text
  displayOrder       Int                        @default(0)

  @@index([versionId])
  @@map("problem_safety_rules")
}

// --- 13. Evidence and Source Metadata ---
// `internalOnly` defaults to true — sources/evidence are internal by
// default, matching "Do not expose confidential sources publicly," even
// for an otherwise Layer PUBLIC problem item.
model ProblemEvidenceSource {
  id                       String                     @id @default(cuid())
  versionId                String
  version                  ProblemIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceType               String // free text — no fixed vocabulary was specified
  sourceReference          String?                    @db.Text
  evidenceNotes            String?                    @db.Text
  reviewerId               String?
  reviewer                 User?                      @relation("ProblemEvidenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewDate               DateTime?
  confidenceClassification ProblemConfidenceLevel     @default(LOW)
  internalOnly             Boolean                    @default(true)

  @@index([versionId])
  @@map("problem_evidence_sources")
}

// ---------------------------------------------------------------------------
// MUV AI — Care Intelligence Foundation (CIF Engine, Module 4)
//
// The emotional/operational care layer: how MUV should handle a customer
// in a given situation — not product knowledge (PIF, Module 2), not
// problem knowledge (PrIF, Module 3). "This is NOT the CQ Engine. CQ
// decides how to respond. CIF stores the care knowledge that CQ and
// Decision Intelligence will use" — nothing in this module executes a
// decision or generates a response; it only stores structured workflows.
//
// Reuses KnowledgeLayer (Module 1) for Layer A/B/C, unchanged, and
// ProblemConfidenceLevel (Module 3) for CareEvidenceSource.confidence —
// same qualitative "never claim certainty" vocabulary, reused rather than
// redefined a third time. Neither Module 1 nor Module 3 was modified to
// enable this reuse.
//
// Item/version split, transition rules, and "published is immutable"
// enforcement mirror Modules 2/3 exactly — see lifecycle.md in this
// module's docs for the one real deviation (no separate
// submit-for-review action; see below).
//
// `category` (and `applicableCustomerSegments`) are free text, not enums —
// the spec is explicit that "new categories [must be supported] without
// schema redesign," and gives a long example list, not a closed one. Same
// reasoning Module 3 applied to `problemCategory`.
//
// Relationships are reference-only, never duplicating the referenced
// module's data: `relatedKnowledgeItems` alone covers "Policies, SOPs,
// Knowledge Foundation" from this module's own Relationships section,
// since Module 1's KnowledgeItem already models exactly those file types
// (POLICY/SOP/KNOWLEDGE_LIBRARY) — no new duplicate concept was created
// for them.
//
// DESIGN DEVIATION FROM MODULE 3, DELIBERATE AND DOCUMENTED: this module's
// own Server Actions list names exactly 10 actions — createCareIntelligence,
// updateCareIntelligence, publishCareIntelligence, archiveCareIntelligence,
// restoreCareIntelligence, duplicateCareIntelligence, getCareIntelligence,
// listCareIntelligence, getPublishedCareIntelligence, getCareVersionHistory
// — with no per-child-section "add" actions (unlike Module 3's nine
// addProblem*) and no separate createCareIntelligenceVersion or
// submitForReview action. Given that literal, much shorter list, the
// structured child tables below (CareRequiredInformation, CareAction,
// CareEvidenceSource) are populated as full nested arrays inside
// createCareIntelligence/updateCareIntelligence's single payload, not one
// row at a time — updateCareIntelligence replaces a DRAFT/REVIEW version's
// entire child-record set on each call (delete-and-recreate inside one
// transaction), never touching a PUBLISHED version's rows at all. DRAFT ->
// REVIEW is folded into updateCareIntelligence as an optional status field
// rather than getting its own action, for the same reason. See
// architecture.md for the full reasoning.
// ---------------------------------------------------------------------------

enum CareIntelligenceStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CarePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// What a customer case handled by this workflow can legitimately end in —
// a vocabulary this workflow declares as applicable, not a live case-
// tracking system (that belongs to a future module that actually executes
// workflows).
enum CareResolutionCondition {
  RESOLVED
  PENDING
  WAITING_CUSTOMER
  WAITING_TEAM
  ESCALATED
  CLOSED
  CANCELLED
}

model CareIntelligence {
  id        String         @id @default(cuid())
  slug      String         @unique
  layer     KnowledgeLayer
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  versions CareIntelligenceVersion[]

  @@index([layer])
  @@map("care_intelligence")
}

// Sprint 1 — same partial unique index treatment as KnowledgeVersion above.
model CareIntelligenceVersion {
  id                 String                 @id @default(cuid())
  careIntelligenceId String
  careIntelligence   CareIntelligence       @relation(fields: [careIntelligenceId], references: [id], onDelete: Cascade)
  versionNumber      Int
  status             CareIntelligenceStatus @default(DRAFT)

  // --- Identity ---
  title    String
  category String // free text, extensible per spec — see file-level note
  summary  String? @db.Text

  // --- Customer Situation --- ("do not hardcode examples")
  situationDescription String?  @db.Text
  situationTags        String[]

  // --- Care Objective ---
  careObjectives String[]

  // --- Human Escalation (singular snapshot, mirrors PrIF's safety
  // snapshot pattern from Module 3) ---
  escalationRequired      Boolean       @default(false)
  escalationReason        String?       @db.Text
  escalationTeam          String?
  escalationPriority      CarePriority?
  escalationSla           String?
  escalationInternalNotes String?       @db.Text

  // --- Customer Communication Guidance — "store guidance only, do not
  // generate responses"; never surfaced verbatim to a customer, only to
  // staff/future CQ Engine ---
  communicationTone   String?
  thingsToAvoid       String[]
  mandatoryStatements String[]
  optionalGuidance    String[]
  transparencyRules   String[]

  // --- Resolution Conditions ---
  applicableResolutionConditions CareResolutionCondition[]

  // --- Follow-up Guidance ---
  followUpGuidance  String? @db.Text
  maxWaitingPeriod  String?
  reminderInterval  String?
  closureConditions String? @db.Text

  // --- Institutional Sales Support — free text, same extensibility
  // reasoning as `category`; Hotels/Hospitals/Schools/... are examples,
  // not a closed list ---
  applicableCustomerSegments String[]

  // --- Relationships (reference only, never duplicated) ---
  relatedProducts            Product[]
  relatedProductIntelligence ProductIntelligence[]
  relatedProblemIntelligence ProblemIntelligence[]
  relatedKnowledgeItems      KnowledgeItem[] // covers Policies/SOPs/Knowledge Foundation

  // --- Version metadata ---
  changeNote                String?   @db.Text
  authorId                  String?
  author                    User?     @relation("CareVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedById              String?
  reviewedBy                User?     @relation("CareVersionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  publishedById             String?
  publishedBy               User?     @relation("CareVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  submittedForReviewAt      DateTime?
  publishedAt               DateTime?
  archivedAt                DateTime?
  // Sprint 8 (Learning System) — see the identical comment on KnowledgeVersion.
  reviewDueAt               DateTime?
  containsHistoricalPricing Boolean   @default(false)
  requiresRevalidation      Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  requiredInformation CareRequiredInformation[]
  careActions         CareAction[]
  evidenceSources     CareEvidenceSource[]

  @@unique([careIntelligenceId, versionNumber])
  @@index([careIntelligenceId, status])
  @@map("care_intelligence_versions")
}

// --- Required Information ---
model CareRequiredInformation {
  id           String                  @id @default(cuid())
  versionId    String
  version      CareIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  label        String
  description  String?                 @db.Text
  isRequired   Boolean                 @default(true)
  displayOrder Int                     @default(0)

  @@index([versionId])
  @@map("care_required_information")
}

// --- Care Actions (ordered) ---
model CareAction {
  id              String                  @id @default(cuid())
  versionId       String
  version         CareIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  stepNumber      Int                     @default(0)
  description     String                  @db.Text
  actor           String?
  preconditions   String?                 @db.Text
  expectedOutcome String?                 @db.Text
  failureHandling String?                 @db.Text

  @@index([versionId])
  @@map("care_actions")
}

// --- Evidence ---
model CareEvidenceSource {
  id            String                  @id @default(cuid())
  versionId     String
  version       CareIntelligenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  source        String                  @db.Text
  approved      Boolean                 @default(false)
  confidence    ProblemConfidenceLevel  @default(LOW) // reused from Module 3
  reviewerId    String?
  reviewer      User?                   @relation("CareEvidenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewDate    DateTime?
  internalNotes String?                 @db.Text

  @@index([versionId])
  @@map("care_evidence_sources")
}

// ---------------------------------------------------------------------------
// MUV AI — Knowledge Retrieval Core (KRC, Module 5)
//
// Deliberately the smallest schema footprint of any module so far — this
// module is a read-only orchestration/query layer over Modules 1–4's
// existing content (Knowledge, PIF, PrIF, CIF), not a new content-authoring
// system. Per its own explicit "add only what is required... reuse
// existing models wherever possible... do not duplicate knowledge," the
// only new persistence is this one telemetry table.
//
// `sourceTypesQueried` is String[] (not an enum) specifically because the
// Knowledge Sources list ends with "Future Sources... architecture must
// remain extensible" — a new source type should never require a migration
// to even be logged, matching the same free-text-for-extensibility
// reasoning `category`/`problemCategory` already use in Modules 3–4.
//
// This is a write (an insert per retrieval call) inside a module whose own
// spec says "all server actions must remain read-only, no mutations" —
// not a contradiction: that rule is about never mutating the Knowledge/
// PIF/PrIF/CIF *content* itself (nothing in actions/retrieval.ts ever
// calls .create/.update/.delete on any content model), not about
// forbidding a dedicated, best-effort telemetry write to this table. Same
// distinction this codebase already draws for actions/search.ts's
// logSearch → SearchQuery.
// ---------------------------------------------------------------------------

enum RetrievalOutcome {
  SUCCESS
  PARTIAL
  EMPTY
  ERROR
}

model KnowledgeRetrievalLog {
  id                 String           @id @default(cuid())
  action             String // which of the 8 retrieval actions was called
  requestSummary     Json // sanitized copy of the input — see lib/retrieval/pipeline.ts's redaction, never raw sensitive content
  callerClearance    KnowledgeLayer // resolved max layer for this caller (reused from Module 1)
  sourceTypesQueried String[]
  matchCount         Int              @default(0)
  durationMs         Int
  outcome            RetrievalOutcome @default(SUCCESS)
  errorMessage       String?          @db.Text
  createdAt          DateTime         @default(now())

  @@index([action, createdAt])
  @@index([outcome])
  @@map("knowledge_retrieval_logs")
}

// ---------------------------------------------------------------------------
// Sales Channel Architecture v1.0 — Phase 2
// ---------------------------------------------------------------------------

enum SalesInquiryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SalesTaskStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum IdentityMatchState {
  EXACT
  POSSIBLE
  NONE
  MANUAL_REVIEW
}

model CustomerType {
  id          String                          @id @default(cuid())
  name        String                          @unique
  code        String                          @unique
  description String?
  active      Boolean                         @default(true)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  customers   Customer[]
  inquiries   SalesInquiry[]
  channels    SalesChannelCustomerType[]
  historyFrom CustomerClassificationHistory[] @relation("ClassificationFrom")
  historyTo   CustomerClassificationHistory[] @relation("ClassificationTo")
  Opportunity Opportunity[]

  @@map("customer_types")
}

model SalesChannel {
  id                       String                     @id @default(cuid())
  name                     String                     @unique
  code                     String                     @unique
  description              String?
  active                   Boolean                    @default(true)
  publicVisibility         Boolean                    @default(false)
  displayOrder             Int                        @default(0)
  defaultOwnerRoleId       String?
  defaultAssignmentQueueId String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  defaultOwnerRole         SalesRole?                 @relation("ChannelDefaultOwnerRole", fields: [defaultOwnerRoleId], references: [id], onDelete: SetNull)
  defaultAssignmentQueue   AssignmentQueue?           @relation("ChannelDefaultQueue", fields: [defaultAssignmentQueueId], references: [id], onDelete: SetNull)
  leadSources              LeadSource[]
  queues                   AssignmentQueue[]          @relation("QueueChannel")
  inquiries                SalesInquiry[]
  primaryCustomers         Customer[]
  customerTypes            SalesChannelCustomerType[]
  opportunities            Opportunity[]

  @@index([active, publicVisibility, displayOrder])
  @@index([defaultOwnerRoleId])
  @@index([defaultAssignmentQueueId])
  @@map("sales_channels")
}

model SalesChannelCustomerType {
  channelId      String
  customerTypeId String
  channel        SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  customerType   CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Cascade)

  @@id([channelId, customerTypeId])
  @@map("sales_channel_customer_types")
}

model LeadSource {
  id             String         @id @default(cuid())
  salesChannelId String?
  name           String
  code           String         @unique
  description    String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  salesChannel   SalesChannel?  @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  inquiries      SalesInquiry[]
  opportunities  Opportunity[]
  // Milestone 3 — Institutional Sales OS reuses this lookup rather than a
  // second lead-source master (see schema note near the Inst* models).
  instLeads      InstLead[]

  @@index([salesChannelId, active])
  @@map("lead_sources")
}

model AssignmentQueue {
  id                 String         @id @default(cuid())
  name               String         @unique
  code               String         @unique
  channelId          String?
  territoryId        String?
  active             Boolean        @default(true)
  escalationUserId   String?
  initialSlaMinutes  Int            @default(1440)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  channel            SalesChannel?  @relation("QueueChannel", fields: [channelId], references: [id], onDelete: SetNull)
  territory          Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  escalationUser     User?          @relation("QueueEscalationUser", fields: [escalationUserId], references: [id], onDelete: SetNull)
  defaultForChannels SalesChannel[] @relation("ChannelDefaultQueue")
  inquiries          SalesInquiry[]

  @@index([channelId, territoryId, active])
  @@map("assignment_queues")
}

model SalesInquiryStatus {
  id              String                         @id @default(cuid())
  code            String                         @unique
  displayName     String
  displayOrder    Int                            @default(0)
  terminal        Boolean                        @default(false)
  active          Boolean                        @default(true)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  inquiries       SalesInquiry[]
  fromTransitions SalesInquiryStatusTransition[] @relation("StatusFrom")
  toTransitions   SalesInquiryStatusTransition[] @relation("StatusTo")

  @@map("sales_inquiry_statuses")
}

model SalesInquiryStatusTransition {
  fromStatusId String
  toStatusId   String
  fromStatus   SalesInquiryStatus @relation("StatusFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus     SalesInquiryStatus @relation("StatusTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@id([fromStatusId, toStatusId])
  @@map("sales_inquiry_status_transitions")
}

model SalesApplicationStatus {
  id                 String                         @id @default(cuid())
  code               String                         @unique
  displayName        String
  displayOrder       Int                            @default(0)
  terminal           Boolean                        @default(false)
  active             Boolean                        @default(true)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  dealerDetails      DealerApplicationDetail[]
  distributorDetails DistributorApplicationDetail[]
  franchiseDetails   FranchiseInquiryDetail[]

  @@map("sales_application_statuses")
}

model SalesInquiry {
  id                  String                        @id @default(cuid())
  inquiryNumber       String                        @unique
  customerId          String?
  salesChannelId      String
  leadSourceId        String
  customerTypeId      String
  subject             String
  requirementSummary  String                        @db.Text
  priority            SalesInquiryPriority          @default(NORMAL)
  statusId            String
  assignedOwnerId     String?
  assignmentQueueId   String?
  territoryId         String?
  submittedUserId     String?
  campaignData        Json?
  sourceUrl           String?
  consent             Boolean                       @default(false)
  responseSlaAt       DateTime?
  firstResponseAt     DateTime?
  identityMatchState  IdentityMatchState            @default(NONE)
  possibleCustomerId  String?
  idempotencyKey      String?                       @unique
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  closedAt            DateTime?
  customer            Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesChannel        SalesChannel                  @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  leadSource          LeadSource                    @relation(fields: [leadSourceId], references: [id], onDelete: Restrict)
  customerType        CustomerType                  @relation(fields: [customerTypeId], references: [id], onDelete: Restrict)
  status              SalesInquiryStatus            @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignedOwner       User?                         @relation("InquiryOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  assignmentQueue     AssignmentQueue?              @relation(fields: [assignmentQueueId], references: [id], onDelete: SetNull)
  territory           Territory?                    @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  submittedUser       User?                         @relation("InquirySubmitter", fields: [submittedUserId], references: [id], onDelete: SetNull)
  institutionalDetail InstitutionalInquiryDetail?
  corporateDetail     CorporateInquiryDetail?
  bulkOrderDetail     BulkOrderDetail?
  quotationDetail     QuotationRequestDetail?
  sampleDetail        SampleRequestDetail?
  dealerDetail        DealerApplicationDetail?
  distributorDetail   DistributorApplicationDetail?
  franchiseDetail     FranchiseInquiryDetail?
  contactSalesDetail  ContactSalesDetail?
  attachments         InquiryAttachment[]
  timeline            SalesTimelineEvent[]
  followUps           SalesFollowUpTask[]
  notes               SalesInquiryNote[]
  notifications       NotificationLog[]
  opportunities       Opportunity[]

  @@index([customerId, createdAt])
  @@index([assignedOwnerId, statusId])
  @@index([assignmentQueueId, statusId])
  @@index([territoryId, createdAt])
  @@index([salesChannelId, createdAt])
  @@index([leadSourceId, createdAt])
  @@index([priority, createdAt])
  @@index([statusId, createdAt])
  @@index([updatedAt])
  @@map("sales_inquiries")
}

model InstitutionalInquiryDetail {
