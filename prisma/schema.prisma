// ---------------------------------------------------------------------------
// Sales Architecture v1.0 — Phase 3: Opportunity & Sales Execution
// ---------------------------------------------------------------------------

enum OpportunityStatus {
  ACTIVE
  ON_HOLD
  CLOSED_WON
  CLOSED_LOST
}

model OpportunityStage {
  id                 String                       @id @default(cuid())
  name               String                       @unique
  code               String                       @unique
  displayOrder       Int
  probabilityDefault Int
  isClosed           Boolean                      @default(false)
  isWon              Boolean                      @default(false)
  active             Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  opportunities      Opportunity[]
  historyFrom        OpportunityStageHistory[]    @relation("OpportunityPreviousStage")
  historyTo          OpportunityStageHistory[]    @relation("OpportunityNewStage")
  transitionsFrom    OpportunityStageTransition[] @relation("OpportunityTransitionFrom")
  transitionsTo      OpportunityStageTransition[] @relation("OpportunityTransitionTo")

  @@index([active, displayOrder])
  @@map("opportunity_stages")
}

model OpportunityStageTransition {
  fromStageId String
  toStageId   String
  active      Boolean          @default(true)
  fromStage   OpportunityStage @relation("OpportunityTransitionFrom", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStage     OpportunityStage @relation("OpportunityTransitionTo", fields: [toStageId], references: [id], onDelete: Cascade)

  @@id([fromStageId, toStageId])
  @@map("opportunity_stage_transitions")
